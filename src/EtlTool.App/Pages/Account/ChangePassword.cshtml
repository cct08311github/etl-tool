@page
@model EtlTool.App.Pages.Account.ChangePasswordModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>變更密碼 — ETL Tool</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/app.css" />
    <style>
        body { background: var(--bg-page); display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 1.5rem; }
        .login-card { background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-lg);
            box-shadow: var(--shadow-md); padding: 2.25rem 2rem; width: 100%; max-width: 460px; }
        .login-brand { display: flex; align-items: center; gap: 0.625rem; margin-bottom: 1.5rem; }
        .login-brand .mark { width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;
            background: linear-gradient(135deg, #6366f1, #4f46e5); color: white; border-radius: 8px; font-weight: 700; }
        .login-brand .name { font-weight: 600; font-size: 1.0625rem; }
        .login-brand .sub { color: var(--text-muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; }
        .strength-bar { height: 6px; border-radius: 3px; background: #e5e7eb; overflow: hidden; }
        .strength-fill { height: 100%; transition: width .15s, background .15s; }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="login-brand">
            <div class="mark">⚡</div>
            <div>
                <div class="name">ETL Tool</div>
                <div class="sub">資料管線</div>
            </div>
        </div>

        <h1 style="font-size: 1.125rem; margin-bottom: .25rem">變更密碼</h1>
        <p class="text-muted small mb-3">@(Model.Forced ? "首次登入或密碼已被重設，請先變更密碼後才能繼續使用。" : "請輸入舊密碼與新密碼。")</p>

        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="mb-3">
                <label asp-for="OldPassword" class="form-label">舊密碼</label>
                <input asp-for="OldPassword" type="password" class="form-control" autocomplete="current-password" autofocus required />
            </div>
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label">新密碼（至少 12 字元）</label>
                <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" id="np" required minlength="12" oninput="updateStrength()" />
                <div class="strength-bar mt-2"><div id="strength-fill" class="strength-fill" style="width:0%; background:#e5e7eb"></div></div>
                <small id="strength-label" class="text-muted">密碼強度：—</small>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label">確認新密碼</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" required minlength="12" />
            </div>

            @if (!string.IsNullOrEmpty(Model.Error))
            {
                <div class="alert alert-danger">@Model.Error</div>
            }
            @if (!string.IsNullOrEmpty(Model.Success))
            {
                <div class="alert alert-success">@Model.Success</div>
            }

            <button type="submit" class="btn btn-primary w-100">變更</button>
        </form>

        <p class="text-muted small mt-3 mb-0" style="font-size: 0.75rem">
            為避免重複，新密碼不可與最近 5 次相同。
            <a href="/Account/Logout" class="text-decoration-none">取消並登出</a>
        </p>
    </div>

    <script>
        // 純前端密碼強度提示（最終由 server 端驗）
        function updateStrength() {
            var v = document.getElementById('np').value || '';
            var len = v.length;
            var classes = 0;
            if (/[a-z]/.test(v)) classes++;
            if (/[A-Z]/.test(v)) classes++;
            if (/\d/.test(v)) classes++;
            if (/[^a-zA-Z0-9]/.test(v)) classes++;

            var score = 0;
            if (len >= 8)  score++;
            if (len >= 12) score++;
            if (len >= 16) score++;
            score += classes;  // 0-4
            // score 0-7 → 0..3
            var lvl = Math.min(3, Math.floor(score / 2));

            var fills = ['25%', '50%', '75%', '100%'];
            var colors = ['#ef4444', '#f59e0b', '#10b981', '#059669'];
            var labels = ['弱', '一般', '良好', '強'];
            document.getElementById('strength-fill').style.width = fills[lvl];
            document.getElementById('strength-fill').style.background = colors[lvl];
            document.getElementById('strength-label').textContent = '密碼強度：' + labels[lvl];
        }
    </script>
</body>
</html>
