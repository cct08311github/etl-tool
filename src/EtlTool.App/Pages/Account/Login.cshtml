@page
@model EtlTool.App.Pages.Account.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>登入 — ETL Tool</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/app.css" />
    <style>
        body { background: var(--bg-page); display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 1.5rem; }
        .login-card { background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-lg);
            box-shadow: var(--shadow-md); padding: 2.25rem 2rem; width: 100%; max-width: 380px; }
        .login-brand { display: flex; align-items: center; gap: 0.625rem; margin-bottom: 1.5rem; }
        .login-brand .mark { width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;
            background: linear-gradient(135deg, #6366f1, #4f46e5); color: white; border-radius: 8px; font-weight: 700; }
        .login-brand .name { font-weight: 600; font-size: 1.0625rem; }
        .login-brand .sub { color: var(--text-muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="login-brand">
            <div class="mark">⚡</div>
            <div>
                <div class="name">ETL Tool</div>
                <div class="sub">資料管線</div>
            </div>
        </div>

        <h1 style="font-size: 1.125rem; margin-bottom: 1rem">登入</h1>

        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="mb-3">
                <label asp-for="Username" class="form-label">帳號</label>
                <input asp-for="Username" class="form-control" autocomplete="username" autofocus required />
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label">密碼</label>
                <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" required />
            </div>

            @if (!string.IsNullOrEmpty(Model.Error))
            {
                <div class="alert alert-danger">@Model.Error</div>
            }

            <button type="submit" class="btn btn-primary w-100">登入</button>
        </form>

        <p class="text-muted small mt-3 mb-0" style="font-size: 0.75rem">
            忘記密碼？請聯絡系統管理員，或於 appsettings 中重設 Auth:PasswordHash。
        </p>
    </div>
</body>
</html>
