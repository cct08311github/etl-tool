{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // 子應用程式部署於 IIS (例 https://server/etltool) 時設此值；空字串代表掛在根
  "PathBase": "",

  // 單一帳戶設定（多人/RBAC 為下版規劃）
  // 三選一：
  //   1) 留空 → 啟動會 log 警告，使用預設密碼 "etladmin" (僅供首次登入立刻改設)
  //   2) Password (純文字) → 適合內部測試
  //   3) PasswordHash (BCrypt) → 推薦於正式環境
  // 產生 BCrypt 雜湊：見 README §認證設定
  "Auth": {
    "Username": "admin",
    "Password": "",
    "PasswordHash": "",
    "SessionHours": 8,
    "Lockout": {
      "MaxFailures": 5,
      "WindowMinutes": 10,
      "LockoutMinutes": 15
    }
  },

  // Audit log 自動清理（Audit:RetentionDays 與 Audit:KeepLastPerCategory 兩者 OR 語意，其中一條符合就保留）
  // 0 / 未設定 = 不啟用該條件；兩者都未設定 = 永不刪
  "Audit": {
    "RetentionDays": 365,
    "KeepLastPerCategory": 5000
  },

  // RunHistory 自動清理（同 OR 語意：滿足任一條件就保留）
  "RunHistory": {
    "RetentionDays": 90,
    "KeepLastPerTask": 100
  },

  // 連線健康檢查
  "ConnectionHealth": {
    "IntervalMinutes": 5,
    "TimeoutSeconds": 10
  },

  // 維護視窗（這段時間排程觸發的 ETL 自動 skip；手動觸發仍允許）
  // Days: ["All"] 或星期縮寫 ["Mon","Tue",...,"Sun"]；From/To 用 "HH:mm" 24h
  // From > To 表示跨午夜
  "Maintenance": {
    "Windows": [
      // {
      //   "Days": ["All"],
      //   "From": "02:00",
      //   "To": "04:00",
      //   "Reason": "夜間 DB 備份視窗"
      // }
    ]
  },

  // 失敗 webhook：留空 = 不通知。可指 Slack/Teams incoming-webhook URL
  // POST 內容 = JSON {text, task_id, task_name, run_id, status, ...}
  "Webhooks": {
    "OnFailure": ""
  }
}
