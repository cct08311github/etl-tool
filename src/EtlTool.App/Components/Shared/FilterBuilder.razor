@code {
    [Parameter] public EtlTool.Core.Models.FilterMode Mode { get; set; }
    [Parameter] public EventCallback<EtlTool.Core.Models.FilterMode> ModeChanged { get; set; }

    [Parameter] public string? FormJson { get; set; }
    [Parameter] public EventCallback<string?> FormJsonChanged { get; set; }

    [Parameter] public string? RawSql { get; set; }
    [Parameter] public EventCallback<string?> RawSqlChanged { get; set; }

    [Parameter] public IReadOnlyList<EtlTool.Core.Models.ColumnInfo> SourceColumns { get; set; } = Array.Empty<EtlTool.Core.Models.ColumnInfo>();

    private EtlTool.Core.Models.FilterGroup _root = new();
    private bool _showTokens;

    // 用 string 過渡值好讓 multi-value 條件能 binding 進 textarea
    private readonly Dictionary<EtlTool.Core.Models.FilterCondition, string> _multiValueText = new();

    protected override void OnParametersSet()
    {
        if (Mode == EtlTool.Core.Models.FilterMode.FormBuilder)
        {
            try
            {
                var parsed = string.IsNullOrEmpty(FormJson)
                    ? null
                    : EtlTool.Core.Engine.FilterTreeJson.Deserialize(FormJson);
                _root = parsed as EtlTool.Core.Models.FilterGroup ?? new EtlTool.Core.Models.FilterGroup();
            }
            catch
            {
                _root = new EtlTool.Core.Models.FilterGroup();
            }
            _multiValueText.Clear();
            foreach (var c in _root.Children.OfType<EtlTool.Core.Models.FilterCondition>())
            {
                if (c.Values is { Count: > 0 })
                    _multiValueText[c] = string.Join(",", c.Values);
            }
        }
    }

    private async Task PersistForm()
    {
        // 把 textarea 過渡值同步回條件
        foreach (var kv in _multiValueText)
        {
            var split = string.IsNullOrWhiteSpace(kv.Value)
                ? new List<string>()
                : kv.Value.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).ToList();
            kv.Key.Values = split;
        }
        var json = EtlTool.Core.Engine.FilterTreeJson.Serialize(_root);
        FormJson = json;
        await FormJsonChanged.InvokeAsync(json);
    }

    private async Task SwitchToForm()
    {
        Mode = EtlTool.Core.Models.FilterMode.FormBuilder;
        await ModeChanged.InvokeAsync(Mode);
    }

    private async Task SwitchToRaw()
    {
        Mode = EtlTool.Core.Models.FilterMode.RawSql;
        await ModeChanged.InvokeAsync(Mode);
    }

    private async Task RawChanged() => await RawSqlChanged.InvokeAsync(RawSql);

    private async Task LogicChanged() => await PersistForm();

    private async Task AddCondition()
    {
        _root.Children.Add(new EtlTool.Core.Models.FilterCondition());
        await PersistForm();
    }

    private async Task RemoveChild(EtlTool.Core.Models.FilterNode child)
    {
        _root.Children.Remove(child);
        if (child is EtlTool.Core.Models.FilterCondition c)
            _multiValueText.Remove(c);
        await PersistForm();
    }
}

<div class="mb-2 d-flex justify-content-between align-items-center">
    <div class="btn-group" role="group">
        <button type="button" class="btn @(Mode == EtlTool.Core.Models.FilterMode.FormBuilder ? "btn-primary" : "btn-outline-primary")" @onclick="SwitchToForm">表單模式</button>
        <button type="button" class="btn @(Mode == EtlTool.Core.Models.FilterMode.RawSql ? "btn-primary" : "btn-outline-primary")" @onclick="SwitchToRaw">進階 SQL</button>
    </div>
    <button type="button" class="btn btn-sm btn-link text-muted" @onclick="() => _showTokens = !_showTokens">
        @(_showTokens ? "▴ 隱藏" : "▾") 日期變數
    </button>
</div>

@if (_showTokens)
{
    <div class="card mb-2 token-cheatsheet">
        <div class="card-body py-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <strong>動態日期變數 — 執行時自動替換為當下時刻</strong>
                <small class="text-muted">表單模式不加引號 · 進階 SQL 也不加引號（系統會自動轉成 <code>TO_TIMESTAMP(...)</code> / <code>'YYYY-MM-DD …'</code>）</small>
            </div>

            <div class="row g-3">
                <div class="col-md-6 col-lg-4">
                    <div class="token-group-title">📅 今 / 昨 / 明（最常用）</div>
                    <table class="token-table">
                        <tr><td><code>${"${TODAY}"}</code></td><td>今天 00:00</td></tr>
                        <tr><td><code>${"${TODAY_END}"}</code></td><td>今天 23:59:59.999</td></tr>
                        <tr><td><code>${"${YESTERDAY}"}</code></td><td>昨天 00:00</td></tr>
                        <tr><td><code>${"${YESTERDAY_END}"}</code></td><td>昨天 23:59:59.999</td></tr>
                        <tr><td><code>${"${TOMORROW}"}</code></td><td>明天 00:00</td></tr>
                        <tr><td><code>${"${NOW}"}</code></td><td>當下時刻（含時分秒）</td></tr>
                    </table>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="token-group-title">⏰ 期間起訖（本/上）</div>
                    <table class="token-table">
                        <tr><td><code>${"${HOUR_START}"}</code></td><td>本小時 00 分</td></tr>
                        <tr><td><code>${"${WEEK_START}"}</code></td><td>本週一 00:00</td></tr>
                        <tr><td><code>${"${WEEK_END}"}</code></td><td>本週日 23:59:59.999</td></tr>
                        <tr><td><code>${"${LAST_WEEK_START}"}</code></td><td>上週一</td></tr>
                        <tr><td><code>${"${LAST_WEEK_END}"}</code></td><td>上週日</td></tr>
                        <tr><td><code>${"${MONTH_START}"}</code></td><td>本月 1 日</td></tr>
                        <tr><td><code>${"${MONTH_END}"}</code></td><td>本月最後一刻</td></tr>
                        <tr><td><code>${"${LAST_MONTH_START}"}</code></td><td>上月 1 日</td></tr>
                        <tr><td><code>${"${LAST_MONTH_END}"}</code></td><td>上月最後一刻</td></tr>
                    </table>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="token-group-title">📊 季 / 年</div>
                    <table class="token-table">
                        <tr><td><code>${"${QUARTER_START}"}</code></td><td>本季首日</td></tr>
                        <tr><td><code>${"${QUARTER_END}"}</code></td><td>本季最後一刻</td></tr>
                        <tr><td><code>${"${LAST_QUARTER_START}"}</code></td><td>上季首日</td></tr>
                        <tr><td><code>${"${LAST_QUARTER_END}"}</code></td><td>上季最後一刻</td></tr>
                        <tr><td><code>${"${YEAR_START}"}</code></td><td>本年 1/1</td></tr>
                        <tr><td><code>${"${YEAR_END}"}</code></td><td>本年 12/31 最後一刻</td></tr>
                        <tr><td><code>${"${LAST_YEAR_START}"}</code></td><td>去年 1/1</td></tr>
                        <tr><td><code>${"${LAST_YEAR_END}"}</code></td><td>去年最後一刻</td></tr>
                    </table>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="token-group-title">⏪ 相對偏移（N 任填整數）</div>
                    <table class="token-table">
                        <tr><td><code>${"${MINUTES_AGO_15}"}</code></td><td>15 分鐘前</td></tr>
                        <tr><td><code>${"${HOURS_AGO_3}"}</code></td><td>3 小時前</td></tr>
                        <tr><td><code>${"${DAYS_AGO_7}"}</code></td><td>7 天前 00:00</td></tr>
                        <tr><td><code>${"${WEEKS_AGO_2}"}</code></td><td>2 週前 00:00</td></tr>
                        <tr><td><code>${"${MONTHS_AGO_3}"}</code></td><td>3 個月前 00:00</td></tr>
                        <tr><td><code>${"${YEARS_AGO_1}"}</code></td><td>1 年前 00:00</td></tr>
                    </table>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="token-group-title">🔤 格式化字串（VARCHAR 日期欄位用）</div>
                    <table class="token-table">
                        <tr><td colspan="2"><strong>三種最常用日期字串格式</strong></td></tr>
                        <tr><td><code>${"${TODAY:yyyyMMdd}"}</code></td><td>"20260426" — 緊湊式 (DW DateKey)</td></tr>
                        <tr><td><code>${"${TODAY:yyyy-MM-dd}"}</code></td><td>"2026-04-26" — ISO 8601 (dash)</td></tr>
                        <tr><td><code>${"${TODAY:yyyy/MM/dd}"}</code></td><td>"2026/04/26" — 斜線</td></tr>
                        <tr><td colspan="2"><strong>月份字串</strong></td></tr>
                        <tr><td><code>${"${MONTH_START:yyyyMM}"}</code></td><td>"202604"</td></tr>
                        <tr><td><code>${"${MONTH_START:yyyy-MM}"}</code></td><td>"2026-04"</td></tr>
                        <tr><td colspan="2"><strong>含時間</strong></td></tr>
                        <tr><td><code>${"${NOW:yyyy-MM-dd HH:mm:ss}"}</code></td><td>"2026-04-26 14:35:07"</td></tr>
                        <tr><td><code>${"${NOW:yyyyMMddHHmmss}"}</code></td><td>"20260426143507"</td></tr>
                    </table>
                    <small class="text-muted">格式語法 = <a href="https://learn.microsoft.com/dotnet/standard/base-types/custom-date-and-time-format-strings" target="_blank" rel="noopener">.NET DateTime 自訂格式字串</a>，套用後產生字串並自動加單引號</small>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="token-group-title">📈 同期比較 (YoY / MoM / WoW / DoD)</div>
                    <table class="token-table">
                        <tr><td><code>${"${YOY}"}</code></td><td>1 年前同一刻（year-over-year）</td></tr>
                        <tr><td><code>${"${MOM}"}</code></td><td>1 個月前同一刻</td></tr>
                        <tr><td><code>${"${WOW}"}</code></td><td>1 週前同一刻</td></tr>
                        <tr><td><code>${"${DOD}"}</code></td><td>1 天前同一刻</td></tr>
                        <tr><td colspan="2"><span class="text-muted small">＝ Period-to-Date 起始點別名 ＝</span></td></tr>
                        <tr><td><code>${"${YTD}"}</code></td><td>本年首日（= YEAR_START）</td></tr>
                        <tr><td><code>${"${MTD}"}</code></td><td>本月首日（= MONTH_START）</td></tr>
                        <tr><td><code>${"${WTD}"}</code></td><td>本週一（= WEEK_START）</td></tr>
                        <tr><td><code>${"${DTD}"}</code></td><td>今天 00:00（= TODAY）</td></tr>
                    </table>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="token-group-title">💡 常見範本</div>
                    <table class="token-table">
                        <tr><td colspan="2"><strong>每天轉前一天資料</strong></td></tr>
                        <tr><td colspan="2"><code>CreatedAt &gt;= ${"${YESTERDAY}"} AND CreatedAt &lt; ${"${TODAY}"}</code></td></tr>
                        <tr><td colspan="2"><strong>每月轉上月整月</strong></td></tr>
                        <tr><td colspan="2"><code>CreatedAt BETWEEN ${"${LAST_MONTH_START}"} AND ${"${LAST_MONTH_END}"}</code></td></tr>
                        <tr><td colspan="2"><strong>本年 YTD（今年 1/1 至今）</strong></td></tr>
                        <tr><td colspan="2"><code>CreatedAt BETWEEN ${"${YTD}"} AND ${"${NOW}"}</code></td></tr>
                        <tr><td colspan="2"><strong>去年同期 YTD（搭配上一條跑兩個任務做 YoY 比較）</strong></td></tr>
                        <tr><td colspan="2"><code>CreatedAt BETWEEN ${"${LAST_YEAR_START}"} AND ${"${YOY}"}</code></td></tr>
                        <tr><td colspan="2"><strong>本年+去年同期合併撈（單一任務做 YoY 比對）</strong></td></tr>
                        <tr><td colspan="2"><code>(CreatedAt BETWEEN ${"${YTD}"} AND ${"${NOW}"}) OR (CreatedAt BETWEEN ${"${LAST_YEAR_START}"} AND ${"${YOY}"})</code></td></tr>
                        <tr><td colspan="2"><strong>近一個月增量（MoM 取數）</strong></td></tr>
                        <tr><td colspan="2"><code>CreatedAt &gt;= ${"${MOM}"}</code></td></tr>
                        <tr><td colspan="2"><strong>VARCHAR 日期欄</strong></td></tr>
                        <tr><td colspan="2"><code>YYYYMMDD = ${"${YESTERDAY:yyyyMMdd}"}</code></td></tr>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@if (Mode == EtlTool.Core.Models.FilterMode.FormBuilder)
{
    <div class="border rounded p-2">
        <div class="mb-2 d-flex align-items-center gap-2">
            <select class="form-select form-select-sm" style="width: auto" @bind="_root.Logic" @bind:after="LogicChanged">
                <option value="@EtlTool.Core.Models.FilterLogic.And">AND (全部符合)</option>
                <option value="@EtlTool.Core.Models.FilterLogic.Or">OR (任一符合)</option>
            </select>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="AddCondition">+ 條件</button>
        </div>

        @foreach (var child in _root.Children.OfType<EtlTool.Core.Models.FilterCondition>().ToList())
        {
            <div class="row g-2 align-items-center mb-2" @key="child">
                <div class="col-3">
                    <select class="form-select form-select-sm" @bind="child.Column" @bind:after="PersistForm">
                        <option value="">— 欄位 —</option>
                        @foreach (var c in SourceColumns)
                        {
                            <option value="@c.Name">@c.Name</option>
                        }
                    </select>
                </div>
                <div class="col-2">
                    <select class="form-select form-select-sm" @bind="child.Operator" @bind:after="PersistForm">
                        @foreach (var op in Enum.GetValues<EtlTool.Core.Models.FilterOperator>())
                        {
                            <option value="@op">@op</option>
                        }
                    </select>
                </div>
                <div class="col">
                    @if (child.Operator is EtlTool.Core.Models.FilterOperator.IsNull or EtlTool.Core.Models.FilterOperator.IsNotNull)
                    {
                        <span class="text-muted small">無需值</span>
                    }
                    else if (child.Operator is EtlTool.Core.Models.FilterOperator.In or EtlTool.Core.Models.FilterOperator.NotIn or EtlTool.Core.Models.FilterOperator.Between)
                    {
                        <input class="form-control form-control-sm" placeholder="逗號分隔多值"
                               @bind="_multiValueText[child]" @bind:after="PersistForm" />
                    }
                    else
                    {
                        <input class="form-control form-control-sm" placeholder="值"
                               @bind="child.Value" @bind:after="PersistForm" />
                    }
                </div>
                <div class="col-auto">
                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveChild(child)">×</button>
                </div>
            </div>
        }
    </div>
}
else
{
    <div>
        <textarea class="form-control font-monospace" rows="4"
                  placeholder="WHERE 子句（不含 WHERE 關鍵字），例如：DEPT_ID IN (10, 20) AND HIRE_DATE >= DATE '2024-01-01'"
                  @bind="RawSql" @bind:after="RawChanged"></textarea>
        <small class="text-warning">⚠ 進階模式直接拼進 SQL，請信任輸入來源。</small>
    </div>
}
