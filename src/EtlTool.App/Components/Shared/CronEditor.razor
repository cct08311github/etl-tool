@code {
    [Parameter] public string Value { get; set; } = "0 0 * * * ?";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    /// <summary>
    /// 銀行常見排程模板。每筆 (label, cron, hint)。
    /// hint 給 admin 額外脈絡（建議使用情境）。
    /// </summary>
    private static readonly (string Label, string Cron, string Hint)[] Presets =
    {
        ("每分鐘",        "0 * * * * ?",       "高頻（測試 / 開發用，正式環境少見）"),
        ("每 5 分鐘",     "0 0/5 * * * ?",     "近即時 — 帳務 reconcile / cache 更新"),
        ("每 10 分鐘",    "0 0/10 * * * ?",    "輕量同步"),
        ("每 30 分鐘",    "0 0/30 * * * ?",    "中頻同步"),
        ("每小時整點",    "0 0 * * * ?",       "每小時一次"),
        ("每天 02:00",    "0 0 2 * * ?",       "離峰時段 — 多數 ETL 適用"),
        ("每天 06:00",    "0 0 6 * * ?",       "上班前完成"),
        ("每天 22:00",    "0 0 22 * * ?",      "晚間批次"),
        ("每週一 03:00",  "0 0 3 ? * MON",     "週一收盤後彙整"),
        ("每週日 03:00",  "0 0 3 ? * SUN",     "週末維護"),
        ("每月 1 號 02:00", "0 0 2 1 * ?",     "月結 / 月度報表"),
    };

    private string? _nextFireDescription;
    private string? _validationError;

    protected override void OnParametersSet() => ComputeNext();

    private async Task ApplyPreset(string cron)
    {
        Value = cron;
        await ValueChanged.InvokeAsync(cron);
        ComputeNext();
    }

    private async Task OnCustomChange(ChangeEventArgs e)
    {
        var v = (string)e.Value!;
        Value = v;
        await ValueChanged.InvokeAsync(v);
        ComputeNext();
    }

    private void ComputeNext()
    {
        _validationError = null;
        try
        {
            var expr = new Quartz.CronExpression(Value);
            var next = expr.GetNextValidTimeAfter(DateTimeOffset.UtcNow);
            _nextFireDescription = next?.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss");
        }
        catch (Exception ex)
        {
            _nextFireDescription = null;
            _validationError = ex.Message;
        }
    }

    private bool IsActivePreset(string cron) => string.Equals(Value?.Trim(), cron, StringComparison.Ordinal);
}

<div class="mb-2">
    <label class="form-label">常用排程</label>
    <div class="d-flex flex-wrap gap-1">
        @foreach (var p in Presets)
        {
            <button type="button"
                    class="btn btn-sm @(IsActivePreset(p.Cron) ? "btn-primary" : "btn-outline-secondary")"
                    title="@p.Hint"
                    @onclick="() => ApplyPreset(p.Cron)">
                @p.Label
            </button>
        }
    </div>
</div>
<div class="mb-2">
    <label class="form-label">Cron 表達式 (Quartz 格式：秒 分 時 日 月 週)</label>
    <input class="form-control font-monospace" value="@Value" @onchange="OnCustomChange" />
    @if (_validationError is not null)
    {
        <small class="text-danger">⚠ Cron 無效：@_validationError</small>
    }
    else
    {
        <small class="text-muted">下次觸發 (本地)：@(_nextFireDescription ?? "—")</small>
    }
</div>
