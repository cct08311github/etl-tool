@implements IDisposable
@inject EtlTool.Data.Repositories.ApprovalRepository ApprovalRepo
@inject AuthenticationStateProvider AuthState

<div class="brand">
    <div class="brand-mark">
        <Icon Name="zap" />
    </div>
    <div class="brand-text">
        <div class="brand-name">EtlTool</div>
        <div class="brand-sub">資料管線</div>
    </div>
</div>

<nav class="nav-list">
    <NavLink class="nav-item" href="" Match="NavLinkMatch.All">
        <Icon Name="home" /><span>Dashboard</span>
    </NavLink>
    <NavLink class="nav-item" href="connections">
        <Icon Name="database" /><span>連線管理</span>
    </NavLink>
    <NavLink class="nav-item" href="tasks">
        <Icon Name="list-checks" /><span>ETL 任務</span>
    </NavLink>
    <NavLink class="nav-item" href="runs">
        <Icon Name="activity" /><span>執行歷史</span>
    </NavLink>
    <NavLink class="nav-item" href="logs">
        <Icon Name="history" /><span>活動日誌</span>
    </NavLink>
    <AuthorizeView Roles="Admin">
        <Authorized>
            <NavLink class="nav-item" href="approvals">
                <Icon Name="check" /><span>覆核佇列</span>
                @if (_pendingCount > 0)
                {
                    <span class="badge bg-warning text-dark ms-auto">@_pendingCount</span>
                }
            </NavLink>
            <NavLink class="nav-item" href="scheduler">
                <Icon Name="zap" /><span>排程器檢視</span>
            </NavLink>
            <NavLink class="nav-item" href="system">
                <Icon Name="activity" /><span>系統資訊</span>
            </NavLink>
            <NavLink class="nav-item" href="users">
                <Icon Name="settings" /><span>使用者管理</span>
            </NavLink>
        </Authorized>
    </AuthorizeView>
</nav>

<div class="nav-footer">
    <AuthorizeView>
        <Authorized>
            <div class="user-row">
                <div class="user-avatar">@(context.User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "?")</div>
                <div class="user-info">
                    <div class="user-name">@context.User.Identity?.Name</div>
                    <div class="small text-muted" style="font-size: 0.6875rem">
                        @(context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "—")
                    </div>
                    <a class="user-logout" href="/Account/Logout">登出</a>
                </div>
            </div>
        </Authorized>
    </AuthorizeView>
    <a class="nav-item nav-item-sm" href="/healthz" target="_blank" rel="noopener">
        <Icon Name="activity" /><span>Health</span>
    </a>
</div>

@code {
    private int _pendingCount;
    private System.Threading.Timer? _timer;
    private bool _isAdmin;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _isAdmin = state.User.IsInRole("Admin");

        if (_isAdmin)
        {
            await RefreshCountAsync();
            // 每 30s 輕量輪詢一次（僅 admin）
            _timer = new System.Threading.Timer(async _ =>
            {
                try
                {
                    await RefreshCountAsync();
                    await InvokeAsync(StateHasChanged);
                }
                catch { /* timer-thread 安靜失敗，下次再試 */ }
            }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
        }
    }

    private async Task RefreshCountAsync()
    {
        try
        {
            _pendingCount = await ApprovalRepo.CountPendingAsync(CancellationToken.None);
        }
        catch
        {
            _pendingCount = 0;
        }
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
