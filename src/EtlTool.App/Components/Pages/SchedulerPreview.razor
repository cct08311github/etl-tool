@page "/scheduler/preview"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Operator")]
@inject EtlTool.Data.Repositories.EtlTaskRepository TaskRepo
@inject EtlTool.Data.Repositories.RunHistoryRepository RunHistoryRepo
@inject EtlTool.Core.Scheduling.SchedulerService Scheduler

<PageTitle>排程預覽 — 未來 24h</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="m-0">排程預覽 — 未來 @_hoursAhead 小時</h1>
    <div class="d-flex gap-2 align-items-center">
        <select class="form-select form-select-sm" @bind="_hoursAhead" @bind:after="Reload" style="width:auto">
            <option value="1">1h</option>
            <option value="6">6h</option>
            <option value="12">12h</option>
            <option value="24">24h</option>
            <option value="72">3d</option>
        </select>
        <a class="btn btn-link btn-sm" href="/scheduler">← 排程器即時狀態</a>
    </div>
</div>

@if (_fires is null)
{
    <p class="text-muted">載入中…</p>
}
else if (_fires.Count == 0)
{
    <div class="empty-state">
        <p>未來 @_hoursAhead 小時內沒有任何排程觸發。</p>
    </div>
}
else
{
    <div class="alert alert-info small">
        共 @_fires.Count 次觸發 / @_taskCount 個獨立任務。
        ⚠ 上游依賴未必滿足（顯示為 「等候上游」），實際執行時 EtlJob 會再次驗證。
    </div>
    <div class="card">
        <table class="table mb-0 align-middle">
            <thead>
                <tr>
                    <th style="width: 160px">觸發時間 (本地)</th>
                    <th>任務</th>
                    <th style="width: 120px">Cron 描述</th>
                    <th style="width: 130px">依賴狀態</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var f in _fires)
            {
                <tr>
                    <td><span class="font-monospace small">@f.FireAt:MM-dd HH:mm:ss</span></td>
                    <td>
                        <a href="@($"tasks/{f.TaskId}")" class="fw-medium">@f.TaskName</a>
                        @if (!string.IsNullOrEmpty(f.Tags))
                        {
                            <small class="ms-2 text-muted">@f.Tags</small>
                        }
                    </td>
                    <td class="small text-muted">@(f.CronHuman ?? f.Cron)</td>
                    <td>
                        @if (f.DepStatus == "ok")
                        {
                            <span class="badge bg-success">OK</span>
                        }
                        else if (f.DepStatus == "wait")
                        {
                            <span class="badge bg-warning text-dark" title="@f.DepDetail">等候上游</span>
                        }
                        else
                        {
                            <span class="text-muted small">—</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@code {
    private int _hoursAhead = 24;
    private record FireEntry(Guid TaskId, string TaskName, string? Tags, DateTime FireAt, string Cron, string? CronHuman, string DepStatus, string? DepDetail);
    private List<FireEntry>? _fires;
    private int _taskCount;

    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload()
    {
        var ct = CancellationToken.None;
        var tasks = (await TaskRepo.GetAllAsync(ct))
            .Where(t => t.Enabled)
            .ToList();
        var lastSuccess = await RunHistoryRepo.LastSuccessByTaskAsync(ct);

        var nowLocal = DateTime.Now;
        var endLocal = nowLocal.AddHours(_hoursAhead);
        var nowUtc = DateTime.UtcNow;

        var fires = new List<FireEntry>();
        foreach (var t in tasks)
        {
            Quartz.CronExpression expr;
            try { expr = new Quartz.CronExpression(t.CronExpression); }
            catch { continue; }

            // 依賴 lookback 與 deps
            var depsRaw = EtlTool.Core.Engine.TaskDependencyChecker.ParseDependsOnIds(t.DependsOnTaskIds);
            var lookback = (t.DependencyLookbackHours is { } h && h > 0) ? h : 24;
            var depResult = EtlTool.Core.Engine.TaskDependencyChecker.CheckDependencies(
                depsRaw, lastSuccess, nowUtc, lookback);
            var depStatus = depsRaw.Count == 0 ? "none" : (depResult.AllSatisfied ? "ok" : "wait");
            var depDetail = depResult.Reason;

            // Walk Quartz CronExpression up to 50 fires within window
            var pointer = new DateTimeOffset(nowLocal);
            for (int i = 0; i < 50; i++)
            {
                var nextOpt = expr.GetNextValidTimeAfter(pointer);
                if (nextOpt is null) break;
                var next = nextOpt.Value.LocalDateTime;
                if (next > endLocal) break;
                fires.Add(new FireEntry(
                    TaskId: t.Id,
                    TaskName: t.Name,
                    Tags: t.Tags,
                    FireAt: next,
                    Cron: t.CronExpression,
                    CronHuman: EtlTool.Core.Engine.CronHumanizer.Humanize(t.CronExpression),
                    DepStatus: depStatus,
                    DepDetail: depDetail));
                pointer = nextOpt.Value;
            }
        }

        _fires = fires.OrderBy(f => f.FireAt).ToList();
        _taskCount = _fires.Select(f => f.TaskId).Distinct().Count();
        StateHasChanged();
    }
}
