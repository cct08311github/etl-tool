@page "/system"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@inject EtlTool.Data.AppDbContext Db
@inject IConfiguration Config
@inject IHostEnvironment HostEnv
@inject EtlTool.App.Auth.AdminIpAllowlistService Allowlist
@inject EtlTool.App.Auth.ApiKeyAuthService ApiKeys
@inject NavigationManager Nav
@inject IHttpClientFactory HttpFactory
@inject EtlTool.Data.Repositories.AuditChainVerifier ChainVerifier
@inject EtlTool.App.Services.HttpFailureNotifier WebhookNotifier
@inject EtlTool.Core.Engine.IAuditLogger AuditLogger
@inject AuthenticationStateProvider AuthStateProvider
@inject Microsoft.Extensions.Options.IOptionsMonitor<EtlTool.Core.Scheduling.MaintenanceWindowsOptions> MaintOpts
@inject EtlTool.Data.Repositories.MaintenanceWindowRepository MaintRepo

<PageTitle>系統資訊</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="m-0">系統資訊</h1>
    <button class="btn btn-sm btn-outline-primary" @onclick="Reload">
        <Icon Name="refresh" /> 重新整理
    </button>
</div>

@if (_loading)
{
    <p class="text-muted">載入中…</p>
}
else
{
    <div class="card mb-3">
        <div class="card-header">執行環境</div>
        <table class="table mb-0 align-middle">
            <tbody>
                <tr><th style="width: 30%">應用程式組件版本</th><td><code>@_assemblyVersion</code></td></tr>
                <tr><th>建置時間 (UTC)</th><td><code>@(_buildTime?.ToString("o") ?? "—")</code></td></tr>
                <tr><th>.NET 版本</th><td><code>@Environment.Version</code> / <code>@System.Runtime.InteropServices.RuntimeInformation.FrameworkDescription</code></td></tr>
                <tr><th>OS</th><td><code>@System.Runtime.InteropServices.RuntimeInformation.OSDescription</code> / arch <code>@System.Runtime.InteropServices.RuntimeInformation.ProcessArchitecture</code></td></tr>
                <tr><th>主機名稱</th><td><code>@Environment.MachineName</code></td></tr>
                <tr><th>環境</th><td><code>@HostEnv.EnvironmentName</code></td></tr>
                <tr><th>process id / uptime</th><td><code>@_pid</code> · 已運行 @_uptime</td></tr>
                <tr><th>process memory (working set)</th><td><code>@_workingSet</code></td></tr>
            </tbody>
        </table>
    </div>

    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>資料庫</span>
            <button class="btn btn-sm btn-outline-primary" @onclick="RunIntegrityCheck" disabled="@_integrityBusy">
                @if (_integrityBusy) { <Icon Name="loader" /> <span>檢查中…</span> }
                else { <span>🔍 完整性檢查 (PRAGMA integrity_check)</span> }
            </button>
        </div>
        @if (_integrityResult is not null)
        {
            <div class="@(_integrityResult.IsOk ? "alert alert-success" : "alert alert-danger") m-3 mb-0 small">
                @if (_integrityResult.IsOk)
                {
                    <strong>✓ 完整性檢查通過</strong>
                    <span class="ms-2">耗時 @_integrityResult.ElapsedMs ms</span>
                }
                else
                {
                    <strong>⚠ 發現問題：</strong>
                    <pre class="mb-0 mt-1">@string.Join("\n", _integrityResult.Lines)</pre>
                }
            </div>
        }
        <table class="table mb-0 align-middle">
            <tbody>
                <tr><th style="width: 30%">SQLite 路徑</th><td><code class="small">@_dbPath</code></td></tr>
                <tr><th>資料庫檔案大小</th><td><code>@_dbSizeFormatted</code></td></tr>
                <tr><th>連線總數</th><td><code>@_counts.Connections</code></td></tr>
                <tr><th>任務總數 / 啟用</th><td><code>@_counts.Tasks</code> / <code>@_counts.EnabledTasks</code></td></tr>
                <tr><th>RunHistory 總數</th><td><code>@_counts.Runs</code></td></tr>
                <tr><th>AuditEvent 總數</th><td><code>@_counts.AuditEvents</code></td></tr>
                <tr><th>使用者總數</th><td><code>@_counts.Users</code></td></tr>
                <tr><th>覆核佇列 (待決定)</th><td><code>@_counts.PendingApprovals</code></td></tr>
            </tbody>
        </table>
    </div>

    <div class="card mb-3">
        <div class="card-header">保留政策 (Retention)</div>
        <table class="table mb-0 align-middle">
            <tbody>
                <tr><th style="width: 30%">Audit 保留</th><td>
                    <code>RetentionDays = @(_retention.AuditDays?.ToString() ?? "(未設)")</code>;
                    <code>KeepLastPerCategory = @(_retention.AuditPerCategory?.ToString() ?? "(未設)")</code>
                </td></tr>
                <tr><th>RunHistory 保留</th><td>
                    <code>RetentionDays = @(_retention.RunDays?.ToString() ?? "(未設)")</code>;
                    <code>KeepLastPerTask = @(_retention.RunPerTask?.ToString() ?? "(未設)")</code>
                </td></tr>
                <tr><th>Session 逾時 (分)</th><td><code>@_retention.SessionMinutes</code></td></tr>
                <tr><th>密碼最大年齡 (天)</th><td><code>@(_retention.MaxPasswordAgeDays > 0 ? _retention.MaxPasswordAgeDays.ToString() : "(停用)")</code></td></tr>
            </tbody>
        </table>
    </div>

    <div class="card mb-3">
        <div class="card-header">安全</div>
        <table class="table mb-0 align-middle">
            <tbody>
                <tr><th style="width: 30%">Admin IP allowlist</th><td>
                    @if (Allowlist.IsEnabled)
                    {
                        <span class="badge bg-success">已啟用</span>
                        <span class="ms-2 small text-muted">@string.Join(", ", Allowlist.RawEntries)</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">未啟用</span>
                        <span class="ms-2 small text-muted">所有來源 IP 可存取 admin 路徑（依賴角色控管）</span>
                    }
                </td></tr>
                <tr><th>Failure webhook URL</th><td>
                    @if (string.IsNullOrEmpty(_security.WebhookUrl))
                    {
                        <span class="text-muted small">未設定（失敗不會推 webhook）</span>
                    }
                    else
                    {
                        <code class="small">@MaskUrl(_security.WebhookUrl)</code>
                        <span class="ms-2 small text-muted">format = @(_security.WebhookFormat ?? "generic")</span>
                        <button class="btn btn-sm btn-outline-primary ms-2" @onclick="TestWebhook" disabled="@_webhookBusy">
                            @if (_webhookBusy) { <Icon Name="loader" /> <span>測試中…</span> }
                            else { <span>📡 測試 webhook</span> }
                        </button>
                        @if (_webhookTestResult is not null)
                        {
                            <div class="mt-2 small">
                                @if (_webhookTestResult.Ok)
                                {
                                    <span class="text-success">✓ 成功（HTTP @_webhookTestResult.StatusCode）— Slack/Teams 應已收到一筆「[TEST] Webhook configuration test」訊息</span>
                                }
                                else
                                {
                                    <span class="text-danger">⚠ 失敗（HTTP @(_webhookTestResult.StatusCode?.ToString() ?? "—")）：@_webhookTestResult.Error</span>
                                }
                            </div>
                        }
                    }
                </td></tr>
                <tr><th>Failure streak threshold</th><td><code>@_security.FailureStreakThreshold</code> 次</td></tr>
                <tr><th>Audit chain head/tail hash</th><td>
                    <div class="small font-monospace text-break">
                        head: <code>@(_chainHeadHash ?? "—")</code><br />
                        tail: <code>@(_chainTailHash ?? "—")</code>
                    </div>
                    <a href="/logs" class="btn btn-sm btn-link p-0">至活動日誌驗證鏈完整性 →</a>
                </td></tr>
            </tbody>
        </table>
    </div>

    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>API 整合 (Read-only JSON)</span>
            <a class="btn btn-sm btn-outline-secondary" href="/api/openapi.yaml" target="_blank" title="OpenAPI 3.0 spec — 可餵 Postman / Insomnia / openapi-generator">
                📄 OpenAPI YAML
            </a>
        </div>
        <table class="table mb-0 align-middle">
            <tbody>
                <tr>
                    <th style="width: 30%">API key 認證</th>
                    <td>
                        @if (ApiKeys.IsEnabled)
                        {
                            <span class="badge bg-success">已啟用</span>
                            <span class="ms-2 small text-muted">@ApiKeys.KeyCount 把 key 已載入</span>
                            <div class="small font-monospace text-muted mt-1">
                                fingerprints (前 8 hex of SHA-256，僅供識別):
                                @foreach (var fp in ApiKeys.KeyFingerprints)
                                {
                                    <code class="me-2">@fp</code>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">未啟用</span>
                            <span class="ms-2 small text-muted">/api/* 純靠 IP allowlist + rate limit 控管；建議至 appsettings 設 <code>Api:Keys</code></span>
                        }
                    </td>
                </tr>
                <tr>
                    <th>Rate limit</th>
                    <td>
                        <code>@_apiRateLimitPerMinute</code> 請求 / 分 / IP
                        <span class="ms-2 small text-muted">(超過 → 429 Too Many Requests)</span>
                    </td>
                </tr>
                <tr>
                    <th>可用端點</th>
                    <td>
                        <ul class="small mb-0">
                            <li><code>GET /api/health</code> — liveness probe（無 key 也可，但仍受 IP allowlist 擋）</li>
                            <li><code>GET /api/tasks/last-run</code> — 所有任務 + 最後一次執行摘要</li>
                            <li><code>GET /api/tasks/{id}</code> — 單一任務 + 最近 N 次 run</li>
                            <li><code>GET /api/tasks/{id}/runs?page=1&size=20</code> — 分頁 RunHistory</li>
                            <li><code>GET /api/openapi.yaml</code> — 完整 OpenAPI 3.0 spec</li>
                        </ul>
                    </td>
                </tr>
                <tr>
                    <th>cURL 範例</th>
                    <td>
                        <pre class="small mb-0 bg-light p-2 rounded"><code>curl -H "X-Api-Key: $ETL_API_KEY" \
     @(_baseUrl)api/tasks/last-run</code></pre>
                    </td>
                </tr>
                <tr>
                    <th>快速測試</th>
                    <td>
                        <button class="btn btn-sm btn-outline-primary" @onclick="TestApiHealth" disabled="@_apiTestBusy">
                            @if (_apiTestBusy) { <Icon Name="loader" /> <span>呼叫中…</span> }
                            else { <span>📡 GET /api/health</span> }
                        </button>
                        @if (_apiTestResult is not null)
                        {
                            <div class="mt-2 small">
                                @if (_apiTestResult.Ok)
                                {
                                    <span class="text-success">✓ 通過（HTTP @_apiTestResult.StatusCode, @_apiTestResult.ElapsedMs ms）</span>
                                    <pre class="bg-light p-2 mt-1 mb-0 rounded small">@_apiTestResult.Body</pre>
                                }
                                else
                                {
                                    <span class="text-danger">⚠ 失敗（HTTP @(_apiTestResult.StatusCode?.ToString() ?? "—")）：@_apiTestResult.Error</span>
                                }
                            </div>
                        }
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    @if (_autoDisabled is not null && _autoDisabled.Count > 0)
    {
        <div class="card mb-3 border-danger">
            <div class="card-header bg-danger text-white">⛔ 自動停用任務 (@_autoDisabled.Count)</div>
            <table class="table mb-0 align-middle">
                <thead>
                    <tr>
                        <th style="width: 25%">任務</th>
                        <th style="width: 18%">停用時間</th>
                        <th>原因</th>
                        <th style="width: 80px"></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var t in _autoDisabled)
                {
                    <tr>
                        <td><strong>@t.Name</strong></td>
                        <td class="small text-muted">@t.AutoDisabledAt?.ToLocalTime():yyyy-MM-dd HH:mm</td>
                        <td class="small">@t.AutoDisabledReason</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" href="@($"tasks/{t.Id}")">編輯</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
            <div class="card-footer small text-muted">
                Circuit-breaker 因連續失敗自動停用的任務。Admin 修復問題後請至列表逐筆走「我已確認問題已修復」確認流程。
            </div>
        </div>
    }

    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>SQLite 備份</span>
            <a class="btn btn-sm btn-primary" href="/Account/SqliteBackup" target="_blank">
                <Icon Name="download" /> 立即下載新備份
            </a>
        </div>
        <div class="card-body small text-muted py-2">
            點擊「立即下載新備份」會在伺服器執行 <code>VACUUM INTO</code> 一致性備份並串流下載；
            另外排程器每天 03:45 自動寫入 <code>@(_backupSummary?.Directory ?? "(未載入)")</code>。
            @if (_backupSummary is not null && _backupSummary.RetainCount > 0)
            {
                <span> 保留最新 <strong>@_backupSummary.RetainCount</strong> 份。</span>
            }
        </div>
        @if (_backupFiles is not null && _backupFiles.Count > 0)
        {
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>檔名</th>
                        <th style="width: 100px">大小</th>
                        <th style="width: 140px">建立時間</th>
                        <th style="width: 100px">年齡</th>
                        <th style="width: 160px" class="text-end">操作</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var bf in _backupFiles)
                {
                    var ageDays = (int)(DateTime.UtcNow - bf.CreatedUtc).TotalDays;
                    var ageColor = ageDays > 30 ? "text-danger" : ageDays > 7 ? "text-warning" : "text-muted";
                    <tr>
                        <td><code class="small">@bf.Name</code></td>
                        <td class="small text-muted">@FormatBytes(bf.Size)</td>
                        <td class="small text-muted">@bf.CreatedUtc.ToLocalTime():yyyy-MM-dd HH:mm</td>
                        <td class="small @ageColor">@ageDays 天前</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-link p-0 me-2" href="@($"/Account/BackupFile?handler=Download&name={bf.Name}")" target="_blank">下載</a>
                            <a class="btn btn-sm btn-link p-0 text-danger"
                               href="@($"/Account/BackupFile?handler=Delete&name={bf.Name}")"
                               onclick="return confirm('確定刪除此備份檔？此動作不可復原。');">刪除</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
        else if (_backupFiles is not null)
        {
            <div class="card-body small text-muted">
                @(_backupSummary?.Directory ?? "備份目錄") 內目前沒有任何 etltool-*.db 檔案。
                可點上方按鈕立即建一份；或等下次 03:45 排程備份。
            </div>
        }
    </div>

    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>維護視窗 (Maintenance Windows)</span>
            <button class="btn btn-sm btn-primary" @onclick="OpenAddWindow">
                <Icon Name="plus" /> 新增 (DB)
            </button>
        </div>
        @{
            var nowLocal = DateTime.Now;
        }
        @if (_maintenanceMerged is null)
        {
            <div class="card-body small text-muted">載入中…</div>
        }
        else
        {
            @if (_currentlyActive is not null)
            {
                <div class="alert alert-warning m-3 mb-0 small">
                    <strong>⏸ 目前正在維護視窗中</strong> —
                    @(_currentlyActive.Reason ?? "(未提供原因)")
                    @(" / " + _currentlyActive.From + "-" + _currentlyActive.To),
                    所有排程觸發的 ETL 都會 skip；手動觸發仍允許。
                </div>
            }

            @if (_maintenanceMerged.Count == 0)
            {
                <div class="card-body small text-muted">
                    未設定任何維護視窗。可從上方「新增 (DB)」按鈕加入；或在 appsettings 配置 <code>Maintenance:Windows</code> 後重啟。
                </div>
            }
            else
            {
                <table class="table mb-0 align-middle">
                    <thead>
                        <tr>
                            <th style="width: 110px">來源</th>
                            <th>天</th>
                            <th style="width: 80px">起</th>
                            <th style="width: 80px">迄</th>
                            <th>原因</th>
                            <th style="width: 100px">狀態</th>
                            <th style="width: 120px" class="text-end">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var m in _maintenanceMerged)
                    {
                        <tr>
                            <td>
                                <span class="badge @(m.Source == "appsettings" ? "bg-secondary" : "bg-primary")">@m.Source</span>
                            </td>
                            <td><code class="small">@(m.Days.Length == 0 ? "(空)" : string.Join(", ", m.Days))</code></td>
                            <td><code>@m.From</code></td>
                            <td><code>@m.To</code></td>
                            <td class="small">@(m.Reason ?? "—")</td>
                            <td>
                                @if (!m.Enabled)
                                {
                                    <span class="badge bg-light text-dark">已停用</span>
                                }
                                else
                                {
                                    var mw = new EtlTool.Core.Scheduling.MaintenanceWindow
                                    {
                                        Days = m.Days, From = m.From, To = m.To, Reason = m.Reason,
                                    };
                                    if (mw.IsActive(nowLocal))
                                    {
                                        <span class="badge bg-warning text-dark">⏸ 進行中</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">啟用</span>
                                    }
                                }
                            </td>
                            <td class="text-end">
                                @if (m.DbId is not null)
                                {
                                    <button class="btn btn-sm btn-link p-0 me-2" @onclick="() => OpenEditWindow(m)">編輯</button>
                                    <button class="btn btn-sm btn-link p-0 text-danger" @onclick="() => DeleteWindow(m.DbId.Value)">刪除</button>
                                }
                                else
                                {
                                    <span class="small text-muted">(appsettings)</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        }
    </div>

    @if (_showWindowEdit)
    {
        <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5)">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">@(_editing.Id == Guid.Empty ? "新增維護視窗" : "編輯維護視窗")</h5>
                    </div>
                    <div class="modal-body">
                        <div class="mb-2">
                            <label class="form-label">天 (例：All / Mon,Tue,Wed,Thu,Fri / Sat,Sun)</label>
                            <input class="form-control" @bind="_editing.Days" placeholder="All" />
                            <small class="text-muted">逗號分隔；"All" = 每天；其他用 Mon/Tue/.../Sun 三字母縮寫。</small>
                        </div>
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label">起 (HH:mm)</label>
                                <input class="form-control" @bind="_editing.From" placeholder="02:00" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">迄 (HH:mm)</label>
                                <input class="form-control" @bind="_editing.To" placeholder="04:00" />
                            </div>
                        </div>
                        <div class="mb-2 mt-2">
                            <label class="form-label">原因 (audit / UI 提示)</label>
                            <input class="form-control" @bind="_editing.Reason" placeholder="夜間備份 / DB 維護" />
                        </div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" @bind="_editing.Enabled" />
                            <label class="form-check-label">啟用此視窗</label>
                        </div>
                        @if (_windowEditError is not null)
                        {
                            <div class="alert alert-danger mt-2 mb-0 small">@_windowEditError</div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="() => _showWindowEdit = false" disabled="@_windowBusy">取消</button>
                        <button class="btn btn-primary" @onclick="SaveWindow" disabled="@_windowBusy">儲存</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="card mb-3">
        <div class="card-header">維護視窗預演 (Dry-run)</div>
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small">假設時間 (本地)</label>
                    <input type="datetime-local" class="form-control form-control-sm" @bind="_dryRunInput" />
                </div>
                <div class="col-md-4">
                    <button class="btn btn-sm btn-outline-primary" @onclick="RunDryRun">
                        <Icon Name="play" /> 預演
                    </button>
                    <button class="btn btn-sm btn-link p-0 ms-2" @onclick="UseNow">用現在時間</button>
                </div>
            </div>
            @if (_dryRunResult is not null)
            {
                <div class="mt-3">
                    <p class="small mb-2">
                        針對時間 <code>@_dryRunResult.At:yyyy-MM-dd HH:mm</code>：
                        @if (_dryRunResult.ActiveWindows.Count > 0)
                        {
                            <span class="badge bg-warning text-dark">⏸ 排程觸發會 SKIP</span>
                            <span class="ms-2 small text-muted">命中 @_dryRunResult.ActiveWindows.Count 個視窗</span>
                        }
                        else
                        {
                            <span class="badge bg-success">✓ 排程觸發會正常執行</span>
                            <span class="ms-2 small text-muted">沒有視窗命中</span>
                        }
                    </p>
                    @if (_dryRunResult.ActiveWindows.Count > 0)
                    {
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>來源</th>
                                    <th>天</th>
                                    <th>起</th>
                                    <th>迄</th>
                                    <th>原因</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var w in _dryRunResult.ActiveWindows)
                                {
                                    <tr>
                                        <td><span class="badge @(w.Source == "appsettings" ? "bg-secondary" : "bg-primary")">@w.Source</span></td>
                                        <td><code class="small">@string.Join(", ", w.Days)</code></td>
                                        <td><code>@w.From</code></td>
                                        <td><code>@w.To</code></td>
                                        <td class="small">@(w.Reason ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            }
        </div>
    </div>

    <div class="alert alert-info small mb-0">
        提示：本頁僅顯示靜態組態與計數。即時排程器狀態請見 <a href="/scheduler">/scheduler</a>；
        詳細健康檢查（含元件 latency + 備份新鮮度）請見 <a href="/healthz/detail" target="_blank">/healthz/detail</a>。
    </div>
}

