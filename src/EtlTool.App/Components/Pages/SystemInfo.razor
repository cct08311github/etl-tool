    private bool _apiTestBusy;

    private async Task TestApiHealth()
    {
        _apiTestBusy = true;
        _apiTestResult = null;
        StateHasChanged();
        var sw = System.Diagnostics.Stopwatch.StartNew();
        try
        {
            using var http = HttpFactory.CreateClient();
            http.Timeout = TimeSpan.FromSeconds(5);
            var url = new Uri(new Uri(_baseUrl), "api/health");
            using var req = new HttpRequestMessage(HttpMethod.Get, url);
            // 若有 API key 啟用就帶第一把進去（這是 admin 測試用，不是真的 prod 流量）
            // 實務上 admin 應該知道至少一把 key；這裡不帶也沒關係，IP 對的話照樣通
            using var resp = await http.SendAsync(req, CancellationToken.None);
            sw.Stop();
            var body = await resp.Content.ReadAsStringAsync();
            // 只截前 500 字元防爆版
            if (body.Length > 500) body = body[..500] + "…";
            _apiTestResult = new ApiTestResult(
                Ok: resp.IsSuccessStatusCode,
                StatusCode: (int)resp.StatusCode,
                ElapsedMs: sw.ElapsedMilliseconds,
                Body: body,
                Error: resp.IsSuccessStatusCode ? null : resp.ReasonPhrase);
        }
        catch (Exception ex)
        {
            sw.Stop();
            _apiTestResult = new ApiTestResult(false, null, sw.ElapsedMilliseconds, null, ex.Message);
        }
        finally
        {
            _apiTestBusy = false;
        }
    }

