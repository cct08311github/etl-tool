    private async Task LoadMaintenanceAsync(CancellationToken ct)
    {
        _maintenanceMerged = await MaintRepo.ListAllAsync(ct);
        _currentlyActive = await MaintRepo.CurrentlyActiveAsync(DateTime.Now, ct);
    }

    private void OpenAddWindow()
    {
        _editing = new EtlTool.Core.Models.MaintenanceWindowEntity
        {
            Id = Guid.Empty,  // 用 Empty 標示「新增」
            Days = "All",
            From = "02:00",
            To = "04:00",
            Enabled = true,
        };
        _windowEditError = null;
        _showWindowEdit = true;
    }

    private void OpenEditWindow(EtlTool.Core.Scheduling.MergedMaintenanceWindow m)
    {
        if (m.DbId is null) return;
        _editing = new EtlTool.Core.Models.MaintenanceWindowEntity
        {
            Id = m.DbId.Value,
            Days = string.Join(",", m.Days),
            From = m.From,
            To = m.To,
            Reason = m.Reason,
            Enabled = m.Enabled,
        };
        _windowEditError = null;
        _showWindowEdit = true;
    }

    private async Task SaveWindow()
    {
        _windowEditError = null;
        if (string.IsNullOrWhiteSpace(_editing.Days)) { _windowEditError = "Days 必填（如 All）"; return; }
        if (!System.Text.RegularExpressions.Regex.IsMatch(_editing.From ?? "", @"^\d{2}:\d{2}$"))
        { _windowEditError = "From 必須是 HH:mm 格式"; return; }
        if (!System.Text.RegularExpressions.Regex.IsMatch(_editing.To ?? "", @"^\d{2}:\d{2}$"))
        { _windowEditError = "To 必須是 HH:mm 格式"; return; }

        _windowBusy = true;
        try
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            var actor = state.User.Identity?.Name;
            if (_editing.Id == Guid.Empty)
            {
                _editing.Id = Guid.NewGuid();
                await MaintRepo.CreateAsync(_editing, actor, CancellationToken.None);
            }
            else
            {
                await MaintRepo.UpdateAsync(_editing, actor, CancellationToken.None);
            }
            _showWindowEdit = false;
            await LoadMaintenanceAsync(CancellationToken.None);
        }
        catch (Exception ex)
        {
            _windowEditError = ex.Message;
        }
        finally
        {
            _windowBusy = false;
        }
    }

    private async Task DeleteWindow(Guid id)
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var actor = state.User.Identity?.Name;
        await MaintRepo.DeleteAsync(id, actor, CancellationToken.None);
        await LoadMaintenanceAsync(CancellationToken.None);
    }

    // ─── Maintenance window dry-run simulator ────────────────────────────
    private DateTime _dryRunInput = DateTime.Now;
    private record DryRunResult(DateTime At, List<EtlTool.Core.Scheduling.MergedMaintenanceWindow> ActiveWindows);
    private DryRunResult? _dryRunResult;

    private void UseNow()
    {
        _dryRunInput = DateTime.Now;
    }

    private async Task RunDryRun()
    {
        var all = await MaintRepo.ListAllAsync(CancellationToken.None);
        var active = new List<EtlTool.Core.Scheduling.MergedMaintenanceWindow>();
        foreach (var m in all)
        {
            if (!m.Enabled) continue;
            var mw = new EtlTool.Core.Scheduling.MaintenanceWindow
            {
                Days = m.Days, From = m.From, To = m.To, Reason = m.Reason,
            };
            if (mw.IsActive(_dryRunInput)) active.Add(m);
        }
        _dryRunResult = new DryRunResult(_dryRunInput, active);
    }

    private record WebhookTestResult(bool Ok, int? StatusCode, string? Error);
