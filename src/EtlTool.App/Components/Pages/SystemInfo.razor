    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            var asm = typeof(SystemInfo).Assembly;
            _assemblyVersion = asm.GetName().Version?.ToString() ?? "(unknown)";
            try { _buildTime = File.GetLastWriteTimeUtc(asm.Location); } catch { }

            var p = System.Diagnostics.Process.GetCurrentProcess();
            _pid = p.Id;
            var up = DateTime.UtcNow - p.StartTime.ToUniversalTime();
            _uptime = $"{(int)up.TotalDays}d {up.Hours}h {up.Minutes}m";
            _workingSet = FormatBytes(p.WorkingSet64);

            // SQLite 檔案路徑與大小
            try
            {
                var connStr = Db.Database.GetConnectionString() ?? "";
                var dataSrc = connStr.Split(';', StringSplitOptions.RemoveEmptyEntries)
                    .Select(s => s.Trim())
                    .FirstOrDefault(s => s.StartsWith("Data Source=", StringComparison.OrdinalIgnoreCase));
                if (dataSrc is not null)
                {
                    _dbPath = dataSrc["Data Source=".Length..].Trim('"', ' ');
                    if (File.Exists(_dbPath))
                        _dbSizeFormatted = FormatBytes(new FileInfo(_dbPath).Length);
                }
            }
            catch { /* 路徑解析失敗就顯示 — */ }

            // Counts (single AsNoTracking pass each)
            var pendingCount = await Db.ApprovalRequests
                .AsNoTracking()
                .CountAsync(r => r.Status == ApprovalStatus.Pending && r.ExpiresAt > DateTime.UtcNow);
            _counts = new Counts(
                Connections: await Db.Connections.CountAsync(),
                Tasks: await Db.EtlTasks.CountAsync(),
                EnabledTasks: await Db.EtlTasks.CountAsync(t => t.Enabled),
                Runs: await Db.RunHistories.LongCountAsync(),
                AuditEvents: await Db.AuditEvents.LongCountAsync(),
                Users: await Db.Users.CountAsync(),
                PendingApprovals: pendingCount);

            // Retention policy snapshot
            _retention = new Retention(
                AuditDays: Config.GetValue<int?>("Audit:RetentionDays"),
                AuditPerCategory: Config.GetValue<int?>("Audit:KeepLastPerCategory"),
                RunDays: Config.GetValue<int?>("RunHistory:RetentionDays"),
                RunPerTask: Config.GetValue<int?>("RunHistory:KeepLastPerTask"),
                SessionMinutes: (Config.GetSection(EtlTool.App.Auth.AuthOptions.SectionName)
                    .Get<EtlTool.App.Auth.AuthOptions>() ?? new EtlTool.App.Auth.AuthOptions())
                    .ResolveTimeoutMinutes(),
                MaxPasswordAgeDays: Config.GetValue<int?>($"{EtlTool.App.Auth.AuthOptions.SectionName}:MaxPasswordAgeDays") ?? 0);

            _security = new Security(
                WebhookUrl: Config["Webhooks:OnFailure"],
                WebhookFormat: Config["Webhooks:Format"],
                FailureStreakThreshold: Config.GetValue<int?>("Webhooks:FailureStreakThreshold") ?? 3);

            // API integration panel
            _apiRateLimitPerMinute = Config.GetValue<int?>("Api:RateLimitPerMinute") ?? 60;
            try { _baseUrl = Nav.BaseUri; } catch { _baseUrl = "http://localhost:5247/"; }

            // Audit chain head/tail
            try
            {
                _chainHeadHash = await Db.AuditEvents
                    .OrderBy(e => e.At).ThenBy(e => e.Id)
                    .Select(e => e.Hash).FirstOrDefaultAsync();
                _chainTailHash = await Db.AuditEvents
                    .OrderByDescending(e => e.At).ThenByDescending(e => e.Id)
                    .Select(e => e.Hash).FirstOrDefaultAsync();
            }
            catch { /* shrug */ }

            // Auto-disabled tasks
            _autoDisabled = await Db.EtlTasks
                .AsNoTracking()
                .Where(t => t.AutoDisabledAt != null)
                .OrderByDescending(t => t.AutoDisabledAt)
                .ToListAsync();

            // Backup files
            try
            {
                var dataDirForBk = Config["DataDirectory"]
                    ?? Environment.GetEnvironmentVariable("ETLTOOL_DATA_DIR")
                    ?? Path.Combine(HostEnv.ContentRootPath, "data");
                var bkDir = Config["Backup:Directory"] ?? Path.Combine(dataDirForBk, "backups");
                _backupSummary = new BackupSummary(bkDir, Config.GetValue<int?>("Backup:RetainCount") ?? 14);
                if (Directory.Exists(bkDir))
                {
                    _backupFiles = Directory.EnumerateFiles(bkDir, "etltool-*.db")
                        .Select(p => new FileInfo(p))
                        .OrderByDescending(fi => fi.Name, StringComparer.Ordinal)
                        .Select(fi => new BackupFileInfo(fi.Name, fi.Length, fi.CreationTimeUtc))
                        .ToList();
                }
                else
                {
                    _backupFiles = new();
                }
            }
            catch
            {
                _backupFiles = new();
            }

            // Maintenance windows (merged DB + appsettings)
            await LoadMaintenanceAsync(CancellationToken.None);
        }
        finally
        {
            _loading = false;
        }
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        if (bytes < 1024L * 1024 * 1024) return $"{bytes / (1024.0 * 1024):F1} MB";
        return $"{bytes / (1024.0 * 1024 * 1024):F2} GB";
    }

    /// <summary>對 webhook URL 做最簡 mask：保留 protocol + host，path / token 部分以 *** 取代。</summary>
    private static string MaskUrl(string url)
    {
        try
        {
            var u = new Uri(url);
            return $"{u.Scheme}://{u.Host}{(u.IsDefaultPort ? "" : $":{u.Port}")}/***";
        }
        catch
        {
            return "***";
        }
    }
