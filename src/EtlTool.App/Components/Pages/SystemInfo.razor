    private record IntegrityResult(bool IsOk, List<string> Lines, long ElapsedMs);
    private IntegrityResult? _integrityResult;
    private bool _integrityBusy;

    private async Task RunIntegrityCheck()
    {
        _integrityBusy = true;
        _integrityResult = null;
        StateHasChanged();
        var sw = System.Diagnostics.Stopwatch.StartNew();
        try
        {
            var lines = new List<string>();
            await using var conn = Db.Database.GetDbConnection();
            if (conn.State != System.Data.ConnectionState.Open) await conn.OpenAsync();
            await using var cmd = conn.CreateCommand();
            cmd.CommandText = "PRAGMA integrity_check;";
            await using var reader = await cmd.ExecuteReaderAsync();
            while (await reader.ReadAsync())
            {
                lines.Add(reader.GetString(0));
            }
            sw.Stop();
            var ok = lines.Count == 1 && string.Equals(lines[0], "ok", StringComparison.OrdinalIgnoreCase);
            _integrityResult = new IntegrityResult(ok, lines, sw.ElapsedMilliseconds);

            // Audit
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            var actor = state.User.Identity?.Name;
            await AuditLogger.LogAsync(
                EtlTool.Core.Models.AuditCategory.System,
                EtlTool.Core.Models.AuditAction.Update,
                ok
                    ? $"✓ SQLite integrity_check 通過（{sw.ElapsedMilliseconds} ms）"
                    : $"⚠ SQLite integrity_check 發現 {lines.Count} 項問題：{string.Join(" | ", lines.Take(3))}",
                severity: ok ? EtlTool.Core.Models.AuditSeverity.Info : EtlTool.Core.Models.AuditSeverity.Warning,
                actor: actor,
                ct: CancellationToken.None);
        }
        catch (Exception ex)
        {
            sw.Stop();
            _integrityResult = new IntegrityResult(false, new() { $"檢查失敗：{ex.Message}" }, sw.ElapsedMilliseconds);
        }
        finally
        {
            _integrityBusy = false;
        }
    }

    private record BackupFileInfo(string Name, long Size, DateTime CreatedUtc);
