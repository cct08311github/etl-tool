@page "/tasks/{Id:guid}/runs"
@rendermode InteractiveServer
@inject EtlTool.Data.Repositories.RunHistoryRepository RunRepo
@inject EtlTool.Data.Repositories.EtlTaskRepository TaskRepo

<PageTitle>執行歷史</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="m-0">執行歷史 — @(_taskName ?? "…")</h1>
    <a class="btn btn-outline-secondary" href="tasks">← 返回任務列表</a>
</div>

<div class="card mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small mb-1">狀態</label>
                <select class="form-select form-select-sm" @bind="_filterStatus" @bind:after="ApplyFilter">
                    <option value="">全部</option>
                    <option value="Success">Success</option>
                    <option value="Failed">Failed</option>
                    <option value="Running">Running</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1">起 (本機時間)</label>
                <input type="date" class="form-control form-control-sm" @bind="_filterFrom" @bind:after="ApplyFilter" />
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1">迄 (本機時間)</label>
                <input type="date" class="form-control form-control-sm" @bind="_filterTo" @bind:after="ApplyFilter" />
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1">觸發類型</label>
                <select class="form-select form-select-sm" @bind="_filterTrigger" @bind:after="ApplyFilter">
                    <option value="">全部</option>
                    <option value="Scheduled">Scheduled</option>
                    <option value="Manual">Manual</option>
                    <option value="Retry">Retry</option>
                </select>
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-2">
            <small class="text-muted">
                顯示 @(_filtered?.Count ?? 0) / @(_runs?.Count ?? 0) 筆
            </small>
            @if (HasActiveFilter)
            {
                <button class="btn btn-sm btn-link p-0" @onclick="ClearFilter">清除篩選</button>
            }
        </div>
    </div>
</div>

@if (_runs is null)
{
    <p class="text-muted">載入中…</p>
}
else if (_runs.Count == 0)
{
    <div class="empty-state">
        <h3>尚無執行紀錄</h3>
        <p>從任務列表按「立即執行」或等排程觸發後，這裡會顯示每次的詳細結果。</p>
    </div>
}
else if (_filtered is null || _filtered.Count == 0)
{
    <div class="empty-state">
        <p>篩選條件下無相符紀錄。</p>
        <button class="btn btn-link" @onclick="ClearFilter">清除篩選</button>
    </div>
}
else
{
    <div class="card">
    <table class="table mb-0 align-middle">
        <thead>
            <tr>
                <th>開始時間</th>
                <th>結束時間</th>
                <th>耗時</th>
                <th>狀態</th>
                <th class="text-end">讀取</th>
                <th class="text-end">寫入</th>
                <th>觸發</th>
                <th class="text-end">詳情</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var r in _filtered)
        {
            var isRetry = r.TriggerType == TriggerType.Retry;
            <tr class="@(isRetry ? "retry-row" : "")" style="@(isRetry ? "background: rgba(0,0,0,0.025)" : "")">
                <td>
                    @if (isRetry)
                    {
                        <span class="text-muted small me-1" title="這是上一次失敗後的自動重試">↳</span>
                    }
                    <span class="font-monospace small">@r.StartedAt.ToLocalTime().ToString("MM-dd HH:mm:ss")</span>
                </td>
                <td><span class="font-monospace small text-muted">@(r.FinishedAt?.ToLocalTime().ToString("MM-dd HH:mm:ss") ?? "—")</span></td>
                <td class="small text-muted">@(r.FinishedAt is null ? "—" : (r.FinishedAt.Value - r.StartedAt).ToString(@"hh\:mm\:ss"))</td>
                <td><RunStatusBadge Status="@r.Status" /></td>
                <td class="text-end">@r.RowsRead</td>
                <td class="text-end">@r.RowsWritten</td>
                <td>
                    @if (isRetry)
                    {
                        <span class="badge bg-light text-dark border">Retry</span>
                    }
                    else
                    {
                        <span class="text-muted small">@r.TriggerType</span>
                    }
                </td>
                <td class="text-end">
                    <a class="icon-btn" title="詳情" href="@($"runs/{r.Id}")"><Icon Name="external-link" /></a>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private List<EtlTool.Core.Models.RunHistory>? _runs;
    private List<EtlTool.Core.Models.RunHistory>? _filtered;
    private string? _taskName;

    private string _filterStatus = "";
    private string _filterTrigger = "";
    private DateTime? _filterFrom;
    private DateTime? _filterTo;

    private bool HasActiveFilter =>
        !string.IsNullOrEmpty(_filterStatus) ||
        !string.IsNullOrEmpty(_filterTrigger) ||
        _filterFrom.HasValue ||
        _filterTo.HasValue;

    protected override async Task OnInitializedAsync()
    {
        var ct = CancellationToken.None;
        _runs = await RunRepo.ListByTaskAsync(Id, 100, ct);
        var task = await TaskRepo.GetWithMappingsAsync(Id, ct);
        _taskName = task?.Name;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (_runs is null) { _filtered = null; return; }
        IEnumerable<EtlTool.Core.Models.RunHistory> q = _runs;

        if (Enum.TryParse<RunStatus>(_filterStatus, out var status))
            q = q.Where(r => r.Status == status);
        if (Enum.TryParse<TriggerType>(_filterTrigger, out var trigger))
            q = q.Where(r => r.TriggerType == trigger);
        if (_filterFrom.HasValue)
        {
            // local-date 起算 → UTC
            var fromUtc = _filterFrom.Value.Date.ToUniversalTime();
            q = q.Where(r => r.StartedAt >= fromUtc);
        }
        if (_filterTo.HasValue)
        {
            var toUtc = _filterTo.Value.Date.AddDays(1).AddTicks(-1).ToUniversalTime();
            q = q.Where(r => r.StartedAt <= toUtc);
        }
        _filtered = q.ToList();
    }

    private void ClearFilter()
    {
        _filterStatus = "";
        _filterTrigger = "";
        _filterFrom = null;
        _filterTo = null;
        ApplyFilter();
    }
}
