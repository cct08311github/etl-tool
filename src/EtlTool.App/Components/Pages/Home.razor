@page "/"
@rendermode InteractiveServer
@inject EtlTool.Data.Repositories.RunHistoryRepository RunHistoryRepo
@inject EtlTool.Data.Repositories.EtlTaskRepository TaskRepo
@inject EtlTool.Data.Repositories.ConnectionRepository ConnRepo
@inject EtlTool.Data.Repositories.AuditChainVerifier ChainVerifier
@inject EtlTool.Core.Scheduling.SchedulerKillSwitch KillSwitch
@inject AuthenticationStateProvider AuthState

<PageTitle>Dashboard</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="m-0">Dashboard</h1>
    @if (KillSwitch.IsPaused)
    {
        <button class="btn btn-success" @onclick="ResumeAll">
            <Icon Name="play" /> 恢復排程器
        </button>
    }
    else
    {
        <button class="btn btn-outline-danger" @onclick="() => _showPauseModal = true">
            <Icon Name="alert-triangle" /> 緊急暫停所有排程
        </button>
    }
</div>

@if (KillSwitch.IsPaused)
{
    <div class="alert alert-warning mb-3">
        <strong>⏸ 排程器已暫停</strong>
        — 由 <code>@KillSwitch.PausedBy</code> 於 @KillSwitch.PausedAtUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") 觸發
        @if (!string.IsNullOrEmpty(KillSwitch.PauseReason)) { <span>，理由：@KillSwitch.PauseReason</span> }
        。所有排程觸發的 ETL 都會 skip；手動觸發仍可執行。
    </div>
}

@* Audit chain integrity banner — Admin only。每 5 分鐘 cache 一次結果。 *@
<AuthorizeView Roles="Admin">
    <Authorized>
        @if (_chainResult is not null)
        {
            <div class="alert @(_chainResult.IsIntact ? "alert-success" : "alert-danger") py-2 px-3 mb-3 d-flex justify-content-between align-items-center">
                <div>
                    @if (_chainResult.IsIntact)
                    {
                        <Icon Name="check" />
                        <span class="ms-2"><strong>稽核鏈完整</strong> — 已驗證 @_chainResult.TotalChecked 筆事件，hash chain 無竄改跡象</span>
                    }
                    else
                    {
                        <Icon Name="alert-triangle" />
                        <span class="ms-2"><strong>⛔ 稽核鏈異常 — 第 @_chainResult.TotalChecked 筆</strong>：@_chainResult.Reason</span>
                    }
                </div>
                <div>
                    <small class="text-muted">@(_chainCheckedAt.HasValue ? FormatRelative(_chainCheckedAt.Value) : "")</small>
                    <button class="icon-btn ms-2" title="重新驗證" @onclick="ReverifyChainAsync" disabled="@_chainBusy">
                        <Icon Name="@(_chainBusy ? "loader" : "refresh")" />
                    </button>
                </div>
            </div>
        }
    </Authorized>
</AuthorizeView>

@if (_showPauseModal)
{
    <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title">⛔ 緊急暫停所有排程</h5></div>
                <div class="modal-body">
                    <p>暫停後：</p>
                    <ul>
                        <li>所有 cron 觸發的 ETL 都會 skip 並寫入 audit</li>
                        <li>已在執行中的不會被中斷</li>
                        <li>手動「立即執行」仍可使用</li>
                        <li>app 重啟後自動恢復</li>
                    </ul>
                    <label class="form-label">暫停理由（將寫入 audit log）</label>
                    <input class="form-control" @bind="_pauseReason" placeholder="例：來源 DB 異常排查中" />
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _showPauseModal = false">取消</button>
                    <button class="btn btn-danger" @onclick="ConfirmPause">確認暫停</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_loading)
{
    <p class="text-muted">載入中…</p>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-sm-6">
            <div class="stat-card @(_unhealthyConnections > 0 ? "stat-danger" : "")">
                <div class="stat-label"><Icon Name="database" /> 連線健康</div>
                <div class="stat-value">
                    @(_connectionsCount - _unhealthyConnections) / @_connectionsCount
                </div>
                @if (_unhealthyConnections > 0)
                {
                    <div class="stat-meta text-danger">
                        ⚠ @_unhealthyConnections 條失敗
                    </div>
                }
                else if (_connectionsCount > 0)
                {
                    <div class="stat-meta">全部正常</div>
                }
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="stat-card">
                <div class="stat-label"><Icon Name="list-checks" /> 啟用中任務</div>
                <div class="stat-value">@_enabledTasksCount<span class="text-muted" style="font-size:1rem;font-weight:400"> / @_tasksCount</span></div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="stat-card stat-success">
                <div class="stat-label"><Icon Name="check-circle" /> 近 24h 成功</div>
                <div class="stat-value">@_recentSuccess</div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="stat-card stat-danger">
                <div class="stat-label"><Icon Name="x-circle" /> 近 24h 失敗</div>
                <div class="stat-value">@_recentFailed</div>
            </div>
        </div>
    </div>

    <h2 class="mb-3">最近執行</h2>
    @if (_recentRuns.Count == 0)
    {
        <div class="empty-state">
            <h3>尚無執行紀錄</h3>
            <p>建立 ETL 任務並按「立即執行」後，這裡會顯示執行歷史。</p>
        </div>
    }
    else
    {
        <div class="card">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>任務</th>
                    <th>開始時間</th>
                    <th>狀態</th>
                    <th class="text-end">讀取</th>
                    <th class="text-end">寫入</th>
                    <th>觸發</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _recentRuns)
                {
                    <tr>
                        <td>@(_taskNames.TryGetValue(r.EtlTaskId, out var n) ? n : r.EtlTaskId.ToString())</td>
                        <td>@r.StartedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td><RunStatusBadge Status="@r.Status" /></td>
                        <td class="text-end">@r.RowsRead</td>
                        <td class="text-end">@r.RowsWritten</td>
                        <td>@r.TriggerType</td>
                        <td><a class="btn btn-sm btn-outline-secondary" href="@($"runs/{r.Id}")">詳情</a></td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
}

@code {
    private bool _loading = true;
    private bool _showPauseModal;
    private string _pauseReason = "";
    private int _connectionsCount;
    private int _unhealthyConnections;
    private int _tasksCount;
    private int _enabledTasksCount;
    private int _recentSuccess;
    private int _recentFailed;
    private List<EtlTool.Core.Models.RunHistory> _recentRuns = new();
    private Dictionary<Guid, string> _taskNames = new();

    // Audit chain integrity — cache (process-wide) so 多 admin 開頁面不重複跑全表
    private static EtlTool.Data.Repositories.AuditChainVerifier.VerifyResult? _cachedChainResult;
    private static DateTime? _cachedChainAt;
    private EtlTool.Data.Repositories.AuditChainVerifier.VerifyResult? _chainResult;
    private DateTime? _chainCheckedAt;
    private bool _chainBusy;
    private static readonly TimeSpan ChainCacheTtl = TimeSpan.FromMinutes(5);

    protected override async Task OnInitializedAsync()
    {
        var ct = CancellationToken.None;
        var conns = await ConnRepo.ListAsync(ct);
        var tasks = await TaskRepo.ListLightweightAsync(ct);
        var runs = await RunHistoryRepo.ListRecentAsync(50, ct);

        _connectionsCount = conns.Count;
        _unhealthyConnections = conns.Count(c => c.LastCheckOk == false);
        _tasksCount = tasks.Count;
        _enabledTasksCount = tasks.Count(t => t.Enabled);
        _taskNames = tasks.ToDictionary(t => t.Id, t => t.Name);

        var since = DateTime.UtcNow.AddHours(-24);
        _recentSuccess = runs.Count(r => r.StartedAt >= since && r.Status == RunStatus.Success);
        _recentFailed = runs.Count(r => r.StartedAt >= since && r.Status == RunStatus.Failed);
        _recentRuns = runs.Take(15).ToList();

        _loading = false;

        // Audit chain：admin 才跑；用 5 分鐘 cache，避免每次 dashboard 進來都全表 SHA-256
        var state = await AuthState.GetAuthenticationStateAsync();
        if (state.User.IsInRole("Admin"))
        {
            if (_cachedChainResult is not null && _cachedChainAt is not null
                && DateTime.UtcNow - _cachedChainAt.Value < ChainCacheTtl)
            {
                _chainResult = _cachedChainResult;
                _chainCheckedAt = _cachedChainAt;
            }
            else
            {
                await ReverifyChainAsync();
            }
        }
    }

    private async Task ReverifyChainAsync()
    {
        _chainBusy = true;
        try
        {
            var result = await ChainVerifier.VerifyAsync(CancellationToken.None);
            _chainResult = result;
            _chainCheckedAt = DateTime.UtcNow;
            _cachedChainResult = result;
            _cachedChainAt = _chainCheckedAt;
        }
        catch (Exception ex)
        {
            _chainResult = new EtlTool.Data.Repositories.AuditChainVerifier.VerifyResult(
                false, 0, null, $"驗證失敗：{ex.Message}");
        }
        finally
        {
            _chainBusy = false;
        }
    }

    private static string FormatRelative(DateTime utc)
    {
        var diff = DateTime.UtcNow - utc;
        if (diff.TotalSeconds < 60) return "剛剛驗證";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes} 分鐘前驗證";
        return $"{(int)diff.TotalHours} 小時前驗證";
    }

    private async Task ConfirmPause()
    {
        var actor = await GetUsernameAsync();
        await KillSwitch.PauseAsync(actor, string.IsNullOrWhiteSpace(_pauseReason) ? null : _pauseReason);
        _showPauseModal = false;
        _pauseReason = "";
    }

    private async Task ResumeAll()
    {
        var actor = await GetUsernameAsync();
        await KillSwitch.ResumeAsync(actor);
    }

    private async Task<string> GetUsernameAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        return state.User.Identity?.Name ?? "unknown";
    }
}
