@page "/tasks/new"
@page "/tasks/{Id:guid}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Operator")]
@inject EtlTool.Data.Repositories.EtlTaskRepository TaskRepo
@inject EtlTool.Data.Repositories.ConnectionRepository ConnRepo
@inject EtlTool.Core.Connectors.IDbConnectorFactory ConnectorFactory
@inject EtlTool.Core.Scheduling.SchedulerService Scheduler
@inject EtlTool.Core.Engine.EtlEngine EtlEngine
@inject EtlTool.App.Services.SourcePreviewService SourcePreview
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject IConfiguration Config

<PageTitle>編輯任務</PageTitle>

<div class="d-flex justify-content-between align-items-center">
    <h1 class="m-0">@(Id is null ? "新增任務" : "編輯任務")</h1>
    @if (Id is not null)
    {
        <div class="d-flex gap-2">
            <a class="btn btn-outline-warning btn-sm" href="@($"tasks/{Id}/schema-drift")">
                <Icon Name="alert-triangle" /> Schema 漂移
            </a>
            <button class="btn btn-outline-info btn-sm" @onclick="ShowWebhookPreview">
                <Icon Name="zap" /> 預覽 webhook payload
            </button>
            <a class="btn btn-outline-secondary btn-sm" href="@($"tasks/{Id}/history")">
                <Icon Name="history" /> 變更歷史
            </a>
        </div>
    }
</div>

@if (_showWebhookPreview)
{
    <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">📡 Webhook payload 預覽（不會實際發送）</h5>
                </div>
                <div class="modal-body">
                    <div class="mb-2 small text-muted">
                        以下是當此任務 <strong>失敗</strong> 時實際會 POST 到 webhook 的 JSON。
                        Format 來自 <code>Webhooks:Format</code> 設定（目前 = <code>@_webhookFormat</code>）。
                        Streak / Recovery prefix 由 <code>StreakAwareFailureNotifier</code> 加，這裡呈現「第 N 次連敗達門檻」的範例。
                    </div>
                    <div class="d-flex gap-2 mb-2 flex-wrap">
                        <button class="btn btn-sm @(_previewVariant == "fail" ? "btn-primary" : "btn-outline-secondary")"
                                @onclick="SetPreviewVariantFail">單次失敗</button>
                        <button class="btn btn-sm @(_previewVariant == "streak" ? "btn-primary" : "btn-outline-secondary")"
                                @onclick="SetPreviewVariantStreak">[STREAK] 達門檻</button>
                        <button class="btn btn-sm @(_previewVariant == "recovery" ? "btn-primary" : "btn-outline-secondary")"
                                @onclick="SetPreviewVariantRecovery">[RECOVERY] 恢復</button>
                        <button class="btn btn-sm @(_previewVariant == "success" ? "btn-primary" : "btn-outline-secondary")"
                                @onclick="SetPreviewVariantSuccess">單次成功 (一般執行不送)</button>
                    </div>
                    <pre class="bg-light p-2 mb-0" style="max-height: 480px; overflow: auto; font-size: 0.8rem">@_webhookPreviewJson</pre>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _showWebhookPreview = false">關閉</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showPiiSuggest)
{
    <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title">🔒 偵測到可能 PII 欄位 — 是否同時啟用 Mask？</h5>
                </div>
                <div class="modal-body">
                    <p>以下來源欄位疑似含 PII（個人識別資料）：</p>
                    <ul class="small">
                        @foreach (var c in _piiSuggestColumns)
                        {
                            <li><code>@c</code></li>
                        }
                    </ul>
                    <p>
                        若不啟用 <strong>MaskSamplePayload</strong>，每次執行的前 5 筆 sample 會以
                        <em>原始值</em> 寫入 RunHistory，admin 在 /runs 詳情頁就能看到實際資料。
                    </p>
                    <p class="small text-muted">
                        建議啟用：sample 仍會寫入但 PII 欄位會被 ***（保留原 schema 與筆數可供 debug）。
                    </p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" @onclick="() => _showPiiSuggest = false">取消儲存</button>
                    <button class="btn btn-link" @onclick="SaveWithoutMask">不啟用，仍要儲存</button>
                    <button class="btn btn-warning" @onclick="EnableMaskAndSave">啟用 mask 並儲存</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_task is null || _connections is null)
{
    <p>載入中...</p>
}
else
{
    <div class="card mb-3">
        <div class="card-header">基本資料</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">任務名稱</label>
                    <input class="form-control" @bind="_task.Name" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">啟用</label>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" @bind="_task.Enabled" />
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label">批次大小</label>
                    <input class="form-control" type="number" min="1" max="100000" @bind="_task.BatchSize" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">執行歷史保留筆數
                        <small class="text-muted" title="留空 = 套用全域設定 RunHistory:KeepLastPerTask">(覆寫)</small>
                    </label>
                    <input class="form-control" type="number" min="1" max="10000"
                           placeholder="(留空=用全域設定)" @bind="_task.RunHistoryRetentionRuns" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">預期最長執行時間 (分)
                        <small class="text-muted" title="超過時 watchdog 發 Warning audit；不會中斷任務">(覆寫)</small>
                    </label>
                    <input class="form-control" type="number" min="1" max="1440"
                           placeholder="(留空=用全域 30)" @bind="_task.MaxRunMinutes" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">連續失敗自動停用
                        <small class="text-muted" title="連續失敗 N 次自動 Disable 此任務；admin 修復後手動再啟用">(circuit-breaker)</small>
                    </label>
                    <input class="form-control" type="number" min="1" max="100"
                           placeholder="(留空=用全域 / 0)" @bind="_task.AutoDisableAfterFailures" />
                </div>
                <div class="col-12">
                    <label class="form-label">標籤 (Tags)
                        <small class="text-muted">逗號分隔；用於 Tasks list 過濾與分類。例：team-finance, daily, critical</small>
                    </label>
                    <input class="form-control" maxlength="200" list="task-tags-existing" placeholder="例：finance, daily, critical" @bind="_task.Tags" />
                    <datalist id="task-tags-existing">
                        @foreach (var tag in _knownTags)
                        {
                            <option value="@tag" />
                        }
                    </datalist>
                    @if (!string.IsNullOrWhiteSpace(_task.Tags))
                    {
                        <div class="d-flex flex-wrap gap-1 mt-1">
                            @foreach (var tag in (_task.Tags ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries).Select(s => s.Trim()).Where(s => s.Length > 0))
                            {
                                <span class="badge bg-secondary">@tag</span>
                            }
                        </div>
                    }
                    @if (_knownTags.Count > 0)
                    {
                        <small class="text-muted d-block mt-1">既有 tags（點擊 input 下拉建議）：@string.Join(", ", _knownTags.Take(15))@(_knownTags.Count > 15 ? $" …+{_knownTags.Count - 15}" : "")</small>
                    }
                </div>
                <div class="col-12">
                    <label class="form-label">Ops 交接備註
                        <small class="text-muted">業主、on-call、特殊維護程序、相依關係…</small>
                    </label>
                    <textarea class="form-control" rows="2" maxlength="2000" placeholder="例：業主 alice@bank；on-call bob@bank；02-04 維護需先停 task" @bind="_task.Notes"></textarea>
                </div>
                <div class="col-md-3">
                    <label class="form-label">依賴 Lookback (小時)
                        <small class="text-muted" title="parent 必須在過去 N 小時內有 Success；留空 = 24h">(覆寫)</small>
                    </label>
                    <input class="form-control" type="number" min="1" max="720"
                           placeholder="(留空=24h)" @bind="_task.DependencyLookbackHours" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Idempotent
                        <small class="text-muted">parent 跑完後只跑一次</small>
                    </label>
                    <div class="form-check form-switch">
                        <input type="checkbox" class="form-check-input"
                               @bind="_task.RunOncePerParentSuccess" />
                        <label class="form-check-label small text-muted">啟用後：若本任務已晚於所有 parent 成功過，下次 cron tick 會跳過</label>
                    </div>
                </div>
                <div class="col-12">
                    <label class="form-label">上游任務依賴 (DependsOn)
                        <small class="text-muted">需排程觸發前確認以下任務「過去 lookback 內成功」；手動觸發 / 重試一律不檢查</small>
                    </label>
                    @if (_connections is null || _allTasks is null)
                    {
                        <div class="text-muted small">載入中…</div>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var other in _allTasks.Where(t => t.Id != _task.Id))
                            {
                                var isParent = _selectedDependsOn.Contains(other.Id);
                                <label class="form-check m-0" style="cursor:pointer">
                                    <input type="checkbox" class="form-check-input me-1"
                                           checked="@isParent"
                                           @onchange="e => ToggleDependency(other.Id, (bool)e.Value!)" />
                                    <span class="form-check-label small">@other.Name</span>
                                </label>
                            }
                        </div>
                        @if (_selectedDependsOn.Count == 0)
                        {
                            <small class="text-muted">無依賴 — 排程觸發時直接執行</small>
                        }
                        else
                        {
                            <small class="text-muted">已選 @_selectedDependsOn.Count 個 parent；scheduler 會等到全部成功後才執行此任務。</small>
                        }
                    }
                </div>
                @if (_downstreamTasks.Count > 0)
                {
                    <div class="col-12">
                        <label class="form-label">下游任務（依賴此任務的）
                            <small class="text-muted">刪除 / 停用此任務前請確認下游影響</small>
                        </label>
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var d in _downstreamTasks)
                            {
                                <a href="@($"tasks/{d.Id}")" class="badge bg-info text-dark text-decoration-none">@d.Name</a>
                            }
                        </div>
                    </div>
                }
            </div>
            @if (Id is not null)
            {
                <div class="mt-3 small text-muted d-flex align-items-center gap-2">
                    @if (_task.SchemaSnapshotAt.HasValue)
                    {
                        <span>
                            Schema 快照於 <code>@_task.SchemaSnapshotAt.Value.ToLocalTime():yyyy-MM-dd HH:mm</code>
                            （drift 偵測會比對此快照與實際 schema）
                        </span>
                    }
                    else
                    {
                        <span>尚未擷取 schema 快照（drift 偵測首次執行時自動建立）。</span>
                    }
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearSchemaSnapshot">
                        <Icon Name="refresh" /> 清除 schema 快照
                    </button>
                </div>
            }
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>來源 (Source)</span>
                    <div class="btn-group btn-group-sm" role="group" aria-label="Source kind">
                        <input type="radio" class="btn-check" name="sourceKind" id="src-db"
                               checked="@(_task.SourceKind == EtlTool.Core.Models.SourceKind.Database)"
                               @onchange="@(() => OnSourceKindChanged(EtlTool.Core.Models.SourceKind.Database))" />
                        <label class="btn btn-outline-primary" for="src-db">🗄 資料庫</label>
                        <input type="radio" class="btn-check" name="sourceKind" id="src-file"
                               checked="@(_task.SourceKind == EtlTool.Core.Models.SourceKind.File)"
                               @onchange="@(() => OnSourceKindChanged(EtlTool.Core.Models.SourceKind.File))" />
                        <label class="btn btn-outline-primary" for="src-file">📄 檔案</label>
                    </div>
                </div>
                <div class="card-body">
                    @if (_task.SourceKind == EtlTool.Core.Models.SourceKind.Database)
                    {
                        <div class="mb-2">
                            <label class="form-label">連線</label>
                            <select class="form-select" @onchange="OnSourceConnectionChanged">
                                <option value="">— 選擇 —</option>
                                @foreach (var c in _connections)
                                {
                                    <option value="@c.Id" selected="@(c.Id == _task.SourceConnectionId)">@c.Name (@c.ProviderType)</option>
                                }
                            </select>
                        </div>
                        <div class="mb-2">
                            <div class="d-flex justify-content-between align-items-center">
                                <label class="form-label m-0">Schema</label>
                                <button type="button" class="icon-btn" title="重新讀取 schema / table 清單"
                                        disabled="@(_refreshingSource || _task.SourceConnectionId == Guid.Empty)"
                                        @onclick="RefreshSourceMetadata">
                                    @if (_refreshingSource) { <Icon Name="loader" /> } else { <Icon Name="refresh" /> }
                                </button>
                            </div>
                            <select class="form-select" @onchange="OnSourceSchemaChanged">
                                <option value="">— 選擇 —</option>
                                @foreach (var s in _sourceSchemas)
                                {
                                    <option value="@s" selected="@(s == _task.SourceSchema)">@s</option>
                                }
                            </select>
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Table</label>
                            <select class="form-select" @onchange="OnSourceTableChanged">
                                <option value="">— 選擇 —</option>
                                @foreach (var t in _sourceTables)
                                {
                                    <option value="@t" selected="@(t == _task.SourceTable)">@t</option>
                                }
                            </select>
                        </div>
                        <div class="mt-3 d-flex gap-2 align-items-center">
                            <button type="button" class="btn btn-outline-primary btn-sm"
                                    disabled="@(_previewBusy || _task.SourceConnectionId == Guid.Empty || string.IsNullOrEmpty(_task.SourceTable) || _task.Mappings.Count == 0)"
                                    @onclick="RunSourcePreview">
                                @if (_previewBusy) { <Icon Name="loader" /> <span>查詢中…</span> }
                                else { <span>👀 預覽前 10 筆來源資料</span> }
                            </button>
                            @if (_task.Mappings.Count == 0)
                            {
                                <span class="small text-muted">需先設好 Mapping 再預覽</span>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info small py-2 mb-2">
                            檔案模式：排程觸發時掃描指定目錄符合 glob 的檔，依 mtime 由舊至新處理。每個檔在目標 DB 上獨立 transaction。
                        </div>
                        <div class="mb-2">
                            <label class="form-label">
                                📂 來源目錄
                                <span class="badge bg-info text-dark ms-1" style="font-weight: normal">支援日期變數</span>
                            </label>
                            <input class="form-control font-monospace" @bind="_fileConfig.DirectoryPath"
                                   @bind:after="UpdateFileConfigJson"
                                   placeholder="/data/inbox 或 /data/inbox/${TODAY:yyyy-MM-dd}" />
                            @if (!string.IsNullOrEmpty(_fileConfig.DirectoryPath) && _fileConfig.DirectoryPath.Contains("${"))
                            {
                                <div class="small mt-1">
                                    <span class="text-muted">展開預覽（以現在時刻 @DateTime.Now.ToString("yyyy-MM-dd HH:mm") 計算）：</span>
                                    <code class="text-success">@EtlTool.Core.Engine.DateTokenResolver.SubstituteFilePath(_fileConfig.DirectoryPath, DateTime.Now)</code>
                                </div>
                            }
                        </div>
                        <div class="row g-2">
                            <div class="col-7">
                                <label class="form-label">
                                    檔名 glob
                                    <span class="badge bg-info text-dark ms-1" style="font-weight: normal">支援日期變數</span>
                                </label>
                                <input class="form-control font-monospace" @bind="_fileConfig.GlobPattern"
                                       @bind:after="UpdateFileConfigJson"
                                       placeholder="*.csv / orders_${TODAY:yyyyMMdd}_*.csv" />
                                @if (!string.IsNullOrEmpty(_fileConfig.GlobPattern) && _fileConfig.GlobPattern.Contains("${"))
                                {
                                    <div class="small mt-1">
                                        <span class="text-muted">展開預覽：</span>
                                        <code class="text-success">@EtlTool.Core.Engine.DateTokenResolver.SubstituteFilePath(_fileConfig.GlobPattern, DateTime.Now)</code>
                                    </div>
                                }
                            </div>
                            <div class="col-5">
                                <label class="form-label">每次最多處理</label>
                                <input type="number" min="1" class="form-control"
                                       @bind="_fileConfig.MaxFilesPerRun" @bind:after="UpdateFileConfigJson" />
                            </div>
                        </div>
                        <details class="small mt-2">
                            <summary class="text-primary" style="cursor: pointer">📅 日期變數一覽（點擊展開）</summary>
                            <div class="mt-2 p-2 bg-light rounded">
                                <p class="mb-2 small">
                                    語法：<code>${TOKEN}</code> 預設展成 <code>yyyy-MM-dd</code>；
                                    可加 <code>:</code> 指定格式 <code>${TOKEN:yyyyMMdd}</code> /
                                    <code>${TOKEN:yyyy-MM}</code> 等。基準時刻 = <strong>排程觸發當下</strong>，不是任務建立時。
                                </p>
                                <table class="table table-sm small mb-0">
                                    <thead>
                                        <tr>
                                            <th style="width: 28%">Token</th>
                                            <th style="width: 32%">說明</th>
                                            <th>範例（@DateTime.Now.ToString("yyyy-MM-dd") 觸發）</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr><td><code>${TODAY}</code></td><td>今天 0:00</td>
                                            <td><code>orders_${TODAY:yyyyMMdd}.csv</code> → <code>@($"orders_{DateTime.Now:yyyyMMdd}.csv")</code></td></tr>
                                        <tr><td><code>${YESTERDAY}</code></td><td>昨天 0:00</td>
                                            <td><code>${YESTERDAY:yyyy-MM-dd}</code> → <code>@DateTime.Now.AddDays(-1).ToString("yyyy-MM-dd")</code></td></tr>
                                        <tr><td><code>${TOMORROW}</code></td><td>明天 0:00</td>
                                            <td>—</td></tr>
                                        <tr><td><code>${NOW}</code></td><td>觸發瞬間（含時分秒）</td>
                                            <td><code>${NOW:yyyy-MM-dd_HHmm}</code> → <code>@DateTime.Now.ToString("yyyy-MM-dd_HHmm")</code></td></tr>
                                        <tr><td><code>${WEEK_START}</code></td><td>本週週一 0:00</td>
                                            <td>—</td></tr>
                                        <tr><td><code>${MONTH_START}</code></td><td>本月 1 號 0:00</td>
                                            <td><code>${MONTH_START:yyyy-MM}</code> → <code>@DateTime.Now.ToString("yyyy-MM")</code></td></tr>
                                        <tr><td><code>${LAST_MONTH_START}</code></td><td>上月 1 號 0:00</td>
                                            <td><code>${LAST_MONTH_START:yyyy-MM}</code> → <code>@DateTime.Now.AddMonths(-1).ToString("yyyy-MM")</code></td></tr>
                                        <tr><td><code>${LAST_MONTH_END}</code></td><td>上月最後一刻</td><td>—</td></tr>
                                        <tr><td><code>${QUARTER_START}</code></td><td>本季第 1 個月 1 號</td><td>—</td></tr>
                                        <tr><td><code>${YEAR_START}</code></td><td>今年 1/1 0:00</td>
                                            <td><code>${YEAR_START:yyyy}</code> → <code>@DateTime.Now.Year</code></td></tr>
                                        <tr><td><code>${DAYS_AGO_N}</code></td>
                                            <td>N 天前（N 為任意正整數）</td>
                                            <td><code>${DAYS_AGO_3:yyyyMMdd}</code> → <code>@DateTime.Now.AddDays(-3).ToString("yyyyMMdd")</code></td></tr>
                                        <tr><td><code>${WEEKS_AGO_N}</code></td><td>N 週前</td><td>—</td></tr>
                                        <tr><td><code>${MONTHS_AGO_N}</code></td><td>N 月前</td>
                                            <td><code>${MONTHS_AGO_6:yyyyMM}</code> → <code>@DateTime.Now.AddMonths(-6).ToString("yyyyMM")</code></td></tr>
                                    </tbody>
                                </table>
                                <div class="small text-muted mt-2">
                                    💡 完整 token 表（包含 HOUR_START / WTD / YTD / YOY / MoM 等）見
                                    <code>EtlTool.Core.Engine.DateTokenResolver</code>。Filter / DELETE WHERE 的 raw SQL 也認同樣的 token。
                                </div>
                            </div>
                        </details>
                        <div class="row g-2 mt-2">
                            <div class="col-6">
                                <label class="form-label">格式</label>
                                <select class="form-select" @bind="_fileConfig.Format" @bind:after="UpdateFileConfigJson">
                                    <option value="@EtlTool.Core.Models.FileSourceFormat.Csv">CSV</option>
                                    <option value="@EtlTool.Core.Models.FileSourceFormat.Excel">Excel (.xlsx)</option>
                                    <option value="@EtlTool.Core.Models.FileSourceFormat.DelimitedText">文字檔（自訂分隔）</option>
                                    <option value="@EtlTool.Core.Models.FileSourceFormat.FixedWidth">固定欄寬（主機/COBOL）</option>
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="form-label">編碼</label>
                                <select class="form-select" @bind="_fileConfig.Encoding" @bind:after="UpdateFileConfigJson">
                                    <option value="utf-8">UTF-8</option>
                                    <option value="utf-8-bom">UTF-8 with BOM</option>
                                    <option value="big5">Big5（繁中舊系統）</option>
                                    <option value="gb18030">GB18030（簡中）</option>
                                    <option value="shift-jis">Shift-JIS（日系）</option>
                                    <option value="iso-8859-1">ISO-8859-1（西文）</option>
                                </select>
                            </div>
                        </div>
                        @if (_fileConfig.Format == EtlTool.Core.Models.FileSourceFormat.Csv ||
                             _fileConfig.Format == EtlTool.Core.Models.FileSourceFormat.DelimitedText)
                        {
                            <div class="row g-2 mt-2">
                                <div class="col-4">
                                    <label class="form-label">分隔字元</label>
                                    <input class="form-control font-monospace" @bind="_fileConfig.Delimiter"
                                           @bind:after="UpdateFileConfigJson"
                                           placeholder=", 或 \t" />
                                    <small class="text-muted">用 \t 表示 tab</small>
                                </div>
                                <div class="col-4">
                                    <label class="form-label">引號字元</label>
                                    <input class="form-control font-monospace" @bind="_fileConfig.QuoteCharacter"
                                           @bind:after="UpdateFileConfigJson"
                                           maxlength="1" placeholder='" 或 留空' />
                                    <small class="text-muted">支援 "XXX","YYY"；留空關掉引號處理</small>
                                </div>
                                <div class="col-4 d-flex align-items-end">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox"
                                               @bind="_fileConfig.HasHeader" @bind:after="UpdateFileConfigJson" id="hasHeader" />
                                        <label class="form-check-label" for="hasHeader">第一列為欄位名</label>
                                    </div>
                                </div>
                            </div>
                        }
                        else if (_fileConfig.Format == EtlTool.Core.Models.FileSourceFormat.FixedWidth)
                        {
                            <div class="mt-2">
                                <div class="d-flex justify-content-between align-items-center">
                                    <label class="form-label m-0">欄位 layout（1-based 起點 + 長度）</label>
                                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddFixedWidthColumn">
                                        <Icon Name="plus" /> 新增欄位
                                    </button>
                                </div>
                                @if (_fwColumns.Count == 0)
                                {
                                    <div class="alert alert-info small mt-2 py-2 mb-2">
                                        尚未設定 layout。每行對應一個欄位。對照 COBOL FILE SECTION：PIC X(10) → Length=10。
                                    </div>
                                }
                                else
                                {
                                    <table class="table table-sm mt-2 mb-1">
                                        <thead>
                                            <tr>
                                                <th>欄位名</th>
                                                <th style="width: 90px">起點 (1-)</th>
                                                <th style="width: 90px">長度</th>
                                                <th style="width: 60px" title="自動 trim 前後空白">Trim</th>
                                                <th style="width: 40px"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (int i = 0; i < _fwColumns.Count; i++)
                                            {
                                                var idx = i;
                                                <tr>
                                                    <td>
                                                        <input class="form-control form-control-sm font-monospace"
                                                               @bind="_fwColumns[idx].Name" @bind:after="UpdateFwLayoutJson"
                                                               placeholder="ID / NAME / AMOUNT" />
                                                    </td>
                                                    <td>
                                                        <input type="number" min="1" class="form-control form-control-sm"
                                                               @bind="_fwColumns[idx].Start" @bind:after="UpdateFwLayoutJson" />
                                                    </td>
                                                    <td>
                                                        <input type="number" min="1" class="form-control form-control-sm"
                                                               @bind="_fwColumns[idx].Length" @bind:after="UpdateFwLayoutJson" />
                                                    </td>
                                                    <td class="text-center">
                                                        <input type="checkbox" class="form-check-input"
                                                               @bind="_fwColumns[idx].TrimWhitespace" @bind:after="UpdateFwLayoutJson" />
                                                    </td>
                                                    <td>
                                                        <button type="button" class="btn btn-sm btn-link p-0 text-danger"
                                                                @onclick="@(() => RemoveFixedWidthColumn(idx))" title="移除">×</button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                    <small class="text-muted">
                                        對照 COBOL：<code>01 RECORD. 02 ID PIC 9(5). 02 NAME PIC X(20).</code>
                                        → ID Start=1 Length=5；NAME Start=6 Length=20
                                    </small>
                                }
                            </div>
                        }
                        else  // Excel
                        {
                            <div class="row g-2 mt-2">
                                <div class="col-6">
                                    <label class="form-label">Sheet 名稱</label>
                                    <input class="form-control" @bind="_fileConfig.ExcelSheetName"
                                           @bind:after="UpdateFileConfigJson"
                                           placeholder="(空 = 第 1 個)" />
                                </div>
                                <div class="col-6 d-flex align-items-end">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox"
                                               @bind="_fileConfig.HasHeader" @bind:after="UpdateFileConfigJson" id="hasHeaderXl" />
                                        <label class="form-check-label" for="hasHeaderXl">第一列為欄位名</label>
                                    </div>
                                </div>
                            </div>
                        }
                        <hr />
                        <div class="row g-2">
                            <div class="col-5">
                                <label class="form-label">處理完動作</label>
                                <select class="form-select" @bind="_fileConfig.PostAction" @bind:after="UpdateFileConfigJson">
                                    <option value="@EtlTool.Core.Models.FilePostAction.Archive">📦 歸檔</option>
                                    <option value="@EtlTool.Core.Models.FilePostAction.Delete">🗑 刪除</option>
                                    <option value="@EtlTool.Core.Models.FilePostAction.None">原封不動</option>
                                </select>
                            </div>
                            <div class="col-7">
                                @if (_fileConfig.PostAction == EtlTool.Core.Models.FilePostAction.Archive)
                                {
                                    <label class="form-label">歸檔目錄</label>
                                    <input class="form-control font-monospace" @bind="_fileConfig.ArchiveDirectory"
                                           @bind:after="UpdateFileConfigJson"
                                           placeholder="(空 = ./archive)" />
                                }
                            </div>
                        </div>
                        @if (_fileConfig.PostAction == EtlTool.Core.Models.FilePostAction.None)
                        {
                            <div class="alert alert-warning small mt-2 mb-0 py-2">
                                ⚠ 「原封不動」模式下，下次掃描會再讀同樣的檔造成重複匯入。建議搭配檔名含時間戳（會變動）+ Upsert 模式。
                            </div>
                        }
                        <hr />
                        <div>
                            <label class="form-label d-flex justify-content-between align-items-center">
                                <span>
                                    🔍 Row 過濾（in-memory，可選）
                                    <span class="badge bg-info text-dark ms-1" style="font-weight: normal">DynamicExpresso C# 表達式</span>
                                </span>
                                @if (!string.IsNullOrWhiteSpace(_task.FileRowFilterExpression))
                                {
                                    @if (_filterCompileError is null)
                                    {
                                        <span class="badge bg-success">✓ 語法 OK</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger" title="@_filterCompileError">✗ 語法錯誤</span>
                                    }
                                }
                            </label>
                            <textarea class="form-control font-monospace" rows="2"
                                      @bind="_task.FileRowFilterExpression" @bind:after="ValidateFilterSyntax"
                                      placeholder="留空 = 不過濾（讀全部）。例：(int)row[&quot;AMOUNT&quot;] > 1000"></textarea>
                            @if (!string.IsNullOrWhiteSpace(_task.FileRowFilterExpression) && _filterCompileError is not null)
                            {
                                <div class="alert alert-danger small py-2 mt-1 mb-0">
                                    <strong>編譯錯誤：</strong> @_filterCompileError
                                </div>
                            }

                            <!-- 永遠展開的快速說明（不需要點擊） -->
                            <div class="alert alert-info small mt-2 mb-0 py-2">
                                <strong>這個欄位是什麼？</strong>
                                每從檔案讀進一列 row，<strong>馬上</strong>用此表達式判定。表達式回傳：
                                <ul class="mb-2 mt-1">
                                    <li><code>true</code> → 該列照常進入 batch、寫目標、計入 RowsWritten</li>
                                    <li><code>false</code> → 該列<strong>立刻跳過</strong>，不進 batch、不寫目標、不採樣、不算 RowsRead；RunHistory 多一個 <code>filtered_out=N</code> 欄記跳過幾筆</li>
                                </ul>
                                <strong>為什麼 in-memory？</strong>
                                檔案沒有 SQL 引擎可以「在來源端過濾」，必須先讀進來才能判斷。但因為是 row-by-row 串流判定，
                                <strong>不會把整個檔載入記憶體再過濾</strong>，跟 DB pushdown 的差別只在「跳過 row 之前已經 IO 進來了一次」。
                            </div>

                            <!-- 分類範例 -->
                            <details class="small mt-2" open>
                                <summary class="text-primary" style="cursor: pointer; font-weight: 600">📋 銀行常見過濾範例（按情境分類）</summary>
                                <div class="mt-2 p-2 bg-light rounded">
                                    <table class="table table-sm small mb-2">
                                        <thead class="table-light">
                                            <tr><th style="width: 35%">情境</th><th>表達式</th></tr>
                                        </thead>
                                        <tbody>
                                            <tr class="table-secondary"><td colspan="2"><strong>數值比較</strong>（CSV / FixedWidth 欄位回 string，需轉型；Excel 數值欄位回 double）</td></tr>
                                            <tr><td>交易金額 &gt; NT$1,000</td>
                                                <td><code>System.Convert.ToDecimal(row["AMOUNT"]) > 1000m</code></td></tr>
                                            <tr><td>金額在 1000–10000 之間</td>
                                                <td><code>System.Convert.ToDecimal(row["AMOUNT"]) &gt;= 1000m &amp;&amp; System.Convert.ToDecimal(row["AMOUNT"]) &lt;= 10000m</code></td></tr>
                                            <tr><td>整數 ID 大於 1000</td>
                                                <td><code>System.Convert.ToInt32(row["ID"]) > 1000</code></td></tr>

                                            <tr class="table-secondary"><td colspan="2"><strong>字串條件</strong></td></tr>
                                            <tr><td>地區 = 台北市</td>
                                                <td><code>(string)row["REGION"] == "台北市"</code></td></tr>
                                            <tr><td>地區屬於六都</td>
                                                <td><code>new[] { "台北市", "新北市", "桃園市", "台中市", "台南市", "高雄市" }.Contains((string)row["REGION"])</code></td></tr>
                                            <tr><td>產品名稱包含 「VIP」</td>
                                                <td><code>((string)row["PRODUCT"]).Contains("VIP")</code></td></tr>
                                            <tr><td>排除測試資料（ID 開頭 TEST_）</td>
                                                <td><code>!((string)row["ID"]).StartsWith("TEST_")</code></td></tr>
                                            <tr><td>狀態以 _OK 結尾</td>
                                                <td><code>((string)row["STATUS"]).EndsWith("_OK")</code></td></tr>

                                            <tr class="table-secondary"><td colspan="2"><strong>Null / 空值處理</strong></td></tr>
                                            <tr><td>狀態欄位非空且 = ACTIVE</td>
                                                <td><code>row["STATUS"] != null && (string)row["STATUS"] == "ACTIVE"</code></td></tr>
                                            <tr><td>客戶名稱不為空白</td>
                                                <td><code>!string.IsNullOrWhiteSpace((string)row["CUSTOMER_NAME"])</code></td></tr>
                                            <tr><td>備註欄位 null 視為「不要」</td>
                                                <td><code>row["MEMO"] != null</code></td></tr>

                                            <tr class="table-secondary"><td colspan="2"><strong>日期條件</strong>（Excel 直接是 DateTime；CSV / 文字檔需 parse）</td></tr>
                                            <tr><td>Excel：交易日期是今天</td>
                                                <td><code>((System.DateTime)row["TRADE_DATE"]).Date == System.DateTime.Today</code></td></tr>
                                            <tr><td>CSV：日期欄位 ≥ 2026-01-01</td>
                                                <td><code>System.DateTime.Parse((string)row["TRADE_DATE"]) >= new System.DateTime(2026, 1, 1)</code></td></tr>
                                            <tr><td>近 7 日內</td>
                                                <td><code>System.DateTime.Parse((string)row["TRADE_DATE"]) >= System.DateTime.Today.AddDays(-7)</code></td></tr>

                                            <tr class="table-secondary"><td colspan="2"><strong>金融場景</strong></td></tr>
                                            <tr><td>反洗錢（AML）— 大額 + 跨境</td>
                                                <td><code>System.Convert.ToDecimal(row["AMOUNT"]) >= 50000m && (string)row["TYPE"] == "INTL_WIRE"</code></td></tr>
                                            <tr><td>只匯入有效（非 VOID / CANCELLED）的交易</td>
                                                <td><code>!new[] { "VOID", "CANCELLED" }.Contains((string)row["STATUS"])</code></td></tr>
                                            <tr><td>排除測試環境的測試人帳號</td>
                                                <td><code>row["ACCOUNT"] != null && !((string)row["ACCOUNT"]).StartsWith("TEST")</code></td></tr>
                                        </tbody>
                                    </table>
                                </div>
                            </details>

                            <!-- 各檔案格式的型別差異 -->
                            <details class="small mt-2">
                                <summary class="text-primary" style="cursor: pointer">⚙ 不同檔案格式的型別對應（轉型參考）</summary>
                                <div class="mt-2 p-2 bg-light rounded">
                                    <table class="table table-sm small mb-0">
                                        <thead class="table-light">
                                            <tr><th>檔案格式</th><th>欄位實際型別</th><th>處理方式</th></tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td>CSV / DelimitedText / FixedWidth</td>
                                                <td>所有欄位都是 <code>string</code></td>
                                                <td>數值要轉：<code>System.Convert.ToInt32(row["X"])</code> 或 <code>(int)int.Parse((string)row["X"])</code><br />
                                                    日期要 parse：<code>System.DateTime.Parse((string)row["DATE"])</code></td>
                                            </tr>
                                            <tr>
                                                <td>Excel (.xlsx)</td>
                                                <td>保留原始型別（<code>double</code> / <code>DateTime</code> / <code>string</code> / <code>bool</code>）</td>
                                                <td>數值直接：<code>(double)row["AMOUNT"] > 1000</code><br />
                                                    日期直接：<code>((DateTime)row["DATE"]).Year == 2026</code></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    <div class="small text-muted mt-2">
                                        💡 通用寫法：用 <code>System.Convert.ToXXX(row["..."])</code> 系列
                                        對 string 與原生數值都適用，最不容易踩雷。
                                    </div>
                                </div>
                            </details>

                            <!-- 常見錯誤 + 跟 DB Filter 比較 -->
                            <details class="small mt-2">
                                <summary class="text-primary" style="cursor: pointer">⚠ 常見錯誤 / 跟 DB Filter 模式的差別</summary>
                                <div class="mt-2 p-2 bg-light rounded">
                                    <p class="mb-2"><strong>常見錯誤</strong></p>
                                    <table class="table table-sm small mb-3">
                                        <thead class="table-light">
                                            <tr><th>寫法</th><th>問題</th><th>修正</th></tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td><code>row["AMOUNT"] > 1000</code></td>
                                                <td>無法 &gt; 一個 object</td>
                                                <td><code>System.Convert.ToDecimal(row["AMOUNT"]) > 1000m</code></td>
                                            </tr>
                                            <tr>
                                                <td><code>row["NAME"].Contains("X")</code></td>
                                                <td>object 沒有 Contains</td>
                                                <td><code>((string)row["NAME"]).Contains("X")</code></td>
                                            </tr>
                                            <tr>
                                                <td><code>(int)row["ID"]</code>（CSV）</td>
                                                <td>CSV 是 string，直接 cast 失敗</td>
                                                <td><code>int.Parse((string)row["ID"])</code> 或 <code>System.Convert.ToInt32(row["ID"])</code></td>
                                            </tr>
                                            <tr>
                                                <td><code>(string)row["X"] == "Y"</code> 但 row["X"] 是 null</td>
                                                <td>(string)null cast 本身不 throw，<code>== "Y"</code> 結果為 false — 但若改成 <code>((string)row["X"]).Length</code> 之類就 NullRef</td>
                                                <td>養成習慣：先 null check：<code>row["X"] != null && (string)row["X"] == "Y"</code></td>
                                            </tr>
                                            <tr>
                                                <td><code>(int)row["X"]</code> 但 row["X"] 是 null</td>
                                                <td>value type cast null 直接 NullReferenceException</td>
                                                <td>用 <code>System.Convert.ToInt32(row["X"])</code>（null → 0）或先 null check</td>
                                            </tr>
                                            <tr>
                                                <td>用 <code>String.Format</code></td>
                                                <td>DynamicExpresso 預設 namespace 不含 System.*</td>
                                                <td>用全名 <code>System.String.Format(...)</code> 或 inline 字串組合</td>
                                            </tr>
                                            <tr>
                                                <td>表達式 throw NullReferenceException</td>
                                                <td>row[...] 是 null，但你直接 cast string 後呼叫 method</td>
                                                <td>先 null check：<code>row["X"] != null && ((string)row["X"]).Contains("Y")</code></td>
                                            </tr>
                                        </tbody>
                                    </table>

                                    <p class="mb-2"><strong>vs. DB Filter 模式</strong></p>
                                    <table class="table table-sm small mb-0">
                                        <thead class="table-light">
                                            <tr><th></th><th>檔案 Row 過濾（這個欄位）</th><th>DB Filter 模式（FilterBuilder / Raw SQL）</th></tr>
                                        </thead>
                                        <tbody>
                                            <tr><td>過濾位置</td><td>應用伺服器（in-memory）</td><td>來源 DB 端（SQL WHERE 推下去）</td></tr>
                                            <tr><td>是否 streaming</td><td>是（row-by-row 邊讀邊判）</td><td>是（DB 只送回符合的 row）</td></tr>
                                            <tr><td>網路 / IO 成本</td><td>整檔還是要讀進來；CPU 在應用端</td><td>來源 DB 過濾完才送 row 給應用 — 量大時更省頻寬</td></tr>
                                            <tr><td>效能</td><td>1M 列以下實務上 OK</td><td>適合超大資料量（10M+）</td></tr>
                                            <tr><td>語法</td><td>C# 表達式（DynamicExpresso）</td><td>表單 builder 或 raw SQL（依 source provider 文法）</td></tr>
                                            <tr><td>可用情境</td><td>SourceKind=File（這頁）</td><td>SourceKind=Database</td></tr>
                                        </tbody>
                                    </table>
                                    <div class="small text-muted mt-2">
                                        💡 規則：「&gt; 100k 列且來源在 DB → 用 DB Filter 推下去；檔案來源 → 沒得選，只能 in-memory，盡量挑短表達式」
                                    </div>
                                </div>
                            </details>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header">目標 (Target)</div>
                <div class="card-body">
                    <div class="mb-2">
                        <label class="form-label">連線</label>
                        <select class="form-select" @onchange="OnTargetConnectionChanged">
                            <option value="">— 選擇 —</option>
                            @foreach (var c in _connections)
                            {
                                <option value="@c.Id" selected="@(c.Id == _task.TargetConnectionId)">@c.Name (@c.ProviderType)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <label class="form-label m-0">Schema</label>
                            <button type="button" class="icon-btn" title="重新讀取 schema / table 清單"
                                    disabled="@(_refreshingTarget || _task.TargetConnectionId == Guid.Empty)"
                                    @onclick="RefreshTargetMetadata">
                                @if (_refreshingTarget) { <Icon Name="loader" /> } else { <Icon Name="refresh" /> }
                            </button>
                        </div>
                        <select class="form-select" @onchange="OnTargetSchemaChanged">
                            <option value="">— 選擇 —</option>
                            @foreach (var s in _targetSchemas)
                            {
                                <option value="@s" selected="@(s == _task.TargetSchema)">@s</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Table</label>
                        <select class="form-select" @onchange="OnTargetTableChanged">
                            <option value="">— 選擇 —</option>
                            @foreach (var t in _targetTables)
                            {
                                <option value="@t" selected="@(t == _task.TargetTable)">@t</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (_previewResult is not null)
    {
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>
                    來源資料預覽
                    @if (_previewResult.Ok)
                    {
                        <span class="badge bg-success ms-2">@_previewResult.Rows.Count 筆 / @_previewResult.ElapsedMs ms</span>
                    }
                    else
                    {
                        <span class="badge bg-danger ms-2">失敗</span>
                    }
                    @if (_previewResult.MaskedColumns.Count > 0)
                    {
                        <span class="badge bg-warning text-dark ms-2"
                              title="基於欄位名 PII 啟發式偵測自動遮罩，避免將敏感資料貼到截圖／訊息">
                            🔒 @_previewResult.MaskedColumns.Count 欄已遮罩
                        </span>
                    }
                </span>
                <button type="button" class="btn btn-sm btn-link p-0" @onclick="() => _previewResult = null">關閉</button>
            </div>
            @if (!_previewResult.Ok)
            {
                <div class="card-body alert alert-danger small mb-0">
                    <strong>查詢失敗：</strong> @_previewResult.Error
                    @if (!string.IsNullOrEmpty(_previewResult.Sql))
                    {
                        <details class="mt-2">
                            <summary class="small">送出的 SQL</summary>
                            <pre class="small mb-0 mt-1">@_previewResult.Sql</pre>
                        </details>
                    }
                </div>
            }
            else
            {
                @if (!string.IsNullOrEmpty(_previewResult.Sql))
                {
                    <div class="card-body py-2 small text-muted border-bottom">
                        <details>
                            <summary>送出的 SQL（已套用 filter / TOP 10）</summary>
                            <pre class="small mb-0 mt-1">@_previewResult.Sql</pre>
                        </details>
                    </div>
                }
                @if (_previewResult.MaskedColumns.Count > 0)
                {
                    <div class="card-body py-2 small text-muted border-bottom">
                        自動遮罩欄位（PiiDetector 命中）：
                        @foreach (var c in _previewResult.MaskedColumns)
                        {
                            <code class="me-1">@c</code>
                        }
                    </div>
                }
                @if (_previewResult.Rows.Count == 0)
                {
                    <div class="card-body small text-muted">沒有資料 — 過濾條件可能太嚴或表是空的。</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover small mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="text-muted" style="width: 30px">#</th>
                                    @foreach (var col in _previewResult.Columns)
                                    {
                                        <th>
                                            @col
                                            @if (_previewResult.MaskedColumns.Contains(col))
                                            {
                                                <span class="ms-1 text-warning" title="PII 自動遮罩">🔒</span>
                                            }
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @for (int idx = 0; idx < _previewResult.Rows.Count; idx++)
                                {
                                    var row = _previewResult.Rows[idx];
                                    <tr>
                                        <td class="text-muted small">@(idx + 1)</td>
                                        @foreach (var col in _previewResult.Columns)
                                        {
                                            <td class="small">
                                                @if (row.TryGetValue(col, out var v) && v is not null)
                                                {
                                                    <code class="small">@FormatPreviewValue(v)</code>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small fst-italic">null</span>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>
    }

    <div class="card mb-3">
        <div class="card-header">寫入模式</div>
        <div class="card-body">
            <div class="mb-2">
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="wmode" id="wm-di" checked="@(_task.WriteMode == WriteMode.DeleteInsert)" @onchange="() => _task.WriteMode = WriteMode.DeleteInsert" />
                    <label class="form-check-label" for="wm-di">
                        <strong>Delete-Insert</strong>：依條件刪除目標表的資料，再批次插入。一致性高，適合「整批覆蓋同條件資料」。
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="wmode" id="wm-up" checked="@(_task.WriteMode == WriteMode.Upsert)" @onchange="() => _task.WriteMode = WriteMode.Upsert" />
                    <label class="form-check-label" for="wm-up">
                        <strong>Upsert</strong>：依「主鍵欄位」判斷，存在就更新、不存在就新增（不會刪除目標既有資料）。
                    </label>
                </div>
            </div>

            @if (_task.WriteMode == WriteMode.DeleteInsert)
            {
                <div class="mt-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="del-same" @bind="_task.DeleteWhereSameAsFilter" />
                        <label class="form-check-label" for="del-same">刪除條件＝讀取條件 (常見)</label>
                    </div>
                    @if (!_task.DeleteWhereSameAsFilter)
                    {
                        <div class="mt-2">
                            <label class="form-label">自訂刪除 WHERE 子句</label>
                            <textarea class="form-control font-monospace" rows="2" @bind="_task.DeleteWhereRawSql"></textarea>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">重試政策</div>
        <div class="card-body">
            <p class="text-muted small mb-3">
                執行失敗時自動重試 — 適合處理短暫的網路或 DB 抖動。
                每次嘗試都會留下獨立的執行紀錄（標示為 <code>Retry</code>）。
            </p>
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">最大重試次數</label>
                    <input type="number" class="form-control" min="0" max="10" @bind="_task.MaxRetries" />
                    <small class="text-muted">0 = 不重試</small>
                </div>
                <div class="col-md-3">
                    <label class="form-label">首次延遲 (秒)</label>
                    <input type="number" class="form-control" min="1" max="3600" @bind="_task.RetryDelaySeconds" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">退避倍數</label>
                    <input type="number" step="0.5" class="form-control" min="1.0" max="10.0" @bind="_task.RetryBackoffMultiplier" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">實際延遲</label>
                    <div class="text-muted small font-monospace pt-2">
                        @if (_task.MaxRetries == 0)
                        {
                            <span>—</span>
                        }
                        else
                        {
                            @ComputeRetryDelays(_task)
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">篩選條件 (來源)</div>
        <div class="card-body">
            <FilterBuilder
                Mode="@_task.FilterMode" ModeChanged="@(v => _task.FilterMode = v)"
                FormJson="@_task.FilterFormJson" FormJsonChanged="@(v => _task.FilterFormJson = v)"
                RawSql="@_task.FilterRawSql" RawSqlChanged="@(v => _task.FilterRawSql = v)"
                SourceColumns="@_sourceColumns" />
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>欄位映射</span>
            @if (_task.SourceKind == EtlTool.Core.Models.SourceKind.File)
            {
                <button type="button" class="btn btn-sm btn-outline-primary"
                        disabled="@(_headerScanBusy || string.IsNullOrEmpty(_fileConfig.DirectoryPath))"
                        @onclick="ScanHeaderAndSuggest">
                    @if (_headerScanBusy) { <Icon Name="loader" /> <span>掃描中…</span> }
                    else { <span>🔍 掃描來源 header 並建議修正</span> }
                </button>
            }
        </div>
        <div class="card-body">
            @if (_headerSuggestions is not null && _headerSuggestions.Count > 0)
            {
                <div class="alert alert-info small mb-3">
                    <strong>來源檔 header 比對結果（檔：<code>@_headerScanFileName</code>）：</strong>
                    <table class="table table-sm small mt-2 mb-2">
                        <thead>
                            <tr>
                                <th style="width: 30%">目前 SourceColumn</th>
                                <th style="width: 18%">狀態</th>
                                <th style="width: 30%">建議改成</th>
                                <th class="text-end">動作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in _headerSuggestions)
                            {
                                var bg = s.Strategy switch
                                {
                                    EtlTool.Core.Engine.CsvHeaderMatcher.MatchStrategy.ExactMatch => "bg-success",
                                    EtlTool.Core.Engine.CsvHeaderMatcher.MatchStrategy.CaseInsensitive => "bg-info text-dark",
                                    EtlTool.Core.Engine.CsvHeaderMatcher.MatchStrategy.NormalizedCanonical => "bg-info text-dark",
                                    EtlTool.Core.Engine.CsvHeaderMatcher.MatchStrategy.FuzzyLevenshtein => "bg-warning text-dark",
                                    _ => "bg-danger",
                                };
                                <tr>
                                    <td><code>@s.Original</code></td>
                                    <td><span class="badge @bg">@EtlTool.Core.Engine.CsvHeaderMatcher.StrategyLabel(s.Strategy)</span></td>
                                    <td>
                                        @if (s.Suggested is not null && s.Suggested != s.Original)
                                        {
                                            <code>@s.Suggested</code>
                                        }
                                        else if (s.Suggested == s.Original)
                                        {
                                            <span class="text-muted small">—（已一致）</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (s.Suggested is not null && s.Suggested != s.Original
                                             && s.Strategy != EtlTool.Core.Engine.CsvHeaderMatcher.MatchStrategy.None)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-primary"
                                                    @onclick="@(() => ApplySuggestion(s))">套用</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div class="d-flex gap-2">
                        @if (_headerSuggestions.Any(x => x.Suggested is not null && x.Suggested != x.Original
                            && x.Strategy != EtlTool.Core.Engine.CsvHeaderMatcher.MatchStrategy.None))
                        {
                            <button type="button" class="btn btn-sm btn-primary" @onclick="ApplyAllSuggestions">
                                全部套用建議
                            </button>
                        }
                        <button type="button" class="btn btn-sm btn-link" @onclick="() => _headerSuggestions = null">關閉</button>
                    </div>
                </div>
            }
            @if (!string.IsNullOrEmpty(_headerScanError))
            {
                <div class="alert alert-warning small mb-3">⚠ @_headerScanError</div>
            }
            <MappingEditor
                Mappings="@_task.Mappings"
                SourceColumns="@_sourceColumns"
                TargetColumns="@_targetColumns"
                ShowKeyColumn="@(_task.WriteMode == WriteMode.Upsert)"
                OnChanged="@StateHasChanged" />
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>排程</span>
            <a href="/scheduler/preview" target="_blank" class="btn btn-sm btn-link p-0"
               title="開新分頁顯示未來 24h 所有任務觸發點 + 自動偵測同表寫入衝突 / 同來源連線壓力">
                ↗ 開排程預覽 (檢查衝突)
            </a>
        </div>
        <div class="card-body">
            <CronEditor Value="@_task.CronExpression" ValueChanged="@(v => _task.CronExpression = v)" />
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">資料量斷言 (Row Count Assertion)</div>
        <div class="card-body">
            <p class="text-muted small mb-2">
                預期讀取的最少 / 最多筆數。違反時依政策處理，可避免「上游空表 silently 寫 0 筆」之類問題。
            </p>
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">最少筆數 (≥)</label>
                    <input type="number" class="form-control" min="0" placeholder="不限"
                           @bind="_task.MinExpectedRows" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">最多筆數 (≤)</label>
                    <input type="number" class="form-control" min="0" placeholder="不限"
                           @bind="_task.MaxExpectedRows" />
                </div>
                <div class="col-md-6">
                    <label class="form-label d-block">違反時</label>
                    <div class="form-check form-check-inline">
                        <input type="radio" class="form-check-input" id="rc-ignore" name="rcpol"
                               checked="@(_task.RowCountPolicy == EtlTool.Core.Engine.RowCountAssertionPolicy.Ignore)"
                               @onchange="() => _task.RowCountPolicy = EtlTool.Core.Engine.RowCountAssertionPolicy.Ignore" />
                        <label class="form-check-label" for="rc-ignore">不檢查</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input type="radio" class="form-check-input" id="rc-warn" name="rcpol"
                               checked="@(_task.RowCountPolicy == EtlTool.Core.Engine.RowCountAssertionPolicy.Warn)"
                               @onchange="() => _task.RowCountPolicy = EtlTool.Core.Engine.RowCountAssertionPolicy.Warn" />
                        <label class="form-check-label" for="rc-warn">仍寫入 + 警告</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input type="radio" class="form-check-input" id="rc-fail" name="rcpol"
                               checked="@(_task.RowCountPolicy == EtlTool.Core.Engine.RowCountAssertionPolicy.Fail)"
                               @onchange="() => _task.RowCountPolicy = EtlTool.Core.Engine.RowCountAssertionPolicy.Fail" />
                        <label class="form-check-label" for="rc-fail">Fail (rollback)</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Schema 漂移偵測 (banking 等級資料完整性檢查)</div>
        <div class="card-body">
            <p class="text-muted small mb-2">
                每次儲存任務時自動快照當下的來源/目標欄位定義。執行 ETL 前會比對目前 schema 與快照，
                若上游加欄/移欄/改型 → 依下方政策處置。
            </p>
            <div class="row g-2 mb-2">
                <div class="col-md-12">
                    <div class="form-check form-check-inline">
                        <input type="radio" class="form-check-input" id="sd-ignore" name="sdpol"
                               checked="@(_task.SchemaDriftPolicy == SchemaDriftPolicy.Ignore)"
                               @onchange="() => _task.SchemaDriftPolicy = SchemaDriftPolicy.Ignore" />
                        <label class="form-check-label" for="sd-ignore">不檢查 (Ignore)</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input type="radio" class="form-check-input" id="sd-warn" name="sdpol"
                               checked="@(_task.SchemaDriftPolicy == SchemaDriftPolicy.Warn)"
                               @onchange="() => _task.SchemaDriftPolicy = SchemaDriftPolicy.Warn" />
                        <label class="form-check-label" for="sd-warn">僅警告 (Warn) — 寫 audit 但仍執行</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input type="radio" class="form-check-input" id="sd-fail" name="sdpol"
                               checked="@(_task.SchemaDriftPolicy == SchemaDriftPolicy.Fail)"
                               @onchange="() => _task.SchemaDriftPolicy = SchemaDriftPolicy.Fail" />
                        <label class="form-check-label" for="sd-fail">直接失敗 (Fail) — mapping 受影響時立即停止</label>
                    </div>
                </div>
            </div>
            <div class="text-muted small">
                <strong>目前 schema 快照：</strong>
                @if (_task.SchemaSnapshotAt.HasValue)
                {
                    <code>@_task.SchemaSnapshotAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</code>
                    <span class="ms-2">
                        (來源 @SnapshotColumnCount(_task.SourceSchemaSnapshotJson) 欄 ·
                        目標 @SnapshotColumnCount(_task.TargetSchemaSnapshotJson) 欄)
                    </span>
                }
                else
                {
                    <span class="text-warning">尚未建立 — 儲存任務時會自動建立。</span>
                }
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">隱私保護</div>
        <div class="card-body">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="mask-sample" @bind="_task.MaskSamplePayload" />
                <label class="form-check-label" for="mask-sample">
                    <strong>遮罩 sample payload</strong>
                </label>
            </div>
            <small class="text-muted d-block mt-1">
                開啟時，執行歷史中保存的「前 5 筆 sample」字串值若 &gt; 4 字 會自動遮罩成
                <code>A***e</code> 形式（保留首尾各一字、中間以 * 代替）。
                適合 PII / 客戶資料表。數值與日期不遮罩，方便除錯。
            </small>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">完成後呼叫 Stored Procedure (可選)</div>
        <div class="card-body">
            <div class="alert alert-info small mb-3 py-2">
                ETL 在<strong>目標 DB</strong> 上 commit 完成後（成功或失敗），呼叫此 SP。常見用途：
                <ul class="mb-0 mt-1">
                    <li>標記下游表「最新一次更新時間」</li>
                    <li>觸發後續處理（推 Kafka topic / 跑彙總 / 發 email）</li>
                    <li>寫入監控表給 BI 儀表板用</li>
                </ul>
                <strong>SP 失敗不會 rollback 已寫入的資料</strong>，僅在 RunHistory 記下錯誤訊息（所以 SP 設計要 idempotent）。
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">成功後 SP（schema.name）</label>
                    <input class="form-control font-monospace" placeholder="例：dbo.OnEtlSucceeded / HR.LOG_ETL_OK"
                           @bind="_task.PostSuccessSp" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">失敗後 SP（schema.name）</label>
                    <input class="form-control font-monospace" placeholder="例：dbo.OnEtlFailed / HR.LOG_ETL_FAIL"
                           @bind="_task.PostFailureSp" />
                </div>
            </div>

            <details class="small mt-3" open>
                <summary class="text-primary" style="cursor: pointer; font-weight: 600">📋 SP 參數規格 + SQL Server / Oracle 範例（點擊收合）</summary>
                <div class="mt-2 p-2 bg-light rounded">
                    <p class="mb-2"><strong>1. 參數一覽</strong>（呼叫順序固定，命名一律小寫底線；連接器會自動加 <code>@@</code> 或 <code>:</code> 前綴）</p>
                    <table class="table table-sm small mb-3">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 22%">參數名稱</th>
                                <th style="width: 18%">型別</th>
                                <th>說明</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td><code>task_id</code></td><td>NVARCHAR(50) / VARCHAR2(50)</td><td>任務 ID（GUID 字串，例 <code>3f2b...</code>）</td></tr>
                            <tr><td><code>task_name</code></td><td>NVARCHAR(100) / VARCHAR2(100)</td><td>任務名稱（使用者可讀）</td></tr>
                            <tr><td><code>run_id</code></td><td>NVARCHAR(50) / VARCHAR2(50)</td><td>本次執行 ID（GUID 字串），可用於關聯 RunHistory 表</td></tr>
                            <tr><td><code>status</code></td><td>NVARCHAR(16) / VARCHAR2(16)</td><td><code>Success</code> / <code>Failed</code>（字串）</td></tr>
                            <tr><td><code>rows_read</code></td><td>BIGINT / NUMBER(19)</td><td>讀取筆數（含被 row filter 過濾掉之外的）</td></tr>
                            <tr><td><code>rows_written</code></td><td>BIGINT / NUMBER(19)</td><td>實際寫入目標表筆數</td></tr>
                            <tr><td><code>started_at</code></td><td>DATETIME2 / TIMESTAMP</td><td>開始時間（UTC）</td></tr>
                            <tr><td><code>finished_at</code></td><td>DATETIME2 / TIMESTAMP</td><td>結束時間（UTC）</td></tr>
                            <tr><td><code>error_message</code></td><td>NVARCHAR(MAX) / CLOB</td><td>錯誤訊息（成功時為空字串或 NULL）</td></tr>
                            <tr><td><code>trigger_type</code></td><td>NVARCHAR(16) / VARCHAR2(16)</td><td><code>Scheduled</code> / <code>Manual</code> / <code>Retry</code></td></tr>
                        </tbody>
                    </table>

                    <p class="mb-2"><strong>2. SQL Server 範例</strong>（@@ 前綴）</p>
                    <pre class="bg-white p-2 mb-3 rounded border small"><code>CREATE PROCEDURE dbo.OnEtlSucceeded
    @@task_id        NVARCHAR(50),
    @@task_name      NVARCHAR(100),
    @@run_id         NVARCHAR(50),
    @@status         NVARCHAR(16),
    @@rows_read      BIGINT,
    @@rows_written   BIGINT,
    @@started_at     DATETIME2,
    @@finished_at    DATETIME2,
    @@error_message  NVARCHAR(MAX),
    @@trigger_type   NVARCHAR(16)
AS
BEGIN
    SET NOCOUNT ON;

    -- 範例 1：標記下游表最新更新時間
    UPDATE dbo.EtlMetadata
       SET LastUpdatedAt   = @@finished_at,
           LastRunId       = @@run_id,
           LastRowsWritten = @@rows_written
     WHERE TaskName = @@task_name;

    -- 範例 2：寫入監控表給 BI 用
    INSERT INTO dbo.EtlAuditLog
        (TaskId, TaskName, RunId, Status, RowsRead, RowsWritten,
         StartedAt, FinishedAt, ErrorMessage, TriggerType)
    VALUES
        (@@task_id, @@task_name, @@run_id, @@status, @@rows_read, @@rows_written,
         @@started_at, @@finished_at, @@error_message, @@trigger_type);

    -- 範例 3：條件式觸發後續處理
    IF @@rows_written = 0
    BEGIN
        -- 0 列警告：發 email / 推 Slack / 寫 alert 表
        INSERT INTO dbo.EtlEmptyRunAlerts (TaskName, RunId, AtUtc)
        VALUES (@@task_name, @@run_id, SYSUTCDATETIME());
    END
END
GO</code></pre>

                    <p class="mb-2"><strong>3. Oracle 範例</strong>（: 前綴 — connector 會自動處理；SP 內仍用標準 PL/SQL 語法）</p>
                    <pre class="bg-white p-2 mb-3 rounded border small"><code>CREATE OR REPLACE PROCEDURE HR.LOG_ETL_OK (
    p_task_id        IN VARCHAR2,
    p_task_name      IN VARCHAR2,
    p_run_id         IN VARCHAR2,
    p_status         IN VARCHAR2,
    p_rows_read      IN NUMBER,
    p_rows_written   IN NUMBER,
    p_started_at     IN TIMESTAMP,
    p_finished_at    IN TIMESTAMP,
    p_error_message  IN CLOB,
    p_trigger_type   IN VARCHAR2
)
AS
BEGIN
    -- 範例 1：標記下游表最新更新時間
    UPDATE HR.ETL_METADATA
       SET LAST_UPDATED_AT   = p_finished_at,
           LAST_RUN_ID       = p_run_id,
           LAST_ROWS_WRITTEN = p_rows_written
     WHERE TASK_NAME = p_task_name;

    -- 範例 2：寫入監控表
    INSERT INTO HR.ETL_AUDIT_LOG (
        TASK_ID, TASK_NAME, RUN_ID, STATUS, ROWS_READ, ROWS_WRITTEN,
        STARTED_AT, FINISHED_AT, ERROR_MESSAGE, TRIGGER_TYPE)
    VALUES (
        p_task_id, p_task_name, p_run_id, p_status, p_rows_read, p_rows_written,
        p_started_at, p_finished_at, p_error_message, p_trigger_type);

    -- 範例 3：發 dbms_aq 訊息給下游消費者
    -- DBMS_AQ.ENQUEUE(...) — 視場景接 AQ / Kafka bridge / 通知

    COMMIT;  -- ⚠ 必須 COMMIT；應用端不會 commit 你的 SP 變更
EXCEPTION
    WHEN OTHERS THEN
        -- 不要 RAISE — 否則 connector 會視為 SP 失敗（雖然主 ETL 已 commit）
        -- 銀行做法：寫個 fallback log 表保留錯誤跡象
        INSERT INTO HR.ETL_SP_ERROR_LOG (RUN_ID, ERROR_AT, ERROR_TEXT)
        VALUES (p_run_id, SYSTIMESTAMP, SQLERRM);
        COMMIT;
END LOG_ETL_OK;
/</code></pre>

                    <p class="mb-2"><strong>4. 失敗 SP 範例</strong>（會在 ETL fail 後呼叫）</p>
                    <pre class="bg-white p-2 mb-3 rounded border small"><code>-- SQL Server
CREATE PROCEDURE dbo.OnEtlFailed
    @@task_id NVARCHAR(50), @@task_name NVARCHAR(100), @@run_id NVARCHAR(50),
    @@status NVARCHAR(16), @@rows_read BIGINT, @@rows_written BIGINT,
    @@started_at DATETIME2, @@finished_at DATETIME2,
    @@error_message NVARCHAR(MAX), @@trigger_type NVARCHAR(16)
AS
BEGIN
    -- 寫到監控表 + 觸發外部 email/SMS / Slack 通知
    INSERT INTO dbo.EtlFailureAlerts (TaskName, RunId, ErrorMessage, AtUtc)
    VALUES (@@task_name, @@run_id, @@error_message, SYSUTCDATETIME());

    -- 若有 SQL Mail 設定，可呼叫 sp_send_dbmail
END</code></pre>

                    <div class="alert alert-warning small mb-0 py-2">
                        <strong>⚠ 注意事項</strong>
                        <ul class="mb-0">
                            <li><strong>Schema-qualified 必填</strong>：用 <code>dbo.OnEtlSucceeded</code> 不要只寫 <code>OnEtlSucceeded</code>，避免依賴呼叫者的預設 schema</li>
                            <li><strong>權限</strong>：執行 ETL 的 DB 帳號必須有此 SP 的 <code>EXECUTE</code> 權限</li>
                            <li><strong>SP 失敗不會 rollback ETL</strong>：主 transaction 已 commit，SP 是另起一個 connection 呼叫；你的 SP 要自己 commit / handle exception</li>
                            <li><strong>SP 跑超過 30 秒</strong>：Connector 預設 CommandTimeout = 30 秒；長時間處理請改用 SP 內 enqueue 給 AQ / Service Broker / Kafka 異步處理</li>
                            <li><strong>Failed 的 ETL 寫入了多少</strong>：<code>rows_written</code> 通常是 <code>0</code>（因為 ETL 失敗 = 整個 transaction rollback）；參考 <code>error_message</code> 看失敗原因</li>
                            <li><strong>不要在 SP 內動目標 ETL 表</strong>：那張表剛被 ETL 寫滿，可能還有 lock 殘留；改寫 metadata / audit / queue 表</li>
                        </ul>
                    </div>
                </div>
            </details>
        </div>
    </div>

    @if (_validationErrors.Count > 0)
    {
        <div class="alert alert-warning">
            <strong>請修正以下問題：</strong>
            <ul class="mb-0">
                @foreach (var err in _validationErrors)
                {
                    <li>@err</li>
                }
            </ul>
        </div>
    }

    @if (_message is not null)
    {
        <div class="alert @(_isError ? "alert-danger" : "alert-success")">@_message</div>
    }

    <div class="d-flex gap-2">
        <button class="btn btn-primary" @onclick="Save">儲存</button>
        @if (Id is not null)
        {
            <button class="btn btn-success" @onclick="SaveAndRun" disabled="@_saveAndRunBusy"
                    title="儲存設定後立即手動觸發一次（不必再回 Tasks list 按 ▶）">
                @if (_saveAndRunBusy) { <Icon Name="loader" /> <span>處理中…</span> }
                else { <span>💾▶ 儲存並立即執行</span> }
            </button>
        }
        <button class="btn btn-outline-info" @onclick="DryRun" disabled="@_dryRunBusy">
            @(_dryRunBusy ? "預覽中…" : "👀 預覽前 5 筆")
        </button>
        <a class="btn btn-link" href="tasks">取消</a>
    </div>

    @if (_dryRunModal)
    {
        <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5)">
            <div class="modal-dialog modal-xl modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">來源資料預覽（最多 5 筆）</h5>
                        <button type="button" class="btn-close" @onclick="() => _dryRunModal = false"></button>
                    </div>
                    <div class="modal-body">
                        @if (_dryRunError is not null)
                        {
                            <div class="alert alert-danger">
                                <strong>查詢失敗：</strong>
                                <pre class="mb-0">@_dryRunError</pre>
                            </div>
                        }
                        else if (_dryRunRows is null)
                        {
                            <p>查詢中…</p>
                        }
                        else if (_dryRunRows.Count == 0)
                        {
                            <p class="text-muted">無資料 — 篩選條件下沒有符合的列。</p>
                        }
                        else
                        {
                            <p class="text-muted small">這是 raw 來源資料（未套用映射轉換）。共顯示 @_dryRunRows.Count 筆。</p>
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered">
                                    <thead>
                                        <tr>
                                            @foreach (var k in _dryRunRows[0].Keys) { <th>@k</th> }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in _dryRunRows)
                                        {
                                            <tr>
                                                @foreach (var v in row.Values) { <td>@FormatCell(v)</td> }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="() => _dryRunModal = false">關閉</button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public Guid? Id { get; set; }

    private EtlTool.Core.Models.EtlTask? _task;
    private List<EtlTool.Core.Models.ConnectionDefinition>? _connections;

    private List<string> _sourceSchemas = new();
    private List<string> _sourceTables = new();
    private List<EtlTool.Core.Models.ColumnInfo> _sourceColumns = new();

    private List<string> _targetSchemas = new();
    private List<string> _targetTables = new();
    private List<EtlTool.Core.Models.ColumnInfo> _targetColumns = new();

    private string? _message;
    private bool _isError;
    private bool _refreshingSource;
    private bool _refreshingTarget;

    // Source preview state — 顯示前 10 筆 source data 給 admin 在存檔前 sanity check
    private bool _previewBusy;

    // File-source UI state — bound to _fileConfig；序列化進 _task.FileSourceConfigJson
    private EtlTool.Core.Models.FileSourceConfig _fileConfig = new();

    private void OnSourceKindChanged(EtlTool.Core.Models.SourceKind kind)
    {
        _task.SourceKind = kind;
        if (kind == EtlTool.Core.Models.SourceKind.File)
        {
            // 切到檔案模式時，若還沒有 config JSON 就用預設 config 帶入
            UpdateFileConfigJson();
        }
        else
        {
            // 切回 DB 模式：保留 FileSourceConfigJson 在 _task 內，使用者切回去資料還在
        }
    }

    private void UpdateFileConfigJson()
    {
        _task.FileSourceConfigJson = System.Text.Json.JsonSerializer.Serialize(_fileConfig);
    }

    // ── Fixed-width layout editor state ────────────────────────────────
    private List<EtlTool.Core.Models.FixedWidthColumn> _fwColumns = new();

    private void AddFixedWidthColumn()
    {
        // 預設下一欄起點 = 上一欄的 Start + Length
        var nextStart = _fwColumns.Count == 0
            ? 1
            : _fwColumns[^1].Start + _fwColumns[^1].Length;
        _fwColumns.Add(new EtlTool.Core.Models.FixedWidthColumn
        {
            Name = "",
            Start = nextStart,
            Length = 1,
            TrimWhitespace = true,
        });
        UpdateFwLayoutJson();
    }

    private void RemoveFixedWidthColumn(int index)
    {
        if (index < 0 || index >= _fwColumns.Count) return;
        _fwColumns.RemoveAt(index);
        UpdateFwLayoutJson();
    }

    private void UpdateFwLayoutJson()
    {
        _fileConfig.FixedWidthLayoutJson = System.Text.Json.JsonSerializer.Serialize(_fwColumns);
        UpdateFileConfigJson();
    }

    // ── File row filter syntax validation ──────────────────────────────
    // 即時把 textarea 內容餵給 DynamicExpresso 編譯，UI 上以 ✓/✗ badge 顯示
    private string? _filterCompileError;

    private void ValidateFilterSyntax()
    {
        if (string.IsNullOrWhiteSpace(_task.FileRowFilterExpression))
        {
            _filterCompileError = null;
            return;
        }
        try
        {
            var interp = new DynamicExpresso.Interpreter();
            // 嘗試 parse 但不執行 — 純語法檢查
            interp.Parse(_task.FileRowFilterExpression!,
                new DynamicExpresso.Parameter("row", typeof(System.Data.IDataRecord)));
            _filterCompileError = null;
        }
        catch (Exception ex)
        {
            _filterCompileError = ex.Message;
        }
    }

    // ── CSV header auto-suggest state ──────────────────────────────────
    private bool _headerScanBusy;
    private string? _headerScanError;
    private string? _headerScanFileName;
    private List<EtlTool.Core.Engine.CsvHeaderMatcher.Suggestion>? _headerSuggestions;

    private async Task ScanHeaderAndSuggest()
    {
        _headerScanBusy = true;
        _headerScanError = null;
        _headerSuggestions = null;
        StateHasChanged();
        try
        {
            await Task.Yield();  // 讓 UI 顯示「掃描中」
            // 找一個符合 glob 的檔
            var matches = EtlTool.Core.Engine.FileSourceScanner.Scan(new EtlTool.Core.Models.FileSourceConfig
            {
                DirectoryPath = _fileConfig.DirectoryPath,
                GlobPattern = _fileConfig.GlobPattern,
                MaxFilesPerRun = 1,
                ArchiveDirectory = _fileConfig.ArchiveDirectory,
            });
            if (matches.Count == 0)
            {
                _headerScanError = $"目錄 {_fileConfig.DirectoryPath} 內沒有符合 glob「{_fileConfig.GlobPattern}」的檔。";
                return;
            }
            var first = matches[0];
            _headerScanFileName = first.FileName;

            // 開檔讀 header
            var reader = EtlTool.Core.Engine.FileSourceReaderFactory.Create(_fileConfig.Format);
            var openResult = await reader.OpenAsync(first.FullPath, _fileConfig, CancellationToken.None);
            using var dr = openResult.Reader;
            var actualHeaders = openResult.ColumnNames;

            // 比對現有 mappings 的 SourceColumn
            var expected = _task.Mappings.Select(m => m.SourceColumn).Where(s => !string.IsNullOrEmpty(s)).ToList();
            _headerSuggestions = EtlTool.Core.Engine.CsvHeaderMatcher.FindMatches(expected, actualHeaders);
        }
        catch (Exception ex)
        {
            _headerScanError = $"掃描失敗：{ex.Message}";
        }
        finally
        {
            _headerScanBusy = false;
        }
    }

    private void ApplySuggestion(EtlTool.Core.Engine.CsvHeaderMatcher.Suggestion s)
    {
        if (s.Suggested is null || s.Suggested == s.Original) return;
        foreach (var m in _task.Mappings)
        {
            if (m.SourceColumn == s.Original)
            {
                m.SourceColumn = s.Suggested;
            }
        }
        // 從 list 移除已套用的（避免重複）
        _headerSuggestions = _headerSuggestions?.Where(x => x.Original != s.Original).ToList();
    }

    private void ApplyAllSuggestions()
    {
        if (_headerSuggestions is null) return;
        foreach (var s in _headerSuggestions
            .Where(x => x.Suggested is not null && x.Suggested != x.Original
                && x.Strategy != EtlTool.Core.Engine.CsvHeaderMatcher.MatchStrategy.None)
            .ToList())
        {
            ApplySuggestion(s);
        }
        _headerSuggestions = null;
    }

    private EtlTool.App.Services.SourcePreviewService.PreviewResult? _previewResult;

    private async Task RunSourcePreview()
    {
        _previewBusy = true;
        _previewResult = null;
        StateHasChanged();
        try
        {
            _previewResult = await SourcePreview.PreviewAsync(_task, rowLimit: 10, CancellationToken.None);
        }
        catch (Exception ex)
        {
            // 防呆：service 內已 catch；這裡只是 last-resort
            _previewResult = new EtlTool.App.Services.SourcePreviewService.PreviewResult(
                Ok: false, Sql: null,
                Columns: Array.Empty<string>(),
                Rows: Array.Empty<Dictionary<string, object?>>(),
                MaskedColumns: Array.Empty<string>(),
                ElapsedMs: 0, Error: $"預覽呼叫意外失敗：{ex.Message}");
        }
        finally
        {
            _previewBusy = false;
        }
    }

    /// <summary>截斷 + ToString 預覽資料，避免 BLOB / 超長字串撐爆表格。</summary>
    private static string FormatPreviewValue(object value)
    {
        var s = value switch
        {
            byte[] bs => $"<{bs.Length} bytes>",
            DateTime dt => dt.ToString("yyyy-MM-dd HH:mm:ss"),
            _ => value.ToString() ?? "",
        };
        if (s.Length > 80) s = s[..77] + "…";
        return s;
    }

    private List<string> _validationErrors = new();

    private bool _dryRunBusy;
    private bool _dryRunModal;
    private bool _saveAndRunBusy;
    private bool _suppressNavigateAfterSave;

    private async Task SaveAndRun()
    {
        if (_task is null || Id is null) return;
        _saveAndRunBusy = true;
        _suppressNavigateAfterSave = true;
        try
        {
            // Save() 內部用 _suppressNavigateAfterSave 跳過 NavigateTo，留在原頁
            await Save();
            // 若驗證失敗 / PII 攔截 / 弱密碼 modal → _validationErrors 或 _showPiiSuggest 會被設
            if (_validationErrors.Count > 0 || _showPiiSuggest) return;
            try
            {
                await Scheduler.TriggerNowAsync(Id.Value, CancellationToken.None);
                _isError = false;
                _message = "已儲存並觸發手動執行；可至『執行歷史』查看結果。";
            }
            catch (Exception ex)
            {
                _isError = true;
                _message = $"儲存成功但觸發失敗：{ex.Message}";
            }
        }
        finally
        {
            _saveAndRunBusy = false;
            _suppressNavigateAfterSave = false;
        }
    }
    private List<Dictionary<string, object?>>? _dryRunRows;
    private string? _dryRunError;

    private string? _currentUsername;
    private List<EtlTool.Core.Models.EtlTask>? _allTasks;
    private HashSet<Guid> _selectedDependsOn = new();
    private List<EtlTool.Core.Models.EtlTask> _downstreamTasks = new();
    private List<string> _knownTags = new();

    private void ToggleDependency(Guid parentId, bool include)
    {
        if (_task is null) return;
        if (include) _selectedDependsOn.Add(parentId);
        else _selectedDependsOn.Remove(parentId);
        _task.DependsOnTaskIds = string.Join(",", _selectedDependsOn);
    }

    // PII mask 建議流程
    private bool _showPiiSuggest;
    private bool _piiCheckPassed;
    private List<string> _piiSuggestColumns = new();

    // Webhook payload preview
    private bool _showWebhookPreview;
    private string _previewVariant = "fail";
    private string? _webhookPreviewJson;
    private string _webhookFormat = "generic";

    private void ShowWebhookPreview()
    {
        _webhookFormat = Config["Webhooks:Format"] ?? "generic";
        _previewVariant = "fail";
        BuildPreview();
        _showWebhookPreview = true;
    }

    private void SetPreviewVariant(string variant)
    {
        _previewVariant = variant;
        BuildPreview();
    }

    private void SetPreviewVariantFail() => SetPreviewVariant("fail");
    private void SetPreviewVariantStreak() => SetPreviewVariant("streak");
    private void SetPreviewVariantRecovery() => SetPreviewVariant("recovery");
    private void SetPreviewVariantSuccess() => SetPreviewVariant("success");

    private void BuildPreview()
    {
        if (_task is null) return;

        var format = EtlTool.App.Services.WebhookPayloadBuilder.ParseFormat(_webhookFormat);
        var (fakeRun, error) = _previewVariant switch
        {
            "streak" => MakePreviewRun(EtlTool.Core.Models.RunStatus.Failed, "[STREAK 3/3] connection refused: timed out"),
            "recovery" => MakePreviewRun(EtlTool.Core.Models.RunStatus.Success, "[RECOVERY after 3 consecutive failures]"),
            "success" => MakePreviewRun(EtlTool.Core.Models.RunStatus.Success, null),
            _ => MakePreviewRun(EtlTool.Core.Models.RunStatus.Failed, "connection refused: timed out"),
        };

        var payload = EtlTool.App.Services.WebhookPayloadBuilder.BuildPayload(format, _task, fakeRun, error);
        _webhookPreviewJson = System.Text.Json.JsonSerializer.Serialize(payload,
            new System.Text.Json.JsonSerializerOptions
            {
                WriteIndented = true,
                Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
            });
    }

    private (EtlTool.Core.Models.RunHistory run, string? error) MakePreviewRun(
        EtlTool.Core.Models.RunStatus status, string? error)
    {
        var run = new EtlTool.Core.Models.RunHistory
        {
            Id = Guid.NewGuid(),
            EtlTaskId = _task!.Id,
            Status = status,
            StartedAt = DateTime.UtcNow.AddMinutes(-2),
            FinishedAt = DateTime.UtcNow,
            RowsRead = status == EtlTool.Core.Models.RunStatus.Failed ? 100 : 1234,
            RowsWritten = status == EtlTool.Core.Models.RunStatus.Failed ? 0 : 1234,
            TriggerType = EtlTool.Core.Models.TriggerType.Scheduled,
            ErrorMessage = error,
        };
        return (run, error);
    }

    private async Task EnableMaskAndSave()
    {
        if (_task is null) return;
        _task.MaskSamplePayload = true;
        _showPiiSuggest = false;
        _piiCheckPassed = true;
        await Save();
    }

    private async Task SaveWithoutMask()
    {
        _showPiiSuggest = false;
        _piiCheckPassed = true;  // 已 acknowledge，不再 prompt
        await Save();
    }

    private void ClearSchemaSnapshot()
    {
        if (_task is null) return;
        _task.SourceSchemaSnapshotJson = null;
        _task.TargetSchemaSnapshotJson = null;
        _task.SchemaSnapshotAt = null;
        _message = "已清除 schema 快照（按「儲存」生效；下次執行時自動重建）。";
        _isError = false;
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        var ct = CancellationToken.None;
        var state = await AuthState.GetAuthenticationStateAsync();
        _currentUsername = state.User.Identity?.Name;
        _connections = await ConnRepo.ListAsync(ct);
        _allTasks = await TaskRepo.ListLightweightAsync(ct);
        // Collect distinct tags from all tasks for autocomplete
        _knownTags = _allTasks
            .Where(t => !string.IsNullOrEmpty(t.Tags))
            .SelectMany(t => t.Tags!.Split(',', StringSplitOptions.RemoveEmptyEntries))
            .Select(s => s.Trim())
            .Where(s => s.Length > 0)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(s => s)
            .ToList();
        if (Id is null)
        {
            _task = new EtlTool.Core.Models.EtlTask();
        }
        else
        {
            var existing = await TaskRepo.GetWithMappingsAsync(Id.Value, ct);
            if (existing is null) { Nav.NavigateTo("tasks"); return; }
            _task = existing;
            // Hydrate _selectedDependsOn from stored CSV
            _selectedDependsOn = EtlTool.Core.Engine.TaskDependencyChecker
                .ParseDependsOnIds(_task.DependsOnTaskIds).ToHashSet();
            // 反向找：哪些 task 把我列為 parent
            _downstreamTasks = (_allTasks ?? new())
                .Where(t => t.Id != _task.Id
                    && EtlTool.Core.Engine.TaskDependencyChecker
                        .ParseDependsOnIds(t.DependsOnTaskIds).Contains(_task.Id))
                .ToList();
            await ReloadSourceMetadata();
            await ReloadTargetMetadata();
        }

        // 還原 file source config（檔案模式時用；DB 模式時 JSON 為空但不影響）
        if (!string.IsNullOrEmpty(_task.FileSourceConfigJson))
        {
            try
            {
                _fileConfig = System.Text.Json.JsonSerializer
                    .Deserialize<EtlTool.Core.Models.FileSourceConfig>(_task.FileSourceConfigJson)
                    ?? new EtlTool.Core.Models.FileSourceConfig();
            }
            catch
            {
                _fileConfig = new EtlTool.Core.Models.FileSourceConfig();
            }
        }
        // 還原 fixed-width layout
        if (!string.IsNullOrEmpty(_fileConfig.FixedWidthLayoutJson))
        {
            try
            {
                _fwColumns = System.Text.Json.JsonSerializer
                    .Deserialize<List<EtlTool.Core.Models.FixedWidthColumn>>(_fileConfig.FixedWidthLayoutJson)
                    ?? new List<EtlTool.Core.Models.FixedWidthColumn>();
            }
            catch
            {
                _fwColumns = new();
            }
        }

        // 載入時跑一次語法檢查，使用者一打開就看得到狀態
        ValidateFilterSyntax();
    }

    private async Task OnSourceConnectionChanged(ChangeEventArgs e)
    {
        if (_task is null) return;
        _task.SourceConnectionId = ParseGuid(e.Value);
        _task.SourceSchema = "";
        _task.SourceTable = "";
        await ReloadSourceMetadata();
    }

    private async Task OnSourceSchemaChanged(ChangeEventArgs e)
    {
        if (_task is null) return;
        _task.SourceSchema = e.Value as string ?? "";
        _task.SourceTable = "";
        _sourceTables.Clear();
        _sourceColumns.Clear();
        await LoadTablesAsync(_task.SourceConnectionId, _task.SourceSchema, _sourceTables);
    }

    private async Task OnSourceTableChanged(ChangeEventArgs e)
    {
        if (_task is null) return;
        _task.SourceTable = e.Value as string ?? "";
        _sourceColumns = new List<EtlTool.Core.Models.ColumnInfo>();
        if (!string.IsNullOrEmpty(_task.SourceTable))
        {
            _sourceColumns = (await LoadColumnsAsync(_task.SourceConnectionId, _task.SourceSchema, _task.SourceTable)).ToList();
        }
    }

    private async Task OnTargetConnectionChanged(ChangeEventArgs e)
    {
        if (_task is null) return;
        _task.TargetConnectionId = ParseGuid(e.Value);
        _task.TargetSchema = "";
        _task.TargetTable = "";
        await ReloadTargetMetadata();
    }

    private async Task OnTargetSchemaChanged(ChangeEventArgs e)
    {
        if (_task is null) return;
        _task.TargetSchema = e.Value as string ?? "";
        _task.TargetTable = "";
        _targetTables.Clear();
        _targetColumns.Clear();
        await LoadTablesAsync(_task.TargetConnectionId, _task.TargetSchema, _targetTables);
    }

    private async Task OnTargetTableChanged(ChangeEventArgs e)
    {
        if (_task is null) return;
        _task.TargetTable = e.Value as string ?? "";
        _targetColumns = new List<EtlTool.Core.Models.ColumnInfo>();
        if (!string.IsNullOrEmpty(_task.TargetTable))
        {
            _targetColumns = (await LoadColumnsAsync(_task.TargetConnectionId, _task.TargetSchema, _task.TargetTable)).ToList();
        }
    }

    private async Task ReloadSourceMetadata()
    {
        if (_task is null || _task.SourceConnectionId == Guid.Empty) return;
        _sourceSchemas = (await LoadSchemasAsync(_task.SourceConnectionId)).ToList();
        if (!string.IsNullOrEmpty(_task.SourceSchema))
            await LoadTablesAsync(_task.SourceConnectionId, _task.SourceSchema, _sourceTables);
        if (!string.IsNullOrEmpty(_task.SourceTable))
            _sourceColumns = (await LoadColumnsAsync(_task.SourceConnectionId, _task.SourceSchema, _task.SourceTable)).ToList();
    }

    private async Task RefreshSourceMetadata()
    {
        _refreshingSource = true;
        StateHasChanged();
        try { await ReloadSourceMetadata(); }
        finally { _refreshingSource = false; }
    }

    private async Task RefreshTargetMetadata()
    {
        _refreshingTarget = true;
        StateHasChanged();
        try { await ReloadTargetMetadata(); }
        finally { _refreshingTarget = false; }
    }

    private async Task ReloadTargetMetadata()
    {
        if (_task is null || _task.TargetConnectionId == Guid.Empty) return;
        _targetSchemas = (await LoadSchemasAsync(_task.TargetConnectionId)).ToList();
        if (!string.IsNullOrEmpty(_task.TargetSchema))
            await LoadTablesAsync(_task.TargetConnectionId, _task.TargetSchema, _targetTables);
        if (!string.IsNullOrEmpty(_task.TargetTable))
            _targetColumns = (await LoadColumnsAsync(_task.TargetConnectionId, _task.TargetSchema, _task.TargetTable)).ToList();
    }

    private async Task<IReadOnlyList<string>> LoadSchemasAsync(Guid connId)
    {
        try
        {
            var def = await ConnRepo.GetAsync(connId, CancellationToken.None);
            if (def is null) return Array.Empty<string>();
            var connector = ConnectorFactory.Create(def);
            return await connector.ListSchemasAsync(CancellationToken.None);
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = $"讀取 schema 失敗：{ex.Message}";
            return Array.Empty<string>();
        }
    }

    private async Task LoadTablesAsync(Guid connId, string schema, List<string> target)
    {
        target.Clear();
        if (connId == Guid.Empty || string.IsNullOrEmpty(schema)) return;
        try
        {
            var def = await ConnRepo.GetAsync(connId, CancellationToken.None);
            if (def is null) return;
            var connector = ConnectorFactory.Create(def);
            target.AddRange(await connector.ListTablesAsync(schema, CancellationToken.None));
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = $"讀取 table 失敗：{ex.Message}";
        }
    }

    private async Task<IReadOnlyList<EtlTool.Core.Models.ColumnInfo>> LoadColumnsAsync(Guid connId, string schema, string table)
    {
        try
        {
            var def = await ConnRepo.GetAsync(connId, CancellationToken.None);
            if (def is null) return Array.Empty<EtlTool.Core.Models.ColumnInfo>();
            var connector = ConnectorFactory.Create(def);
            return await connector.ListColumnsAsync(schema, table, CancellationToken.None);
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = $"讀取 columns 失敗：{ex.Message}";
            return Array.Empty<EtlTool.Core.Models.ColumnInfo>();
        }
    }

    private async Task Save()
    {
        if (_task is null) return;
        _validationErrors = EtlTool.Core.Engine.EtlTaskValidator.Validate(_task);
        if (_validationErrors.Count > 0)
        {
            _message = null;
            return;
        }

        // 循環依賴檢查：避免 admin 不小心把 A → B → A 設成循環導致排程永遠等下去
        if (_selectedDependsOn.Count > 0 && _allTasks is not null)
        {
            var allDeps = _allTasks
                .Where(t => t.Id != _task.Id)  // 不要包含自己舊版本
                .ToDictionary(
                    t => t.Id,
                    t => (IReadOnlyList<Guid>)EtlTool.Core.Engine.TaskDependencyChecker
                        .ParseDependsOnIds(t.DependsOnTaskIds).ToList());
            var cycle = EtlTool.Core.Engine.TaskDependencyChecker.DetectCycle(
                _task.Id, _selectedDependsOn.ToList(), allDeps);
            if (cycle.HasCycle)
            {
                _validationErrors = new() { cycle.Reason ?? "依賴設定形成循環" };
                _message = null;
                return;
            }
        }

        // PII + MaskSamplePayload 建議：偵測映射欄位是否含 PII，若有且 mask 未開
        // → 顯示 modal 詢問是否啟用。Admin 確認過後，無論選哪個都繼續儲存。
        if (!_piiCheckPassed && !_task.MaskSamplePayload && _task.Mappings.Count > 0)
        {
            var piiCols = _task.Mappings
                .Where(m => !string.IsNullOrEmpty(m.SourceColumn))
                .Select(m => (col: m.SourceColumn,
                              det: EtlTool.Core.Engine.PiiDetector.Inspect(m.SourceColumn)))
                .Where(x => x.det.Kind != EtlTool.Core.Engine.PiiDetector.PiiKind.None)
                .ToList();
            if (piiCols.Count > 0)
            {
                _piiSuggestColumns = piiCols.Select(x =>
                    $"{x.col} ({EtlTool.Core.Engine.PiiDetector.KindLabel(x.det.Kind)})").ToList();
                _showPiiSuggest = true;
                return;  // 等 modal 決定
            }
        }

        // 捕捉 schema 快照（用使用者選表時已載入的欄位資訊）
        if (_sourceColumns.Count > 0)
            _task.SourceSchemaSnapshotJson = System.Text.Json.JsonSerializer.Serialize(_sourceColumns);
        if (_targetColumns.Count > 0)
            _task.TargetSchemaSnapshotJson = System.Text.Json.JsonSerializer.Serialize(_targetColumns);
        if (_sourceColumns.Count > 0 || _targetColumns.Count > 0)
            _task.SchemaSnapshotAt = DateTime.UtcNow;

        try
        {
            EtlTool.Core.Models.EtlTask saved;
            if (Id is null)
            {
                saved = await TaskRepo.CreateAsync(_task, CancellationToken.None, actor: _currentUsername);
            }
            else
            {
                saved = await TaskRepo.UpdateAsync(_task, CancellationToken.None, actor: _currentUsername);
            }
            await Scheduler.RescheduleAsync(saved.Id, CancellationToken.None);
            if (!_suppressNavigateAfterSave)
                Nav.NavigateTo("tasks");
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = $"儲存失敗：{ex.Message}";
        }
    }

    private async Task DryRun()
    {
        if (_task is null) return;
        // 依 SourceKind 分流檢查必填欄位
        var basicErrors = new List<string>();
        if (_task.SourceKind == EtlTool.Core.Models.SourceKind.Database)
        {
            if (_task.SourceConnectionId == Guid.Empty) basicErrors.Add("請先選擇來源連線");
            if (string.IsNullOrEmpty(_task.SourceSchema)) basicErrors.Add("請先選擇來源 Schema");
            if (string.IsNullOrEmpty(_task.SourceTable)) basicErrors.Add("請先選擇來源 Table");
        }
        else  // File
        {
            if (string.IsNullOrEmpty(_fileConfig.DirectoryPath)) basicErrors.Add("請先填寫來源目錄");
            if (string.IsNullOrEmpty(_fileConfig.GlobPattern)) basicErrors.Add("請先填寫檔名 glob 樣式");
            if (_task.Mappings.Count == 0) basicErrors.Add("請先至少設定一個欄位映射");
        }
        if (basicErrors.Count > 0)
        {
            _validationErrors = basicErrors;
            return;
        }

        _validationErrors = new();
        _dryRunBusy = true;
        _dryRunRows = null;
        _dryRunError = null;
        _dryRunModal = true;
        StateHasChanged();
        try
        {
            if (_task.SourceKind == EtlTool.Core.Models.SourceKind.File)
            {
                // File 模式走 SourcePreviewService
                var preview = await SourcePreview.PreviewAsync(_task, rowLimit: 5, CancellationToken.None);
                if (!preview.Ok)
                {
                    _dryRunError = preview.Error;
                    _dryRunRows = new();
                }
                else
                {
                    _dryRunRows = preview.Rows
                        .Select(r => r.ToDictionary(kv => kv.Key, kv => kv.Value))
                        .ToList();
                }
            }
            else
            {
                _dryRunRows = await EtlEngine.PreviewSourceAsync(_task, 5, CancellationToken.None);
            }
        }
        catch (Exception ex)
        {
            _dryRunError = ex.ToString();
        }
        finally
        {
            _dryRunBusy = false;
        }
    }

    private static string FormatCell(object? v)
    {
        if (v is null) return "(null)";
        if (v is DateTime dt) return dt.ToString("yyyy-MM-dd HH:mm:ss");
        return v.ToString() ?? "";
    }


    private static Guid ParseGuid(object? value)
        => Guid.TryParse(value as string, out var g) ? g : Guid.Empty;

    private static string ComputeRetryDelays(EtlTool.Core.Models.EtlTask t)
    {
        if (t.MaxRetries <= 0) return "—";
        var delays = new List<string>();
        double d = t.RetryDelaySeconds;
        for (int i = 0; i < t.MaxRetries && i < 5; i++)
        {
            delays.Add(FormatSeconds(d));
            d *= t.RetryBackoffMultiplier;
        }
        if (t.MaxRetries > 5) delays.Add("…");
        return string.Join(" → ", delays);
    }

    private static string FormatSeconds(double s)
    {
        if (s < 60) return $"{s:0}s";
        if (s < 3600) return $"{s / 60:0.#}m";
        return $"{s / 3600:0.#}h";
    }

    private static int SnapshotColumnCount(string? json)
    {
        if (string.IsNullOrEmpty(json)) return 0;
        try
        {
            var arr = System.Text.Json.JsonSerializer.Deserialize<List<EtlTool.Core.Models.ColumnInfo>>(json);
            return arr?.Count ?? 0;
        }
        catch { return 0; }
    }
