@page "/tasks/new"
@page "/tasks/{Id:guid}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Operator")]
@inject EtlTool.Data.Repositories.EtlTaskRepository TaskRepo
@inject EtlTool.Data.Repositories.ConnectionRepository ConnRepo
@inject EtlTool.Core.Connectors.IDbConnectorFactory ConnectorFactory
@inject EtlTool.Core.Scheduling.SchedulerService Scheduler
@inject EtlTool.Core.Engine.EtlEngine EtlEngine
@inject EtlTool.App.Services.SourcePreviewService SourcePreview
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject IConfiguration Config

<PageTitle>編輯任務</PageTitle>

<div class="d-flex justify-content-between align-items-center">
    <h1 class="m-0">@(Id is null ? "新增任務" : "編輯任務")</h1>
    @if (Id is not null)
    {
        <div class="d-flex gap-2">
            <a class="btn btn-outline-warning btn-sm" href="@($"tasks/{Id}/schema-drift")">
                <Icon Name="alert-triangle" /> Schema 漂移
            </a>
            <button class="btn btn-outline-info btn-sm" @onclick="ShowWebhookPreview">
                <Icon Name="zap" /> 預覽 webhook payload
            </button>
            <a class="btn btn-outline-secondary btn-sm" href="@($"tasks/{Id}/history")">
                <Icon Name="history" /> 變更歷史
            </a>
        </div>
    }
</div>

@if (_showWebhookPreview)
{
    <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">📡 Webhook payload 預覽（不會實際發送）</h5>
                </div>
                <div class="modal-body">
                    <div class="mb-2 small text-muted">
                        以下是當此任務 <strong>失敗</strong> 時實際會 POST 到 webhook 的 JSON。
                        Format 來自 <code>Webhooks:Format</code> 設定（目前 = <code>@_webhookFormat</code>）。
                        Streak / Recovery prefix 由 <code>StreakAwareFailureNotifier</code> 加，這裡呈現「第 N 次連敗達門檻」的範例。
                    </div>
                    <div class="d-flex gap-2 mb-2 flex-wrap">
                        <button class="btn btn-sm @(_previewVariant == "fail" ? "btn-primary" : "btn-outline-secondary")"
                                @onclick="SetPreviewVariantFail">單次失敗</button>
                        <button class="btn btn-sm @(_previewVariant == "streak" ? "btn-primary" : "btn-outline-secondary")"
                                @onclick="SetPreviewVariantStreak">[STREAK] 達門檻</button>
                        <button class="btn btn-sm @(_previewVariant == "recovery" ? "btn-primary" : "btn-outline-secondary")"
                                @onclick="SetPreviewVariantRecovery">[RECOVERY] 恢復</button>
                        <button class="btn btn-sm @(_previewVariant == "success" ? "btn-primary" : "btn-outline-secondary")"
                                @onclick="SetPreviewVariantSuccess">單次成功 (一般執行不送)</button>
                    </div>
                    <pre class="bg-light p-2 mb-0" style="max-height: 480px; overflow: auto; font-size: 0.8rem">@_webhookPreviewJson</pre>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _showWebhookPreview = false">關閉</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showPiiSuggest)
{
    <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title">🔒 偵測到可能 PII 欄位 — 是否同時啟用 Mask？</h5>
                </div>
                <div class="modal-body">
                    <p>以下來源欄位疑似含 PII（個人識別資料）：</p>
                    <ul class="small">
                        @foreach (var c in _piiSuggestColumns)
                        {
                            <li><code>@c</code></li>
                        }
                    </ul>
                    <p>
                        若不啟用 <strong>MaskSamplePayload</strong>，每次執行的前 5 筆 sample 會以
                        <em>原始值</em> 寫入 RunHistory，admin 在 /runs 詳情頁就能看到實際資料。
                    </p>
                    <p class="small text-muted">
                        建議啟用：sample 仍會寫入但 PII 欄位會被 ***（保留原 schema 與筆數可供 debug）。
                    </p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" @onclick="() => _showPiiSuggest = false">取消儲存</button>
                    <button class="btn btn-link" @onclick="SaveWithoutMask">不啟用，仍要儲存</button>
                    <button class="btn btn-warning" @onclick="EnableMaskAndSave">啟用 mask 並儲存</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_task is null || _connections is null)
{
    <p>載入中...</p>
}
else
{
    <div class="card mb-3">
        <div class="card-header">基本資料</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">任務名稱</label>
                    <input class="form-control" @bind="_task.Name" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">啟用</label>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" @bind="_task.Enabled" />
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label">批次大小</label>
                    <input class="form-control" type="number" min="1" max="100000" @bind="_task.BatchSize" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">執行歷史保留筆數
                        <small class="text-muted" title="留空 = 套用全域設定 RunHistory:KeepLastPerTask">(覆寫)</small>
                    </label>
                    <input class="form-control" type="number" min="1" max="10000"
                           placeholder="(留空=用全域設定)" @bind="_task.RunHistoryRetentionRuns" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">預期最長執行時間 (分)
                        <small class="text-muted" title="超過時 watchdog 發 Warning audit；不會中斷任務">(覆寫)</small>
                    </label>
                    <input class="form-control" type="number" min="1" max="1440"
                           placeholder="(留空=用全域 30)" @bind="_task.MaxRunMinutes" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">連續失敗自動停用
                        <small class="text-muted" title="連續失敗 N 次自動 Disable 此任務；admin 修復後手動再啟用">(circuit-breaker)</small>
                    </label>
                    <input class="form-control" type="number" min="1" max="100"
                           placeholder="(留空=用全域 / 0)" @bind="_task.AutoDisableAfterFailures" />
                </div>
                <div class="col-12">
                    <label class="form-label">標籤 (Tags)
                        <small class="text-muted">逗號分隔；用於 Tasks list 過濾與分類。例：team-finance, daily, critical</small>
                    </label>
                    <input class="form-control" maxlength="200" list="task-tags-existing" placeholder="例：finance, daily, critical" @bind="_task.Tags" />
                    <datalist id="task-tags-existing">
                        @foreach (var tag in _knownTags)
                        {
                            <option value="@tag" />
                        }
                    </datalist>
                    @if (!string.IsNullOrWhiteSpace(_task.Tags))
                    {
                        <div class="d-flex flex-wrap gap-1 mt-1">
                            @foreach (var tag in (_task.Tags ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries).Select(s => s.Trim()).Where(s => s.Length > 0))
                            {
                                <span class="badge bg-secondary">@tag</span>
                            }
                        </div>
                    }
                    @if (_knownTags.Count > 0)
                    {
                        <small class="text-muted d-block mt-1">既有 tags（點擊 input 下拉建議）：@string.Join(", ", _knownTags.Take(15))@(_knownTags.Count > 15 ? $" …+{_knownTags.Count - 15}" : "")</small>
                    }
                </div>
                <div class="col-12">
                    <label class="form-label">Ops 交接備註
                        <small class="text-muted">業主、on-call、特殊維護程序、相依關係…</small>
                    </label>
                    <textarea class="form-control" rows="2" maxlength="2000" placeholder="例：業主 alice@bank；on-call bob@bank；02-04 維護需先停 task" @bind="_task.Notes"></textarea>
                </div>
                <div class="col-md-3">
                    <label class="form-label">依賴 Lookback (小時)
                        <small class="text-muted" title="parent 必須在過去 N 小時內有 Success；留空 = 24h">(覆寫)</small>
                    </label>
                    <input class="form-control" type="number" min="1" max="720"
                           placeholder="(留空=24h)" @bind="_task.DependencyLookbackHours" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Idempotent
                        <small class="text-muted">parent 跑完後只跑一次</small>
                    </label>
                    <div class="form-check form-switch">
                        <input type="checkbox" class="form-check-input"
                               @bind="_task.RunOncePerParentSuccess" />
                        <label class="form-check-label small text-muted">啟用後：若本任務已晚於所有 parent 成功過，下次 cron tick 會跳過</label>
                    </div>
                </div>
                <div class="col-12">
                    <label class="form-label">上游任務依賴 (DependsOn)
                        <small class="text-muted">需排程觸發前確認以下任務「過去 lookback 內成功」；手動觸發 / 重試一律不檢查</small>
                    </label>
                    @if (_connections is null || _allTasks is null)
                    {
                        <div class="text-muted small">載入中…</div>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var other in _allTasks.Where(t => t.Id != _task.Id))
                            {
                                var isParent = _selectedDependsOn.Contains(other.Id);
                                <label class="form-check m-0" style="cursor:pointer">
                                    <input type="checkbox" class="form-check-input me-1"
                                           checked="@isParent"
                                           @onchange="e => ToggleDependency(other.Id, (bool)e.Value!)" />
                                    <span class="form-check-label small">@other.Name</span>
                                </label>
                            }
                        </div>
                        @if (_selectedDependsOn.Count == 0)
                        {
                            <small class="text-muted">無依賴 — 排程觸發時直接執行</small>
                        }
                        else
                        {
                            <small class="text-muted">已選 @_selectedDependsOn.Count 個 parent；scheduler 會等到全部成功後才執行此任務。</small>
                        }
                    }
                </div>
                @if (_downstreamTasks.Count > 0)
                {
                    <div class="col-12">
                        <label class="form-label">下游任務（依賴此任務的）
                            <small class="text-muted">刪除 / 停用此任務前請確認下游影響</small>
                        </label>
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var d in _downstreamTasks)
                            {
                                <a href="@($"tasks/{d.Id}")" class="badge bg-info text-dark text-decoration-none">@d.Name</a>
                            }
                        </div>
                    </div>
                }
            </div>
            @if (Id is not null)
            {
                <div class="mt-3 small text-muted d-flex align-items-center gap-2">
                    @if (_task.SchemaSnapshotAt.HasValue)
                    {
                        <span>
                            Schema 快照於 <code>@_task.SchemaSnapshotAt.Value.ToLocalTime():yyyy-MM-dd HH:mm</code>
                            （drift 偵測會比對此快照與實際 schema）
                        </span>
                    }
                    else
                    {
                        <span>尚未擷取 schema 快照（drift 偵測首次執行時自動建立）。</span>
                    }
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearSchemaSnapshot">
                        <Icon Name="refresh" /> 清除 schema 快照
                    </button>
                </div>
            }
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header">來源 (Source)</div>
                <div class="card-body">
                    <div class="mb-2">
                        <label class="form-label">連線</label>
                        <select class="form-select" @onchange="OnSourceConnectionChanged">
                            <option value="">— 選擇 —</option>
                            @foreach (var c in _connections)
                            {
                                <option value="@c.Id" selected="@(c.Id == _task.SourceConnectionId)">@c.Name (@c.ProviderType)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <label class="form-label m-0">Schema</label>
                            <button type="button" class="icon-btn" title="重新讀取 schema / table 清單"
                                    disabled="@(_refreshingSource || _task.SourceConnectionId == Guid.Empty)"
                                    @onclick="RefreshSourceMetadata">
                                @if (_refreshingSource) { <Icon Name="loader" /> } else { <Icon Name="refresh" /> }
                            </button>
                        </div>
                        <select class="form-select" @onchange="OnSourceSchemaChanged">
                            <option value="">— 選擇 —</option>
                            @foreach (var s in _sourceSchemas)
                            {
                                <option value="@s" selected="@(s == _task.SourceSchema)">@s</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Table</label>
                        <select class="form-select" @onchange="OnSourceTableChanged">
                            <option value="">— 選擇 —</option>
                            @foreach (var t in _sourceTables)
                            {
                                <option value="@t" selected="@(t == _task.SourceTable)">@t</option>
                            }
                        </select>
                    </div>
                    <div class="mt-3 d-flex gap-2 align-items-center">
                        <button type="button" class="btn btn-outline-primary btn-sm"
                                disabled="@(_previewBusy || _task.SourceConnectionId == Guid.Empty || string.IsNullOrEmpty(_task.SourceTable) || _task.Mappings.Count == 0)"
                                @onclick="RunSourcePreview">
                            @if (_previewBusy) { <Icon Name="loader" /> <span>查詢中…</span> }
                            else { <span>👀 預覽前 10 筆來源資料</span> }
                        </button>
                        @if (_task.Mappings.Count == 0)
                        {
                            <span class="small text-muted">需先設好 Mapping 再預覽</span>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header">目標 (Target)</div>
                <div class="card-body">
                    <div class="mb-2">
                        <label class="form-label">連線</label>
                        <select class="form-select" @onchange="OnTargetConnectionChanged">
                            <option value="">— 選擇 —</option>
                            @foreach (var c in _connections)
                            {
                                <option value="@c.Id" selected="@(c.Id == _task.TargetConnectionId)">@c.Name (@c.ProviderType)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <label class="form-label m-0">Schema</label>
                            <button type="button" class="icon-btn" title="重新讀取 schema / table 清單"
                                    disabled="@(_refreshingTarget || _task.TargetConnectionId == Guid.Empty)"
                                    @onclick="RefreshTargetMetadata">
                                @if (_refreshingTarget) { <Icon Name="loader" /> } else { <Icon Name="refresh" /> }
                            </button>
                        </div>
                        <select class="form-select" @onchange="OnTargetSchemaChanged">
                            <option value="">— 選擇 —</option>
                            @foreach (var s in _targetSchemas)
                            {
                                <option value="@s" selected="@(s == _task.TargetSchema)">@s</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Table</label>
                        <select class="form-select" @onchange="OnTargetTableChanged">
                            <option value="">— 選擇 —</option>
                            @foreach (var t in _targetTables)
                            {
                                <option value="@t" selected="@(t == _task.TargetTable)">@t</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (_previewResult is not null)
    {
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>
                    來源資料預覽
                    @if (_previewResult.Ok)
                    {
                        <span class="badge bg-success ms-2">@_previewResult.Rows.Count 筆 / @_previewResult.ElapsedMs ms</span>
                    }
                    else
                    {
                        <span class="badge bg-danger ms-2">失敗</span>
                    }
                    @if (_previewResult.MaskedColumns.Count > 0)
                    {
                        <span class="badge bg-warning text-dark ms-2"
                              title="基於欄位名 PII 啟發式偵測自動遮罩，避免將敏感資料貼到截圖／訊息">
                            🔒 @_previewResult.MaskedColumns.Count 欄已遮罩
                        </span>
                    }
                </span>
                <button type="button" class="btn btn-sm btn-link p-0" @onclick="() => _previewResult = null">關閉</button>
            </div>
            @if (!_previewResult.Ok)
            {
                <div class="card-body alert alert-danger small mb-0">
                    <strong>查詢失敗：</strong> @_previewResult.Error
                    @if (!string.IsNullOrEmpty(_previewResult.Sql))
                    {
                        <details class="mt-2">
                            <summary class="small">送出的 SQL</summary>
                            <pre class="small mb-0 mt-1">@_previewResult.Sql</pre>
                        </details>
                    }
                </div>
            }
            else
            {
                @if (!string.IsNullOrEmpty(_previewResult.Sql))
                {
                    <div class="card-body py-2 small text-muted border-bottom">
                        <details>
                            <summary>送出的 SQL（已套用 filter / TOP 10）</summary>
                            <pre class="small mb-0 mt-1">@_previewResult.Sql</pre>
                        </details>
                    </div>
                }
                @if (_previewResult.MaskedColumns.Count > 0)
                {
                    <div class="card-body py-2 small text-muted border-bottom">
                        自動遮罩欄位（PiiDetector 命中）：
                        @foreach (var c in _previewResult.MaskedColumns)
                        {
                            <code class="me-1">@c</code>
                        }
                    </div>
                }
                @if (_previewResult.Rows.Count == 0)
                {
                    <div class="card-body small text-muted">沒有資料 — 過濾條件可能太嚴或表是空的。</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover small mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="text-muted" style="width: 30px">#</th>
                                    @foreach (var col in _previewResult.Columns)
                                    {
                                        <th>
                                            @col
                                            @if (_previewResult.MaskedColumns.Contains(col))
                                            {
                                                <span class="ms-1 text-warning" title="PII 自動遮罩">🔒</span>
                                            }
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @for (int idx = 0; idx < _previewResult.Rows.Count; idx++)
                                {
                                    var row = _previewResult.Rows[idx];
                                    <tr>
                                        <td class="text-muted small">@(idx + 1)</td>
                                        @foreach (var col in _previewResult.Columns)
                                        {
                                            <td class="small">
                                                @if (row.TryGetValue(col, out var v) && v is not null)
                                                {
                                                    <code class="small">@FormatPreviewValue(v)</code>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small fst-italic">null</span>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>
    }

    <div class="card mb-3">
        <div class="card-header">寫入模式</div>
        <div class="card-body">
            <div class="mb-2">
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="wmode" id="wm-di" checked="@(_task.WriteMode == WriteMode.DeleteInsert)" @onchange="() => _task.WriteMode = WriteMode.DeleteInsert" />
                    <label class="form-check-label" for="wm-di">
                        <strong>Delete-Insert</strong>：依條件刪除目標表的資料，再批次插入。一致性高，適合「整批覆蓋同條件資料」。
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="wmode" id="wm-up" checked="@(_task.WriteMode == WriteMode.Upsert)" @onchange="() => _task.WriteMode = WriteMode.Upsert" />
                    <label class="form-check-label" for="wm-up">
                        <strong>Upsert</strong>：依「主鍵欄位」判斷，存在就更新、不存在就新增（不會刪除目標既有資料）。
                    </label>
                </div>
            </div>

            @if (_task.WriteMode == WriteMode.DeleteInsert)
            {
                <div class="mt-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="del-same" @bind="_task.DeleteWhereSameAsFilter" />
                        <label class="form-check-label" for="del-same">刪除條件＝讀取條件 (常見)</label>
                    </div>
                    @if (!_task.DeleteWhereSameAsFilter)
                    {
                        <div class="mt-2">
                            <label class="form-label">自訂刪除 WHERE 子句</label>
                            <textarea class="form-control font-monospace" rows="2" @bind="_task.DeleteWhereRawSql"></textarea>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">重試政策</div>
        <div class="card-body">
            <p class="text-muted small mb-3">
                執行失敗時自動重試 — 適合處理短暫的網路或 DB 抖動。
                每次嘗試都會留下獨立的執行紀錄（標示為 <code>Retry</code>）。
            </p>
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">最大重試次數</label>
                    <input type="number" class="form-control" min="0" max="10" @bind="_task.MaxRetries" />
                    <small class="text-muted">0 = 不重試</small>
                </div>
                <div class="col-md-3">
                    <label class="form-label">首次延遲 (秒)</label>
                    <input type="number" class="form-control" min="1" max="3600" @bind="_task.RetryDelaySeconds" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">退避倍數</label>
                    <input type="number" step="0.5" class="form-control" min="1.0" max="10.0" @bind="_task.RetryBackoffMultiplier" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">實際延遲</label>
                    <div class="text-muted small font-monospace pt-2">
                        @if (_task.MaxRetries == 0)
                        {
                            <span>—</span>
                        }
                        else
                        {
                            @ComputeRetryDelays(_task)
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">篩選條件 (來源)</div>
        <div class="card-body">
            <FilterBuilder
                Mode="@_task.FilterMode" ModeChanged="@(v => _task.FilterMode = v)"
                FormJson="@_task.FilterFormJson" FormJsonChanged="@(v => _task.FilterFormJson = v)"
                RawSql="@_task.FilterRawSql" RawSqlChanged="@(v => _task.FilterRawSql = v)"
                SourceColumns="@_sourceColumns" />
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">欄位映射</div>
        <div class="card-body">
            <MappingEditor
                Mappings="@_task.Mappings"
                SourceColumns="@_sourceColumns"
                TargetColumns="@_targetColumns"
                ShowKeyColumn="@(_task.WriteMode == WriteMode.Upsert)"
                OnChanged="@StateHasChanged" />
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>排程</span>
            <a href="/scheduler/preview" target="_blank" class="btn btn-sm btn-link p-0"
               title="開新分頁顯示未來 24h 所有任務觸發點 + 自動偵測同表寫入衝突 / 同來源連線壓力">
                ↗ 開排程預覽 (檢查衝突)
            </a>
        </div>
        <div class="card-body">
            <CronEditor Value="@_task.CronExpression" ValueChanged="@(v => _task.CronExpression = v)" />
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">資料量斷言 (Row Count Assertion)</div>
        <div class="card-body">
            <p class="text-muted small mb-2">
                預期讀取的最少 / 最多筆數。違反時依政策處理，可避免「上游空表 silently 寫 0 筆」之類問題。
            </p>
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">最少筆數 (≥)</label>
                    <input type="number" class="form-control" min="0" placeholder="不限"
                           @bind="_task.MinExpectedRows" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">最多筆數 (≤)</label>
                    <input type="number" class="form-control" min="0" placeholder="不限"
                           @bind="_task.MaxExpectedRows" />
                </div>
                <div class="col-md-6">
                    <label class="form-label d-block">違反時</label>
                    <div class="form-check form-check-inline">
                        <input type="radio" class="form-check-input" id="rc-ignore" name="rcpol"
                               checked="@(_task.RowCountPolicy == EtlTool.Core.Engine.RowCountAssertionPolicy.Ignore)"
                               @onchange="() => _task.RowCountPolicy = EtlTool.Core.Engine.RowCountAssertionPolicy.Ignore" />
                        <label class="form-check-label" for="rc-ignore">不檢查</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input type="radio" class="form-check-input" id="rc-warn" name="rcpol"
                               checked="@(_task.RowCountPolicy == EtlTool.Core.Engine.RowCountAssertionPolicy.Warn)"
                               @onchange="() => _task.RowCountPolicy = EtlTool.Core.Engine.RowCountAssertionPolicy.Warn" />
                        <label class="form-check-label" for="rc-warn">仍寫入 + 警告</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input type="radio" class="form-check-input" id="rc-fail" name="rcpol"
                               checked="@(_task.RowCountPolicy == EtlTool.Core.Engine.RowCountAssertionPolicy.Fail)"
                               @onchange="() => _task.RowCountPolicy = EtlTool.Core.Engine.RowCountAssertionPolicy.Fail" />
                        <label class="form-check-label" for="rc-fail">Fail (rollback)</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Schema 漂移偵測 (banking 等級資料完整性檢查)</div>
        <div class="card-body">
            <p class="text-muted small mb-2">
                每次儲存任務時自動快照當下的來源/目標欄位定義。執行 ETL 前會比對目前 schema 與快照，
                若上游加欄/移欄/改型 → 依下方政策處置。
            </p>
            <div class="row g-2 mb-2">
                <div class="col-md-12">
                    <div class="form-check form-check-inline">
                        <input type="radio" class="form-check-input" id="sd-ignore" name="sdpol"
                               checked="@(_task.SchemaDriftPolicy == SchemaDriftPolicy.Ignore)"
                               @onchange="() => _task.SchemaDriftPolicy = SchemaDriftPolicy.Ignore" />
                        <label class="form-check-label" for="sd-ignore">不檢查 (Ignore)</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input type="radio" class="form-check-input" id="sd-warn" name="sdpol"
                               checked="@(_task.SchemaDriftPolicy == SchemaDriftPolicy.Warn)"
                               @onchange="() => _task.SchemaDriftPolicy = SchemaDriftPolicy.Warn" />
                        <label class="form-check-label" for="sd-warn">僅警告 (Warn) — 寫 audit 但仍執行</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input type="radio" class="form-check-input" id="sd-fail" name="sdpol"
                               checked="@(_task.SchemaDriftPolicy == SchemaDriftPolicy.Fail)"
                               @onchange="() => _task.SchemaDriftPolicy = SchemaDriftPolicy.Fail" />
                        <label class="form-check-label" for="sd-fail">直接失敗 (Fail) — mapping 受影響時立即停止</label>
                    </div>
                </div>
            </div>
            <div class="text-muted small">
                <strong>目前 schema 快照：</strong>
                @if (_task.SchemaSnapshotAt.HasValue)
                {
                    <code>@_task.SchemaSnapshotAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</code>
                    <span class="ms-2">
                        (來源 @SnapshotColumnCount(_task.SourceSchemaSnapshotJson) 欄 ·
                        目標 @SnapshotColumnCount(_task.TargetSchemaSnapshotJson) 欄)
                    </span>
                }
                else
                {
                    <span class="text-warning">尚未建立 — 儲存任務時會自動建立。</span>
                }
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">隱私保護</div>
        <div class="card-body">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="mask-sample" @bind="_task.MaskSamplePayload" />
                <label class="form-check-label" for="mask-sample">
                    <strong>遮罩 sample payload</strong>
                </label>
            </div>
            <small class="text-muted d-block mt-1">
                開啟時，執行歷史中保存的「前 5 筆 sample」字串值若 &gt; 4 字 會自動遮罩成
                <code>A***e</code> 形式（保留首尾各一字、中間以 * 代替）。
                適合 PII / 客戶資料表。數值與日期不遮罩，方便除錯。
            </small>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">完成後呼叫 Stored Procedure (可選)</div>
        <div class="card-body">
            <p class="text-muted small mb-3">
                ETL 寫入完成後在<strong>目標 DB</strong> 呼叫指定的 stored procedure。
                SP 會收到標準參數：<code>task_id</code>, <code>task_name</code>, <code>run_id</code>, <code>status</code>,
                <code>rows_read</code>, <code>rows_written</code>, <code>started_at</code>, <code>finished_at</code>,
                <code>error_message</code>, <code>trigger_type</code>。
                SP 失敗不會 rollback 已寫入的資料，僅在執行紀錄記下錯誤。
            </p>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">成功後 SP（schema.name）</label>
                    <input class="form-control font-monospace" placeholder="例如 dbo.OnEtlSucceeded"
                           @bind="_task.PostSuccessSp" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">失敗後 SP（schema.name）</label>
                    <input class="form-control font-monospace" placeholder="例如 dbo.OnEtlFailed"
                           @bind="_task.PostFailureSp" />
                </div>
            </div>
        </div>
    </div>

    @if (_validationErrors.Count > 0)
    {
        <div class="alert alert-warning">
            <strong>請修正以下問題：</strong>
            <ul class="mb-0">
                @foreach (var err in _validationErrors)
                {
                    <li>@err</li>
                }
            </ul>
        </div>
    }

    @if (_message is not null)
    {
        <div class="alert @(_isError ? "alert-danger" : "alert-success")">@_message</div>
    }

    <div class="d-flex gap-2">
        <button class="btn btn-primary" @onclick="Save">儲存</button>
        @if (Id is not null)
        {
            <button class="btn btn-success" @onclick="SaveAndRun" disabled="@_saveAndRunBusy"
                    title="儲存設定後立即手動觸發一次（不必再回 Tasks list 按 ▶）">
                @if (_saveAndRunBusy) { <Icon Name="loader" /> <span>處理中…</span> }
                else { <span>💾▶ 儲存並立即執行</span> }
            </button>
        }
        <button class="btn btn-outline-info" @onclick="DryRun" disabled="@_dryRunBusy">
            @(_dryRunBusy ? "預覽中…" : "👀 預覽前 5 筆")
        </button>
        <a class="btn btn-link" href="tasks">取消</a>
    </div>

    @if (_dryRunModal)
    {
        <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5)">
            <div class="modal-dialog modal-xl modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">來源資料預覽（最多 5 筆）</h5>
                        <button type="button" class="btn-close" @onclick="() => _dryRunModal = false"></button>
                    </div>
                    <div class="modal-body">
                        @if (_dryRunError is not null)
                        {
                            <div class="alert alert-danger">
                                <strong>查詢失敗：</strong>
                                <pre class="mb-0">@_dryRunError</pre>
                            </div>
                        }
                        else if (_dryRunRows is null)
                        {
                            <p>查詢中…</p>
                        }
                        else if (_dryRunRows.Count == 0)
                        {
                            <p class="text-muted">無資料 — 篩選條件下沒有符合的列。</p>
                        }
                        else
                        {
                            <p class="text-muted small">這是 raw 來源資料（未套用映射轉換）。共顯示 @_dryRunRows.Count 筆。</p>
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered">
                                    <thead>
                                        <tr>
                                            @foreach (var k in _dryRunRows[0].Keys) { <th>@k</th> }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in _dryRunRows)
                                        {
                                            <tr>
                                                @foreach (var v in row.Values) { <td>@FormatCell(v)</td> }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="() => _dryRunModal = false">關閉</button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public Guid? Id { get; set; }

    private EtlTool.Core.Models.EtlTask? _task;
    private List<EtlTool.Core.Models.ConnectionDefinition>? _connections;

    private List<string> _sourceSchemas = new();
    private List<string> _sourceTables = new();
    private List<EtlTool.Core.Models.ColumnInfo> _sourceColumns = new();

    private List<string> _targetSchemas = new();
    private List<string> _targetTables = new();
    private List<EtlTool.Core.Models.ColumnInfo> _targetColumns = new();

    private string? _message;
    private bool _isError;
    private bool _refreshingSource;
    private bool _refreshingTarget;

    // Source preview state — 顯示前 10 筆 source data 給 admin 在存檔前 sanity check
    private bool _previewBusy;
    private EtlTool.App.Services.SourcePreviewService.PreviewResult? _previewResult;

    private async Task RunSourcePreview()
    {
        _previewBusy = true;
        _previewResult = null;
        StateHasChanged();
        try
        {
            _previewResult = await SourcePreview.PreviewAsync(_task, rowLimit: 10, CancellationToken.None);
        }
        catch (Exception ex)
        {
            // 防呆：service 內已 catch；這裡只是 last-resort
            _previewResult = new EtlTool.App.Services.SourcePreviewService.PreviewResult(
                Ok: false, Sql: null,
                Columns: Array.Empty<string>(),
                Rows: Array.Empty<Dictionary<string, object?>>(),
                MaskedColumns: Array.Empty<string>(),
                ElapsedMs: 0, Error: $"預覽呼叫意外失敗：{ex.Message}");
        }
        finally
        {
            _previewBusy = false;
        }
    }

    /// <summary>截斷 + ToString 預覽資料，避免 BLOB / 超長字串撐爆表格。</summary>
    private static string FormatPreviewValue(object value)
    {
        var s = value switch
        {
            byte[] bs => $"<{bs.Length} bytes>",
            DateTime dt => dt.ToString("yyyy-MM-dd HH:mm:ss"),
            _ => value.ToString() ?? "",
        };
        if (s.Length > 80) s = s[..77] + "…";
        return s;
    }

    private List<string> _validationErrors = new();

    private bool _dryRunBusy;
    private bool _dryRunModal;
    private bool _saveAndRunBusy;
    private bool _suppressNavigateAfterSave;

    private async Task SaveAndRun()
    {
        if (_task is null || Id is null) return;
        _saveAndRunBusy = true;
        _suppressNavigateAfterSave = true;
        try
        {
            // Save() 內部用 _suppressNavigateAfterSave 跳過 NavigateTo，留在原頁
            await Save();
            // 若驗證失敗 / PII 攔截 / 弱密碼 modal → _validationErrors 或 _showPiiSuggest 會被設
            if (_validationErrors.Count > 0 || _showPiiSuggest) return;
            try
            {
                await Scheduler.TriggerNowAsync(Id.Value, CancellationToken.None);
                _isError = false;
                _message = "已儲存並觸發手動執行；可至『執行歷史』查看結果。";
            }
            catch (Exception ex)
            {
                _isError = true;
                _message = $"儲存成功但觸發失敗：{ex.Message}";
            }
        }
        finally
        {
            _saveAndRunBusy = false;
            _suppressNavigateAfterSave = false;
        }
    }
    private List<Dictionary<string, object?>>? _dryRunRows;
    private string? _dryRunError;

    private string? _currentUsername;
    private List<EtlTool.Core.Models.EtlTask>? _allTasks;
    private HashSet<Guid> _selectedDependsOn = new();
    private List<EtlTool.Core.Models.EtlTask> _downstreamTasks = new();
    private List<string> _knownTags = new();

    private void ToggleDependency(Guid parentId, bool include)
    {
        if (_task is null) return;
        if (include) _selectedDependsOn.Add(parentId);
        else _selectedDependsOn.Remove(parentId);
        _task.DependsOnTaskIds = string.Join(",", _selectedDependsOn);
    }

    // PII mask 建議流程
    private bool _showPiiSuggest;
    private bool _piiCheckPassed;
    private List<string> _piiSuggestColumns = new();

    // Webhook payload preview
    private bool _showWebhookPreview;
    private string _previewVariant = "fail";
    private string? _webhookPreviewJson;
    private string _webhookFormat = "generic";

    private void ShowWebhookPreview()
    {
        _webhookFormat = Config["Webhooks:Format"] ?? "generic";
        _previewVariant = "fail";
        BuildPreview();
        _showWebhookPreview = true;
    }

    private void SetPreviewVariant(string variant)
    {
        _previewVariant = variant;
        BuildPreview();
    }

    private void SetPreviewVariantFail() => SetPreviewVariant("fail");
    private void SetPreviewVariantStreak() => SetPreviewVariant("streak");
    private void SetPreviewVariantRecovery() => SetPreviewVariant("recovery");
    private void SetPreviewVariantSuccess() => SetPreviewVariant("success");

    private void BuildPreview()
    {
        if (_task is null) return;

        var format = EtlTool.App.Services.WebhookPayloadBuilder.ParseFormat(_webhookFormat);
        var (fakeRun, error) = _previewVariant switch
        {
            "streak" => MakePreviewRun(EtlTool.Core.Models.RunStatus.Failed, "[STREAK 3/3] connection refused: timed out"),
            "recovery" => MakePreviewRun(EtlTool.Core.Models.RunStatus.Success, "[RECOVERY after 3 consecutive failures]"),
            "success" => MakePreviewRun(EtlTool.Core.Models.RunStatus.Success, null),
            _ => MakePreviewRun(EtlTool.Core.Models.RunStatus.Failed, "connection refused: timed out"),
        };

        var payload = EtlTool.App.Services.WebhookPayloadBuilder.BuildPayload(format, _task, fakeRun, error);
        _webhookPreviewJson = System.Text.Json.JsonSerializer.Serialize(payload,
            new System.Text.Json.JsonSerializerOptions
            {
                WriteIndented = true,
                Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
            });
    }

    private (EtlTool.Core.Models.RunHistory run, string? error) MakePreviewRun(
        EtlTool.Core.Models.RunStatus status, string? error)
    {
        var run = new EtlTool.Core.Models.RunHistory
        {
            Id = Guid.NewGuid(),
            EtlTaskId = _task!.Id,
            Status = status,
            StartedAt = DateTime.UtcNow.AddMinutes(-2),
            FinishedAt = DateTime.UtcNow,
            RowsRead = status == EtlTool.Core.Models.RunStatus.Failed ? 100 : 1234,
            RowsWritten = status == EtlTool.Core.Models.RunStatus.Failed ? 0 : 1234,
            TriggerType = EtlTool.Core.Models.TriggerType.Scheduled,
            ErrorMessage = error,
        };
        return (run, error);
    }

    private async Task EnableMaskAndSave()
    {
        if (_task is null) return;
        _task.MaskSamplePayload = true;
        _showPiiSuggest = false;
        _piiCheckPassed = true;
        await Save();
    }

    private async Task SaveWithoutMask()
    {
        _showPiiSuggest = false;
        _piiCheckPassed = true;  // 已 acknowledge，不再 prompt
        await Save();
    }

    private void ClearSchemaSnapshot()
    {
        if (_task is null) return;
        _task.SourceSchemaSnapshotJson = null;
        _task.TargetSchemaSnapshotJson = null;
        _task.SchemaSnapshotAt = null;
        _message = "已清除 schema 快照（按「儲存」生效；下次執行時自動重建）。";
        _isError = false;
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        var ct = CancellationToken.None;
        var state = await AuthState.GetAuthenticationStateAsync();
        _currentUsername = state.User.Identity?.Name;
        _connections = await ConnRepo.ListAsync(ct);
        _allTasks = await TaskRepo.ListLightweightAsync(ct);
        // Collect distinct tags from all tasks for autocomplete
        _knownTags = _allTasks
            .Where(t => !string.IsNullOrEmpty(t.Tags))
            .SelectMany(t => t.Tags!.Split(',', StringSplitOptions.RemoveEmptyEntries))
            .Select(s => s.Trim())
            .Where(s => s.Length > 0)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(s => s)
            .ToList();
        if (Id is null)
        {
            _task = new EtlTool.Core.Models.EtlTask();
        }
        else
        {
            var existing = await TaskRepo.GetWithMappingsAsync(Id.Value, ct);
            if (existing is null) { Nav.NavigateTo("tasks"); return; }
            _task = existing;
            // Hydrate _selectedDependsOn from stored CSV
            _selectedDependsOn = EtlTool.Core.Engine.TaskDependencyChecker
                .ParseDependsOnIds(_task.DependsOnTaskIds).ToHashSet();
            // 反向找：哪些 task 把我列為 parent
            _downstreamTasks = (_allTasks ?? new())
                .Where(t => t.Id != _task.Id
                    && EtlTool.Core.Engine.TaskDependencyChecker
                        .ParseDependsOnIds(t.DependsOnTaskIds).Contains(_task.Id))
                .ToList();
            await ReloadSourceMetadata();
            await ReloadTargetMetadata();
        }
    }

    private async Task OnSourceConnectionChanged(ChangeEventArgs e)
    {
        if (_task is null) return;
        _task.SourceConnectionId = ParseGuid(e.Value);
        _task.SourceSchema = "";
        _task.SourceTable = "";
        await ReloadSourceMetadata();
    }

    private async Task OnSourceSchemaChanged(ChangeEventArgs e)
    {
        if (_task is null) return;
        _task.SourceSchema = e.Value as string ?? "";
        _task.SourceTable = "";
        _sourceTables.Clear();
        _sourceColumns.Clear();
        await LoadTablesAsync(_task.SourceConnectionId, _task.SourceSchema, _sourceTables);
    }

    private async Task OnSourceTableChanged(ChangeEventArgs e)
    {
        if (_task is null) return;
        _task.SourceTable = e.Value as string ?? "";
        _sourceColumns = new List<EtlTool.Core.Models.ColumnInfo>();
        if (!string.IsNullOrEmpty(_task.SourceTable))
        {
            _sourceColumns = (await LoadColumnsAsync(_task.SourceConnectionId, _task.SourceSchema, _task.SourceTable)).ToList();
        }
    }

    private async Task OnTargetConnectionChanged(ChangeEventArgs e)
    {
        if (_task is null) return;
        _task.TargetConnectionId = ParseGuid(e.Value);
        _task.TargetSchema = "";
        _task.TargetTable = "";
        await ReloadTargetMetadata();
    }

    private async Task OnTargetSchemaChanged(ChangeEventArgs e)
    {
        if (_task is null) return;
        _task.TargetSchema = e.Value as string ?? "";
        _task.TargetTable = "";
        _targetTables.Clear();
        _targetColumns.Clear();
        await LoadTablesAsync(_task.TargetConnectionId, _task.TargetSchema, _targetTables);
    }

    private async Task OnTargetTableChanged(ChangeEventArgs e)
    {
        if (_task is null) return;
        _task.TargetTable = e.Value as string ?? "";
        _targetColumns = new List<EtlTool.Core.Models.ColumnInfo>();
        if (!string.IsNullOrEmpty(_task.TargetTable))
        {
            _targetColumns = (await LoadColumnsAsync(_task.TargetConnectionId, _task.TargetSchema, _task.TargetTable)).ToList();
        }
    }

    private async Task ReloadSourceMetadata()
    {
        if (_task is null || _task.SourceConnectionId == Guid.Empty) return;
        _sourceSchemas = (await LoadSchemasAsync(_task.SourceConnectionId)).ToList();
        if (!string.IsNullOrEmpty(_task.SourceSchema))
            await LoadTablesAsync(_task.SourceConnectionId, _task.SourceSchema, _sourceTables);
        if (!string.IsNullOrEmpty(_task.SourceTable))
            _sourceColumns = (await LoadColumnsAsync(_task.SourceConnectionId, _task.SourceSchema, _task.SourceTable)).ToList();
    }

    private async Task RefreshSourceMetadata()
    {
        _refreshingSource = true;
        StateHasChanged();
        try { await ReloadSourceMetadata(); }
        finally { _refreshingSource = false; }
    }

    private async Task RefreshTargetMetadata()
    {
        _refreshingTarget = true;
        StateHasChanged();
        try { await ReloadTargetMetadata(); }
        finally { _refreshingTarget = false; }
    }

    private async Task ReloadTargetMetadata()
    {
        if (_task is null || _task.TargetConnectionId == Guid.Empty) return;
        _targetSchemas = (await LoadSchemasAsync(_task.TargetConnectionId)).ToList();
        if (!string.IsNullOrEmpty(_task.TargetSchema))
            await LoadTablesAsync(_task.TargetConnectionId, _task.TargetSchema, _targetTables);
        if (!string.IsNullOrEmpty(_task.TargetTable))
            _targetColumns = (await LoadColumnsAsync(_task.TargetConnectionId, _task.TargetSchema, _task.TargetTable)).ToList();
    }

    private async Task<IReadOnlyList<string>> LoadSchemasAsync(Guid connId)
    {
        try
        {
            var def = await ConnRepo.GetAsync(connId, CancellationToken.None);
            if (def is null) return Array.Empty<string>();
            var connector = ConnectorFactory.Create(def);
            return await connector.ListSchemasAsync(CancellationToken.None);
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = $"讀取 schema 失敗：{ex.Message}";
            return Array.Empty<string>();
        }
    }

    private async Task LoadTablesAsync(Guid connId, string schema, List<string> target)
    {
        target.Clear();
        if (connId == Guid.Empty || string.IsNullOrEmpty(schema)) return;
        try
        {
            var def = await ConnRepo.GetAsync(connId, CancellationToken.None);
            if (def is null) return;
            var connector = ConnectorFactory.Create(def);
            target.AddRange(await connector.ListTablesAsync(schema, CancellationToken.None));
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = $"讀取 table 失敗：{ex.Message}";
        }
    }

    private async Task<IReadOnlyList<EtlTool.Core.Models.ColumnInfo>> LoadColumnsAsync(Guid connId, string schema, string table)
    {
        try
        {
            var def = await ConnRepo.GetAsync(connId, CancellationToken.None);
            if (def is null) return Array.Empty<EtlTool.Core.Models.ColumnInfo>();
            var connector = ConnectorFactory.Create(def);
            return await connector.ListColumnsAsync(schema, table, CancellationToken.None);
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = $"讀取 columns 失敗：{ex.Message}";
            return Array.Empty<EtlTool.Core.Models.ColumnInfo>();
        }
    }

    private async Task Save()
    {
        if (_task is null) return;
        _validationErrors = EtlTool.Core.Engine.EtlTaskValidator.Validate(_task);
        if (_validationErrors.Count > 0)
        {
            _message = null;
            return;
        }

        // 循環依賴檢查：避免 admin 不小心把 A → B → A 設成循環導致排程永遠等下去
        if (_selectedDependsOn.Count > 0 && _allTasks is not null)
        {
            var allDeps = _allTasks
                .Where(t => t.Id != _task.Id)  // 不要包含自己舊版本
                .ToDictionary(
                    t => t.Id,
                    t => (IReadOnlyList<Guid>)EtlTool.Core.Engine.TaskDependencyChecker
                        .ParseDependsOnIds(t.DependsOnTaskIds).ToList());
            var cycle = EtlTool.Core.Engine.TaskDependencyChecker.DetectCycle(
                _task.Id, _selectedDependsOn.ToList(), allDeps);
            if (cycle.HasCycle)
            {
                _validationErrors = new() { cycle.Reason ?? "依賴設定形成循環" };
                _message = null;
                return;
            }
        }

        // PII + MaskSamplePayload 建議：偵測映射欄位是否含 PII，若有且 mask 未開
        // → 顯示 modal 詢問是否啟用。Admin 確認過後，無論選哪個都繼續儲存。
        if (!_piiCheckPassed && !_task.MaskSamplePayload && _task.Mappings.Count > 0)
        {
            var piiCols = _task.Mappings
                .Where(m => !string.IsNullOrEmpty(m.SourceColumn))
                .Select(m => (col: m.SourceColumn,
                              det: EtlTool.Core.Engine.PiiDetector.Inspect(m.SourceColumn)))
                .Where(x => x.det.Kind != EtlTool.Core.Engine.PiiDetector.PiiKind.None)
                .ToList();
            if (piiCols.Count > 0)
            {
                _piiSuggestColumns = piiCols.Select(x =>
                    $"{x.col} ({EtlTool.Core.Engine.PiiDetector.KindLabel(x.det.Kind)})").ToList();
                _showPiiSuggest = true;
                return;  // 等 modal 決定
            }
        }

        // 捕捉 schema 快照（用使用者選表時已載入的欄位資訊）
        if (_sourceColumns.Count > 0)
            _task.SourceSchemaSnapshotJson = System.Text.Json.JsonSerializer.Serialize(_sourceColumns);
        if (_targetColumns.Count > 0)
            _task.TargetSchemaSnapshotJson = System.Text.Json.JsonSerializer.Serialize(_targetColumns);
        if (_sourceColumns.Count > 0 || _targetColumns.Count > 0)
            _task.SchemaSnapshotAt = DateTime.UtcNow;

        try
        {
            EtlTool.Core.Models.EtlTask saved;
            if (Id is null)
            {
                saved = await TaskRepo.CreateAsync(_task, CancellationToken.None, actor: _currentUsername);
            }
            else
            {
                saved = await TaskRepo.UpdateAsync(_task, CancellationToken.None, actor: _currentUsername);
            }
            await Scheduler.RescheduleAsync(saved.Id, CancellationToken.None);
            if (!_suppressNavigateAfterSave)
                Nav.NavigateTo("tasks");
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = $"儲存失敗：{ex.Message}";
        }
    }

    private async Task DryRun()
    {
        if (_task is null) return;
        // 預覽前需要：來源連線/schema/table 已選；mapping 可空（會抓全欄）
        var basicErrors = new List<string>();
        if (_task.SourceConnectionId == Guid.Empty) basicErrors.Add("請先選擇來源連線");
        if (string.IsNullOrEmpty(_task.SourceSchema)) basicErrors.Add("請先選擇來源 Schema");
        if (string.IsNullOrEmpty(_task.SourceTable)) basicErrors.Add("請先選擇來源 Table");
        if (basicErrors.Count > 0)
        {
            _validationErrors = basicErrors;
            return;
        }

        _validationErrors = new();
        _dryRunBusy = true;
        _dryRunRows = null;
        _dryRunError = null;
        _dryRunModal = true;
        StateHasChanged();
        try
        {
            _dryRunRows = await EtlEngine.PreviewSourceAsync(_task, 5, CancellationToken.None);
        }
        catch (Exception ex)
        {
            _dryRunError = ex.ToString();
        }
        finally
        {
            _dryRunBusy = false;
        }
    }

    private static string FormatCell(object? v)
    {
        if (v is null) return "(null)";
        if (v is DateTime dt) return dt.ToString("yyyy-MM-dd HH:mm:ss");
        return v.ToString() ?? "";
    }


    private static Guid ParseGuid(object? value)
        => Guid.TryParse(value as string, out var g) ? g : Guid.Empty;

    private static string ComputeRetryDelays(EtlTool.Core.Models.EtlTask t)
    {
        if (t.MaxRetries <= 0) return "—";
        var delays = new List<string>();
        double d = t.RetryDelaySeconds;
        for (int i = 0; i < t.MaxRetries && i < 5; i++)
        {
            delays.Add(FormatSeconds(d));
            d *= t.RetryBackoffMultiplier;
        }
        if (t.MaxRetries > 5) delays.Add("…");
        return string.Join(" → ", delays);
    }

    private static string FormatSeconds(double s)
    {
        if (s < 60) return $"{s:0}s";
        if (s < 3600) return $"{s / 60:0.#}m";
        return $"{s / 3600:0.#}h";
    }

    private static int SnapshotColumnCount(string? json)
    {
        if (string.IsNullOrEmpty(json)) return 0;
        try
        {
            var arr = System.Text.Json.JsonSerializer.Deserialize<List<EtlTool.Core.Models.ColumnInfo>>(json);
            return arr?.Count ?? 0;
        }
        catch { return 0; }
    }
}
