    }

    private async Task ConfirmBulk()
    {
        if (_items is null || _currentUsername is null) return;
        _bulkBusy = true;
        try
        {
            var ct = CancellationToken.None;
            // 若 admin 在 Tasks list 啟用了篩選，bulk 只作用於該子集 — 否則作用於全部
            var pool = HasActiveFilter ? (_filtered ?? _items) : _items;
            var targets = pool.Where(t => t.Enabled != _bulkEnable).ToList();

            // 批次「啟用」時，跳過 auto-disabled 任務（避免無腦把壞掉的 task 重新打開）
            // — admin 必須走逐筆 re-enable 確認流程
            var skipped = new List<EtlTool.Core.Models.EtlTask>();
            if (_bulkEnable)
            {
                skipped = targets.Where(t => t.AutoDisabledAt is not null).ToList();
                targets = targets.Where(t => t.AutoDisabledAt is null).ToList();
            }

            int changed = 0;
            foreach (var t in targets)
            {
                var full = await TaskRepo.GetWithMappingsAsync(t.Id, ct);
                if (full is null) continue;
                full.Enabled = _bulkEnable;
                await TaskRepo.UpdateAsync(full, ct, actor: _currentUsername);
                await Scheduler.RescheduleAsync(t.Id, ct);
                changed++;
            }
            _showBulk = false;
            _isError = false;
            var msg = $"批次{(_bulkEnable ? "啟用" : "停用")}已套用，共 {changed} 個任務";
            if (skipped.Count > 0)
            {
                msg += $"。略過 {skipped.Count} 個 auto-disabled 任務（請逐筆走 re-enable 確認）：" +
                       string.Join("、", skipped.Take(5).Select(t => t.Name)) +
                       (skipped.Count > 5 ? $" …+{skipped.Count - 5}" : "");
            }
            if (!string.IsNullOrWhiteSpace(_bulkReason)) msg += $"（理由：{_bulkReason}）";
            _message = msg;
            await Reload();
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = $"批次操作失敗：{ex.Message}";
        }
        finally
        {
            _bulkBusy = false;
        }
    }

    private async Task ConfirmSubmit()
    {
        if (_submitTarget is null || _currentUsername is null) return;
        _modalError = null;
        try
        {
            await ApprovalRepo.SubmitAsync(
                ApprovalAction.DeleteTask,
                targetType: nameof(EtlTool.Core.Models.EtlTask),
                targetId: _submitTarget.Id,
                targetName: _submitTarget.Name,
                submittedBy: _currentUsername,
                reason: string.IsNullOrWhiteSpace(_reason) ? null : _reason,
                ct: CancellationToken.None);
            _showSubmit = false;
            _isError = false;
            _message = $"已提交「{_submitTarget.Name}」刪除請求，請通知另一位 Admin 至 /approvals 核准。";
            await Reload();
        }
        catch (Exception ex)
        {
            _modalError = ex.Message;
        }
    }
