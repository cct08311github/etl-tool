@code {
    private List<EtlTool.Core.Models.EtlTask>? _items;
    private List<EtlTool.Core.Models.EtlTask>? _filtered;
    private Dictionary<Guid, DateTimeOffset?> _nextFire = new();
    private Dictionary<Guid, DateTime> _lastSuccess = new();
    private Dictionary<Guid, DateTime> _lastFailure = new();
    private Dictionary<Guid, (int Success, int Total)> _sla = new();
    private Dictionary<Guid, List<EtlTool.Data.Repositories.RunHistorySummary>> _recentRunsByTask = new();
    private Dictionary<Guid, double> _recentMaxByTask = new();
    private Dictionary<Guid, double> _p95ByTask = new();
    private HashSet<Guid> _pendingTargets = new();

    private string _filterName = "";
    private string _filterEnabled = "";
    private string _filterSla = "";
    private string _filterConnection = "";
    private string _filterTag = "";
    private List<EtlTool.Core.Models.ConnectionDefinition> _connections = new();

    private bool HasActiveFilter =>
        !string.IsNullOrWhiteSpace(_filterName) ||
        !string.IsNullOrEmpty(_filterEnabled) ||
        !string.IsNullOrEmpty(_filterSla) ||
        !string.IsNullOrEmpty(_filterConnection) ||
        !string.IsNullOrWhiteSpace(_filterTag);

    private void ClearAllFilters()
    {
        _filterName = "";
        _filterEnabled = "";
        _filterSla = "";
        _filterConnection = "";
        _filterTag = "";
        ApplyFilter();
    }

    /// <summary>
    /// 把 5 個 filter 變數 reflect 到 URL query string。空值不寫；NavigationManager
    /// 用 replaceHistoryEntry=true 避免每次 typing 都 push 新 history entry。
    /// </summary>
    private void UpdateUrlFromFilters()
    {
        var query = new List<string>();
        if (!string.IsNullOrWhiteSpace(_filterName))
            query.Add("name=" + Uri.EscapeDataString(_filterName));
        if (!string.IsNullOrEmpty(_filterEnabled))
            query.Add("status=" + Uri.EscapeDataString(_filterEnabled));
        if (!string.IsNullOrEmpty(_filterSla))
            query.Add("sla=" + Uri.EscapeDataString(_filterSla));
        if (!string.IsNullOrEmpty(_filterConnection))
            query.Add("connection=" + Uri.EscapeDataString(_filterConnection));
        if (!string.IsNullOrWhiteSpace(_filterTag))
            query.Add("tag=" + Uri.EscapeDataString(_filterTag));

        var newPath = "tasks" + (query.Count > 0 ? "?" + string.Join("&", query) : "");
        var current = new Uri(NavMgr.Uri);
        var currentRel = current.PathAndQuery.TrimStart('/');
        if (!string.Equals(currentRel, newPath, StringComparison.OrdinalIgnoreCase))
        {
            // replaceHistoryEntry=true so back-button jumps to /tasks (not every keystroke)
            NavMgr.NavigateTo(newPath, forceLoad: false, replace: true);
        }
    }

    private void ClearFilter(string which)
    {
        switch (which)
        {
            case "name": _filterName = ""; break;
            case "enabled": _filterEnabled = ""; break;
            case "sla": _filterSla = ""; break;
            case "connection": _filterConnection = ""; break;
            case "tag": _filterTag = ""; break;
        }
        ApplyFilter();
    }

    private void SetTagFilter(string tag)
    {
        _filterTag = tag;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        // 同步當前 filter state 到 URL query string —
        // admin 可以複製 URL 給同事 / 加入書籤，回到原本的篩選結果。
        UpdateUrlFromFilters();

        if (_items is null) { _filtered = null; return; }
        IEnumerable<EtlTool.Core.Models.EtlTask> q = _items;
        if (!string.IsNullOrWhiteSpace(_filterName))
        {
            var s = _filterName.Trim();
            q = q.Where(t => t.Name.Contains(s, StringComparison.OrdinalIgnoreCase));
        }
        q = _filterEnabled switch
        {
            "enabled"      => q.Where(t => t.Enabled),
            "disabled"     => q.Where(t => !t.Enabled && t.AutoDisabledAt is null),
            "autodisabled" => q.Where(t => t.AutoDisabledAt is not null),
            _ => q,
        };
        q = _filterSla switch
        {
            "bad" => q.Where(t => _sla.TryGetValue(t.Id, out var s) && s.Total > 0 && s.Success * 100.0 / s.Total < 95),
            "ok"  => q.Where(t => _sla.TryGetValue(t.Id, out var s) && s.Total > 0 && s.Success * 100.0 / s.Total >= 95),
            "none" => q.Where(t => !_sla.TryGetValue(t.Id, out var s) || s.Total == 0),
            _ => q,
        };
        if (Guid.TryParse(_filterConnection, out var connId))
        {
            q = q.Where(t => t.SourceConnectionId == connId || t.TargetConnectionId == connId);
        }
        if (!string.IsNullOrWhiteSpace(_filterTag))
        {
            var tagFilter = _filterTag.Trim();
            q = q.Where(t =>
            {
                if (string.IsNullOrEmpty(t.Tags)) return false;
                var tags = t.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries)
                    .Select(s => s.Trim());
                return tags.Any(tag => tag.Contains(tagFilter, StringComparison.OrdinalIgnoreCase));
            });
        }
        _filtered = q.ToList();
    }
    private Guid? _running;
    private string? _currentUsername;
    private string? _message;
    private bool _isError;

    private bool _showSubmit;
    private EtlTool.Core.Models.EtlTask? _submitTarget;
    private string _reason = "";
    private string? _modalError;

    private bool _showBulk;
    private bool _bulkEnable;
    private bool _bulkBusy;
    private string _bulkReason = "";

    private bool _showReEnable;
    private EtlTool.Core.Models.EtlTask? _reEnableTask;

    // Global tag rename
    private bool _showTagRename;
    private bool _renameBusy;
    private string _renameOldTag = "";
    private string _renameNewTag = "";
    private string? _renameError;
    private List<string> _allTagsInUse = new();

    private void OpenTagRename()
    {
        _renameOldTag = "";
        _renameNewTag = "";
        _renameError = null;
        _allTagsInUse = (_items ?? new())
            .Where(t => !string.IsNullOrEmpty(t.Tags))
            .SelectMany(t => t.Tags!.Split(',', StringSplitOptions.RemoveEmptyEntries))
            .Select(s => s.Trim())
            .Where(s => s.Length > 0)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(s => s)
            .ToList();
        _showTagRename = true;
    }

    private static bool HasTag(EtlTool.Core.Models.EtlTask t, string tag)
    {
        if (string.IsNullOrEmpty(t.Tags)) return false;
        return t.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Any(s => string.Equals(s.Trim(), tag, StringComparison.OrdinalIgnoreCase));
    }

    private async Task ConfirmTagRename()
    {
        if (string.IsNullOrEmpty(_renameOldTag) || _items is null || _currentUsername is null) return;
        var oldTag = _renameOldTag.Trim();
        var newTag = _renameNewTag.Trim();

        // Sanity: new tag can't contain comma (would split into multiple tags unexpectedly)
        if (newTag.Contains(','))
        {
            _renameError = "新 tag 不可含逗號";
            return;
        }

        _renameBusy = true;
        _renameError = null;
        try
        {
            var ct = CancellationToken.None;
            var affected = _items.Where(t => HasTag(t, oldTag)).ToList();
            int changed = 0;
            foreach (var t in affected)
            {
                var full = await TaskRepo.GetWithMappingsAsync(t.Id, ct);
                if (full is null) continue;
                // 重新組合 tags：移除 oldTag，加入 newTag（若 newTag 非空且尚未存在）
                var tags = (full.Tags ?? "")
                    .Split(',', StringSplitOptions.RemoveEmptyEntries)
                    .Select(s => s.Trim())
                    .Where(s => s.Length > 0 && !string.Equals(s, oldTag, StringComparison.OrdinalIgnoreCase))
                    .ToList();
                if (!string.IsNullOrEmpty(newTag) &&
                    !tags.Any(s => string.Equals(s, newTag, StringComparison.OrdinalIgnoreCase)))
                {
                    tags.Add(newTag);
                }
                full.Tags = tags.Count == 0 ? null : string.Join(",", tags);
                await TaskRepo.UpdateAsync(full, ct, actor: _currentUsername);
                changed++;
            }
            _showTagRename = false;
            _isError = false;
            _message = string.IsNullOrEmpty(newTag)
                ? $"已從 {changed} 個任務移除 tag「{oldTag}」"
                : $"已將 {changed} 個任務的 tag「{oldTag}」改為「{newTag}」";
            await Reload();
        }
        catch (Exception ex)
        {
            _renameError = ex.Message;
        }
        finally
        {
            _renameBusy = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _currentUsername = state.User.Identity?.Name;

        // Read deep-link query params — supports name / status / sla / connection / tag
        var uri = new Uri(NavMgr.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("name", out var nameVal)) _filterName = nameVal.ToString();
        if (query.TryGetValue("status", out var statusVal)) _filterEnabled = statusVal.ToString();
        if (query.TryGetValue("sla", out var slaVal)) _filterSla = slaVal.ToString();
        if (query.TryGetValue("connection", out var connVal)) _filterConnection = connVal.ToString();
        if (query.TryGetValue("tag", out var tagVal)) _filterTag = tagVal.ToString();

        await Reload();
    }

    private async Task Reload()
    {
        var ct = CancellationToken.None;
        _items = await TaskRepo.ListLightweightAsync(ct);
        _connections = await ConnRepo.ListAsync(ct);
        _nextFire.Clear();
        foreach (var t in _items)
        {
            try { _nextFire[t.Id] = await Scheduler.GetNextFireTimeAsync(t.Id, ct); }
            catch { _nextFire[t.Id] = null; }
        }
        _lastSuccess = await RunHistoryRepo.LastSuccessByTaskAsync(ct);
        _lastFailure = await RunHistoryRepo.LastFailureByTaskAsync(ct);
        _sla = await RunHistoryRepo.SuccessRateByTaskAsync(TimeSpan.FromDays(30), ct);

        // Sparkline + p95 — 過去 30 天每個 task 取最近 20 筆
        _recentRunsByTask = await RunHistoryRepo.RecentRunsByTaskAsync(TimeSpan.FromDays(30), 20, ct);
        _recentMaxByTask.Clear();
        _p95ByTask.Clear();
        foreach (var (tid, runs) in _recentRunsByTask)
        {
            var durs = runs
                .Where(r => r.FinishedAt is not null)
                .Select(r => (r.FinishedAt!.Value - r.StartedAt).TotalSeconds)
                .OrderBy(d => d).ToList();
            if (durs.Count > 0)
            {
                _recentMaxByTask[tid] = durs.Max();
                // p95 by linear interpolation
                if (durs.Count == 1) _p95ByTask[tid] = durs[0];
                else
                {
                    var idx = 0.95 * (durs.Count - 1);
                    var lo = (int)Math.Floor(idx);
                    var hi = (int)Math.Ceiling(idx);
                    var frac = idx - lo;
                    _p95ByTask[tid] = durs[lo] + (durs[hi] - durs[lo]) * frac;
                }
            }
        }

        var pending = await ApprovalRepo.ListPendingAsync(ct);
        _pendingTargets = pending
            .Where(p => p.Action == ApprovalAction.DeleteTask)
            .Select(p => p.TargetId)
            .ToHashSet();

        ApplyFilter();
    }

    private async Task OnEnableToggle(EtlTool.Core.Models.EtlTask task, bool enabled)
    {
        // 從 disabled 變回 enabled，且是 auto-disabled → 走 confirm 流程；其他直接執行
        if (enabled && task.AutoDisabledAt is not null)
        {
            _reEnableTask = task;
            _showReEnable = true;
            // 把 UI 開關 revert 回 false（因為實際還沒套用）— 用 StateHasChanged 重繪
            StateHasChanged();
            return;
        }
        await ApplyEnable(task, enabled);
    }

    private async Task ApplyEnable(EtlTool.Core.Models.EtlTask task, bool enabled)
    {
        task.Enabled = enabled;
        var full = await TaskRepo.GetWithMappingsAsync(task.Id, CancellationToken.None);
        if (full is null) return;
        full.Enabled = enabled;
        await TaskRepo.UpdateAsync(full, CancellationToken.None, actor: _currentUsername);
        await Scheduler.RescheduleAsync(task.Id, CancellationToken.None);
        await Reload();
    }

    private async Task ConfirmReEnable()
    {
        if (_reEnableTask is null) return;
        var t = _reEnableTask;
        _showReEnable = false;
        _reEnableTask = null;
        await ApplyEnable(t, true);
        _isError = false;
        _message = $"任務「{t.Name}」已重新啟用，auto-disable 標記已清除。";
    }

