@page "/tasks"
@rendermode InteractiveServer
@inject EtlTool.Data.Repositories.EtlTaskRepository TaskRepo
@inject EtlTool.Data.Repositories.ConnectionRepository ConnRepo
@inject EtlTool.Data.Repositories.ApprovalRepository ApprovalRepo
@inject EtlTool.Data.Repositories.RunHistoryRepository RunHistoryRepo
@inject EtlTool.Core.Scheduling.SchedulerService Scheduler
@inject AuthenticationStateProvider AuthState
@inject NavigationManager NavMgr

<PageTitle>ETL 任務</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="m-0">ETL 任務</h1>
    <div class="d-flex gap-2">
        <AuthorizeView Roles="Admin,Operator">
            <Authorized>
                <div class="btn-group" role="group">
                    <a class="btn btn-outline-secondary" href="/Account/TaskGraphDot?format=dot" target="_blank" title="下載 Graphviz DOT 格式（可貼到 https://dreampuf.github.io/GraphvizOnline 視覺化）">
                        <Icon Name="external-link" /> DOT
                    </a>
                    <a class="btn btn-outline-secondary" href="/Account/TaskGraphDot?format=mermaid" target="_blank" title="下載 Mermaid 格式（可貼到 GitHub / GitLab / Obsidian markdown 直接顯示）">
                        Mermaid
                    </a>
                </div>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Roles="Admin">
            <Authorized>
                @if (_items is not null && _items.Any(t => !t.Enabled))
                {
                    <button class="btn btn-outline-success" @onclick="() => OpenBulk(true)">
                        <Icon Name="play" /> 批次啟用所有
                    </button>
                }
                @if (_items is not null && _items.Any(t => t.Enabled))
                {
                    <button class="btn btn-outline-warning" @onclick="() => OpenBulk(false)">
                        <Icon Name="pause" /> 批次停用所有
                    </button>
                }
                <button class="btn btn-outline-secondary" @onclick="OpenTagRename" title="跨所有任務批次重新命名一個 tag">
                    🏷 重新命名 tag
                </button>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Roles="Admin">
            <Authorized>
                <div class="btn-group" role="group">
                    <a class="btn btn-outline-primary" href="tasks/import" title="批次匯入 CSV">
                        <Icon Name="external-link" /> 匯入 CSV
                    </a>
                    <a class="btn btn-outline-primary" href="/Account/TasksExport" target="_blank" title="下載所有任務 CSV">
                        <Icon Name="download" /> 匯出
                    </a>
                </div>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Roles="Admin,Operator">
            <Authorized>
                <a class="btn btn-primary" href="tasks/new">
                    <Icon Name="plus" />新增任務
                </a>
            </Authorized>
        </AuthorizeView>
    </div>
</div>

@if (_showTagRename)
{
    <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title">🏷 全域 tag 重新命名</h5></div>
                <div class="modal-body">
                    <p class="small text-muted">
                        把指定 tag 重新命名 / 合併到另一個 tag。所有受影響的任務會走 EtlTaskRepository.UpdateAsync，
                        生成 EntityChangeHistory + audit。輸入新值為空 → 等於刪除此 tag。
                    </p>
                    <div class="mb-2">
                        <label class="form-label">舊 tag 名稱</label>
                        <select class="form-select" @bind="_renameOldTag">
                            <option value="">— 選擇要重新命名的 tag —</option>
                            @foreach (var tag in _allTagsInUse)
                            {
                                var count = _items?.Count(t => HasTag(t, tag)) ?? 0;
                                <option value="@tag">@tag (@count 個任務使用)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">新 tag 名稱（留空 = 刪除此 tag）</label>
                        <input class="form-control" placeholder="(留空 = 刪除)" @bind="_renameNewTag" />
                    </div>
                    @if (_renameError is not null)
                    {
                        <div class="alert alert-danger small">@_renameError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _showTagRename = false" disabled="@_renameBusy">取消</button>
                    <button class="btn btn-primary" @onclick="ConfirmTagRename"
                            disabled="@(_renameBusy || string.IsNullOrEmpty(_renameOldTag))">
                        @if (_renameBusy) { <Icon Name="loader" /> <span>處理中…</span> }
                        else { <span>確認</span> }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showReEnable && _reEnableTask is not null)
{
    <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">⛔ 此任務已被 circuit-breaker 自動停用</h5>
                </div>
                <div class="modal-body">
                    <p>
                        任務 <strong>@_reEnableTask.Name</strong> 在
                        <code>@_reEnableTask.AutoDisabledAt?.ToLocalTime():yyyy-MM-dd HH:mm</code>
                        被系統自動停用。
                    </p>
                    @if (!string.IsNullOrEmpty(_reEnableTask.AutoDisabledReason))
                    {
                        <div class="alert alert-warning small">
                            <strong>原因：</strong> @_reEnableTask.AutoDisabledReason
                        </div>
                    }
                    <p>請先確認問題已修復（連線、資料來源、過濾條件等），再啟用此任務。</p>
                    <p class="small text-muted">啟用後將清除 auto-disabled 標記並重新加入 scheduler。</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _showReEnable = false">取消</button>
                    <button class="btn btn-warning" @onclick="ConfirmReEnable">我已確認問題已修復，啟用</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showBulk)
{
    <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(_bulkEnable ? "批次啟用所有任務" : "批次停用所有任務")</h5>
                </div>
                <div class="modal-body">
                    <p>
                        @{
                            var scope = HasActiveFilter ? (_filtered ?? _items ?? new()) : (_items ?? new());
                            var scopeLabel = HasActiveFilter ? $"目前篩選結果（{scope.Count} 個任務）" : "所有任務";
                        }
                        將對 <strong>@scopeLabel</strong> 中
                        @if (_bulkEnable)
                        {
                            <span>Disabled 的 (<strong>@(scope.Count(t => !t.Enabled)) 個</strong>) 設為 Enabled</span>
                        }
                        else
                        {
                            <span>Enabled 的 (<strong>@(scope.Count(t => t.Enabled)) 個</strong>) 設為 Disabled</span>
                        }
                        ，並重新註冊 Quartz scheduler。
                    </p>
                    @if (_bulkEnable)
                    {
                        var autoDisabledInScope = _items?.Where(t => !t.Enabled && t.AutoDisabledAt is not null).ToList() ?? new();
                        if (autoDisabledInScope.Count > 0)
                        {
                            <div class="alert alert-warning small mb-2">
                                <strong>⚠ @autoDisabledInScope.Count 個任務是 auto-disabled，將被跳過。</strong>
                                <ul class="mb-0 mt-1">
                                    @foreach (var t in autoDisabledInScope.Take(8))
                                    {
                                        <li><code>@t.Name</code> — @t.AutoDisabledReason</li>
                                    }
                                </ul>
                                @if (autoDisabledInScope.Count > 8)
                                {
                                    <div class="text-muted mt-1">…還有 @(autoDisabledInScope.Count - 8) 個</div>
                                }
                                <div class="text-muted mt-1">
                                    請至列表逐筆走「我已確認問題已修復」確認流程。
                                </div>
                            </div>
                        }
                    }
                    <p class="small text-muted">每筆變更都會寫進 audit log。執行中的任務不會被中斷，僅影響未來觸發。</p>
                    <label class="form-label">操作理由（建議填寫）</label>
                    <textarea class="form-control" rows="2" @bind="_bulkReason" placeholder="例：來源 DB 維護期間"></textarea>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _showBulk = false" disabled="@_bulkBusy">取消</button>
                    <button class="btn @(_bulkEnable ? "btn-success" : "btn-warning")"
                            @onclick="ConfirmBulk" disabled="@_bulkBusy">
                        @if (_bulkBusy) { <Icon Name="loader" /> <span>套用中…</span> }
                        else { <span>確認</span> }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (_message is not null)
{
    <div class="alert @(_isError ? "alert-danger" : "alert-info")">@_message</div>
}

@if (HasActiveFilter && _items is not null && _filtered is not null)
{
    <div class="alert alert-info py-1 px-2 mb-2 small d-flex flex-wrap align-items-center gap-2">
        <strong>📌 目前篩選</strong>
        <span class="text-muted">(@_filtered.Count / @_items.Count)</span>
        @if (!string.IsNullOrWhiteSpace(_filterName))
        {
            <span class="badge bg-primary">name: @_filterName <button class="btn btn-sm btn-link p-0 text-white ms-1" @onclick='() => ClearFilter("name")'>×</button></span>
        }
        @if (!string.IsNullOrEmpty(_filterEnabled))
        {
            <span class="badge bg-primary">@_filterEnabled <button class="btn btn-sm btn-link p-0 text-white ms-1" @onclick='() => ClearFilter("enabled")'>×</button></span>
        }
        @if (!string.IsNullOrEmpty(_filterSla))
        {
            <span class="badge bg-primary">SLA @_filterSla <button class="btn btn-sm btn-link p-0 text-white ms-1" @onclick='() => ClearFilter("sla")'>×</button></span>
        }
        @if (!string.IsNullOrEmpty(_filterConnection))
        {
            var connName = _connections.FirstOrDefault(c => c.Id.ToString() == _filterConnection)?.Name ?? _filterConnection;
            <span class="badge bg-primary">connection: @connName <button class="btn btn-sm btn-link p-0 text-white ms-1" @onclick='() => ClearFilter("connection")'>×</button></span>
        }
        @if (!string.IsNullOrWhiteSpace(_filterTag))
        {
            <span class="badge bg-primary">tag: @_filterTag <button class="btn btn-sm btn-link p-0 text-white ms-1" @onclick='() => ClearFilter("tag")'>×</button></span>
        }
        <button class="btn btn-sm btn-link p-0 ms-2" @onclick="ClearAllFilters">全部清除</button>
    </div>
}

@if (_items is not null && _items.Count > 5)
{
    <div class="card mb-3">
        <div class="card-body py-2">
            <div class="row g-2 align-items-center">
                <div class="col-md-3">
                    <input class="form-control form-control-sm" placeholder="🔍 任務名稱搜尋…" @bind="_filterName" @bind:after="ApplyFilter" />
                </div>
                <div class="col-md-2">
                    <select class="form-select form-select-sm" @bind="_filterEnabled" @bind:after="ApplyFilter">
                        <option value="">全部狀態</option>
                        <option value="enabled">僅啟用</option>
                        <option value="disabled">僅停用</option>
                        <option value="autodisabled">僅 auto-disabled</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <select class="form-select form-select-sm" @bind="_filterSla" @bind:after="ApplyFilter">
                        <option value="">全部 SLA</option>
                        <option value="bad">SLA &lt; 95%</option>
                        <option value="ok">SLA ≥ 95%</option>
                        <option value="none">尚無資料</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <select class="form-select form-select-sm" @bind="_filterConnection" @bind:after="ApplyFilter">
                        <option value="">全部連線</option>
                        @foreach (var c in _connections)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <input class="form-control form-control-sm" placeholder="🏷 標籤過濾" @bind="_filterTag" @bind:after="ApplyFilter" />
                </div>
                <div class="col-md-1 text-end small text-muted">
                    @(_filtered?.Count ?? 0) / @_items.Count
                </div>
            </div>
        </div>
    </div>
}

@if (_items is null)
{
    <p class="text-muted">載入中…</p>
}
else if (_items.Count == 0)
{
    <div class="empty-state">
        <h3>尚無任務</h3>
        <p>建立第一個 ETL 任務，把資料從來源 A 表搬到目標 B 表。</p>
        <AuthorizeView Roles="Admin,Operator">
            <Authorized>
                <a class="btn btn-primary mt-2" href="tasks/new"><Icon Name="plus" />新增任務</a>
            </Authorized>
        </AuthorizeView>
    </div>
}
else
{
    <div class="card">
    <table class="table mb-0 align-middle">
        <thead>
            <tr>
                <th>名稱</th>
                <th>方向</th>
                <th>模式</th>
                <th>排程</th>
                <th>下次執行</th>
                <th>上次成功</th>
                <th>上次失敗</th>
                <th>SLA (30d)</th>
                <th style="width:80px">趨勢</th>
                <th>啟用</th>
                <th class="text-end">操作</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var t in (_filtered ?? _items))
        {
            <tr>
                <td>
                    <a href="@($"tasks/{t.Id}")" class="fw-medium">@t.Name</a>
                    @{
                        var parentIds = EtlTool.Core.Engine.TaskDependencyChecker.ParseDependsOnIds(t.DependsOnTaskIds);
                    }
                    @if (parentIds.Count > 0)
                    {
                        var parentNames = parentIds
                            .Select(pid => _items!.FirstOrDefault(x => x.Id == pid)?.Name ?? pid.ToString()[..8])
                            .ToList();
                        <span class="badge bg-info text-dark ms-2 border" title="@($"上游任務：{string.Join("、", parentNames)}")" style="cursor:help">↑ @parentIds.Count</span>
                    }
                    @if (!string.IsNullOrEmpty(t.Notes))
                    {
                        <span class="badge bg-light text-dark ms-2 border" title="@t.Notes" style="cursor:help">📝</span>
                    }
                    @if (_pendingTargets.Contains(t.Id))
                    {
                        <span class="badge bg-warning text-dark ms-2" title="此任務已有待覆核的刪除請求">待覆核刪除</span>
                    }
                    @if (t.AutoDisabledAt is not null)
                    {
                        <span class="badge bg-danger ms-2" title="@($"自動停用於 {t.AutoDisabledAt.Value.ToLocalTime():yyyy-MM-dd HH:mm}\n{t.AutoDisabledReason}")">
                            ⛔ 已自動停用
                        </span>
                    }
                </td>
                <td>
                    <code class="text-muted">@t.SourceSchema.@t.SourceTable</code>
                    <Icon Name="arrow-right" Class="text-subtle mx-1" />
                    <code class="text-muted">@t.TargetSchema.@t.TargetTable</code>
                </td>
                <td>
                    <span class="badge @(t.WriteMode == WriteMode.Upsert ? "bg-info" : "bg-primary")">@t.WriteMode</span>
                </td>
                <td>
                    @{
                        var human = EtlTool.Core.Engine.CronHumanizer.Humanize(t.CronExpression);
                    }
                    @if (human is not null)
                    {
                        <span class="small" title="@t.CronExpression">@human</span>
                    }
                    else
                    {
                        <code class="text-muted small">@t.CronExpression</code>
                    }
                </td>
                <td class="small text-muted">
                    @(_nextFire.TryGetValue(t.Id, out var n) && n.HasValue
                        ? n.Value.ToLocalTime().ToString("MM-dd HH:mm")
                        : "—")
                </td>
                <td class="small">
                    @if (_lastSuccess.TryGetValue(t.Id, out var ls))
                    {
                        var ageHours = (DateTime.UtcNow - ls).TotalHours;
                        var ageDays = (int)(ageHours / 24);
                        if (ageHours < 24)
                        {
                            <span class="text-success" title="@ls.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")">@ls.ToLocalTime().ToString("HH:mm")</span>
                        }
                        else if (ageDays <= 7)
                        {
                            <span class="badge bg-warning text-dark" title="@ls.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")">@ageDays 天前</span>
                        }
                        else
                        {
                            <span class="badge bg-danger" title="@ls.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")">⚠ @ageDays 天前</span>
                        }
                    }
                    else
                    {
                        <span class="text-muted">尚未成功</span>
                    }
                </td>
                <td class="small">
                    @if (_sla.TryGetValue(t.Id, out var stats) && stats.Total > 0)
                    {
                        var pct = stats.Success * 100.0 / stats.Total;
                        var cls = pct >= 99 ? "bg-success" : pct >= 95 ? "bg-warning text-dark" : "bg-danger";
                        <span class="badge @cls" title="@($"{stats.Success}/{stats.Total} 次成功（過去 30 天）")">@($"{pct:F0}%")</span>
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </td>
                <td>
                    @{
                        if (_recentRunsByTask.TryGetValue(t.Id, out var recent) && recent.Count > 0)
                        {
                            var maxSec = _recentMaxByTask.TryGetValue(t.Id, out var mx) ? mx : 0;
                            <svg width="76" height="20" viewBox="0 0 76 20" preserveAspectRatio="none" style="display:block">
                            @{
                                var spkN = recent.Count;
                                var barW = spkN > 0 ? Math.Max(1.0, (76.0 - (spkN - 1) * 1) / spkN) : 0;
                            }
                            @for (int i = 0; i < spkN; i++)
                            {
                                var r = recent[i];
                                var sec = r.FinishedAt is null ? 0 : (r.FinishedAt.Value - r.StartedAt).TotalSeconds;
                                var h = maxSec > 0 ? Math.Max(1.5, sec / maxSec * 18) : 1.5;
                                var x = i * (barW + 1);
                                var y = 19 - h;
                                var color = r.Status == RunStatus.Success ? "#10b981" : "#ef4444";
                                <rect x="@x.ToString("F1")" y="@y.ToString("F1")" width="@barW.ToString("F1")" height="@h.ToString("F1")" fill="@color" />
                            }
                            </svg>
                            if (_p95ByTask.TryGetValue(t.Id, out var p95))
                            {
                                var lastDur = recent[^1].FinishedAt is null ? 0 : (recent[^1].FinishedAt!.Value - recent[^1].StartedAt).TotalSeconds;
                                var regression = p95 > 0 && lastDur > 2 * p95;
                                <small class="@(regression ? "text-danger fw-bold" : "text-muted")"
                                       title="@($"p95 = {p95:F0}s；最近一筆 {lastDur:F0}s")">
                                    p95 @($"{p95:F0}")s@(regression ? " ⚠" : "")
                                </small>
                            }
                        }
                        else
                        {
                            <span class="text-muted small">—</span>
                        }
                    }
                </td>
                <td class="small">
                    @if (_lastFailure.TryGetValue(t.Id, out var lf))
                    {
                        var fAgeHours = (DateTime.UtcNow - lf).TotalHours;
                        var fAgeDays = (int)(fAgeHours / 24);
                        if (fAgeHours < 24)
                        {
                            <span class="badge bg-danger" title="@lf.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")">@lf.ToLocalTime().ToString("HH:mm")</span>
                        }
                        else if (fAgeDays <= 7)
                        {
                            <span class="badge bg-warning text-dark" title="@lf.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")">@fAgeDays 天前</span>
                        }
                        else
                        {
                            <span class="text-muted" title="@lf.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")">@fAgeDays 天前</span>
                        }
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </td>
                <td>
                    <AuthorizeView Roles="Admin,Operator" Context="ctx">
                        <Authorized>
                            <div class="form-check form-switch m-0">
                                <input type="checkbox" class="form-check-input" checked="@t.Enabled"
                                       @onchange="e => OnEnableToggle(t, (bool)e.Value!)" />
                            </div>
                        </Authorized>
                        <NotAuthorized>
                            <span class="badge @(t.Enabled ? "bg-success" : "bg-secondary")">@(t.Enabled ? "啟用" : "停用")</span>
                        </NotAuthorized>
                    </AuthorizeView>
                </td>
                <td class="text-end">
                    <div class="row-actions">
                        <AuthorizeView Roles="Admin,Operator" Context="ctx">
                            <Authorized>
                                <button class="icon-btn icon-btn-success" title="立即執行"
                                        @onclick="() => RunNow(t.Id)" disabled="@(_running == t.Id)">
                                    @if (_running == t.Id) { <Icon Name="loader" /> }
                                    else { <Icon Name="play" /> }
                                </button>
                            </Authorized>
                        </AuthorizeView>
                        <a class="icon-btn" title="執行歷史" href="@($"tasks/{t.Id}/runs")"><Icon Name="history" /></a>
                        <AuthorizeView Roles="Admin,Operator" Context="ctx">
                            <Authorized>
                                <a class="icon-btn" title="編輯" href="@($"tasks/{t.Id}")"><Icon Name="edit" /></a>
                                <button class="icon-btn icon-btn-danger" title="送交覆核刪除"
                                        @onclick="() => OpenSubmit(t)"
                                        disabled="@_pendingTargets.Contains(t.Id)">
                                    <Icon Name="trash" />
                                </button>
                            </Authorized>
                        </AuthorizeView>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}

@if (_showSubmit && _submitTarget is not null)
{
    <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title">送交覆核：刪除任務</h5></div>
                <div class="modal-body">
                    <p>
                        將提交「<strong>@_submitTarget.Name</strong>」刪除請求，需另一位 Admin 在 <strong>/approvals</strong> 核准後才會真正刪除。<br />
                        <span class="text-muted small">⛔ 你不能核准自己提交的請求；過期 7 天自動失效。</span>
                    </p>
                    <label class="form-label">原因（建議填寫，會記入稽核）</label>
                    <textarea class="form-control" rows="3" @bind="_reason" placeholder="例：已被 newTask 取代"></textarea>
                    @if (_modalError is not null) { <div class="alert alert-danger mt-2">@_modalError</div> }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _showSubmit = false">取消</button>
                    <button class="btn btn-warning" @onclick="ConfirmSubmit">提交覆核</button>
                </div>
            </div>
        </div>
