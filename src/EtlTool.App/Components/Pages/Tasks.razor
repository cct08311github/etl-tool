@page "/tasks"
@rendermode InteractiveServer
@inject EtlTool.Data.Repositories.EtlTaskRepository TaskRepo
@inject EtlTool.Data.Repositories.ApprovalRepository ApprovalRepo
@inject EtlTool.Data.Repositories.RunHistoryRepository RunHistoryRepo
@inject EtlTool.Core.Scheduling.SchedulerService Scheduler
@inject AuthenticationStateProvider AuthState

<PageTitle>ETL 任務</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="m-0">ETL 任務</h1>
    <div class="d-flex gap-2">
        <AuthorizeView Roles="Admin">
            <Authorized>
                @if (_items is not null && _items.Any(t => !t.Enabled))
                {
                    <button class="btn btn-outline-success" @onclick="() => OpenBulk(true)">
                        <Icon Name="play" /> 批次啟用所有
                    </button>
                }
                @if (_items is not null && _items.Any(t => t.Enabled))
                {
                    <button class="btn btn-outline-warning" @onclick="() => OpenBulk(false)">
                        <Icon Name="pause" /> 批次停用所有
                    </button>
                }
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Roles="Admin,Operator">
            <Authorized>
                <a class="btn btn-primary" href="tasks/new">
                    <Icon Name="plus" />新增任務
                </a>
            </Authorized>
        </AuthorizeView>
    </div>
</div>

@if (_showReEnable && _reEnableTask is not null)
{
    <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">⛔ 此任務已被 circuit-breaker 自動停用</h5>
                </div>
                <div class="modal-body">
                    <p>
                        任務 <strong>@_reEnableTask.Name</strong> 在
                        <code>@_reEnableTask.AutoDisabledAt?.ToLocalTime():yyyy-MM-dd HH:mm</code>
                        被系統自動停用。
                    </p>
                    @if (!string.IsNullOrEmpty(_reEnableTask.AutoDisabledReason))
                    {
                        <div class="alert alert-warning small">
                            <strong>原因：</strong> @_reEnableTask.AutoDisabledReason
                        </div>
                    }
                    <p>請先確認問題已修復（連線、資料來源、過濾條件等），再啟用此任務。</p>
                    <p class="small text-muted">啟用後將清除 auto-disabled 標記並重新加入 scheduler。</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _showReEnable = false">取消</button>
                    <button class="btn btn-warning" @onclick="ConfirmReEnable">我已確認問題已修復，啟用</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showBulk)
{
    <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(_bulkEnable ? "批次啟用所有任務" : "批次停用所有任務")</h5>
                </div>
                <div class="modal-body">
                    <p>
                        將把
                        @if (_bulkEnable)
                        {
                            <span><strong>所有 Disabled 任務 (@(_items?.Count(t => !t.Enabled) ?? 0) 個)</strong> 設為 Enabled</span>
                        }
                        else
                        {
                            <span><strong>所有 Enabled 任務 (@(_items?.Count(t => t.Enabled) ?? 0) 個)</strong> 設為 Disabled</span>
                        }
                        ，並重新註冊 Quartz scheduler。
                    </p>
                    @if (_bulkEnable)
                    {
                        var autoDisabledInScope = _items?.Where(t => !t.Enabled && t.AutoDisabledAt is not null).ToList() ?? new();
                        if (autoDisabledInScope.Count > 0)
                        {
                            <div class="alert alert-warning small mb-2">
                                <strong>⚠ @autoDisabledInScope.Count 個任務是 auto-disabled，將被跳過。</strong>
                                <ul class="mb-0 mt-1">
                                    @foreach (var t in autoDisabledInScope.Take(8))
                                    {
                                        <li><code>@t.Name</code> — @t.AutoDisabledReason</li>
                                    }
                                </ul>
                                @if (autoDisabledInScope.Count > 8)
                                {
                                    <div class="text-muted mt-1">…還有 @(autoDisabledInScope.Count - 8) 個</div>
                                }
                                <div class="text-muted mt-1">
                                    請至列表逐筆走「我已確認問題已修復」確認流程。
                                </div>
                            </div>
                        }
                    }
                    <p class="small text-muted">每筆變更都會寫進 audit log。執行中的任務不會被中斷，僅影響未來觸發。</p>
                    <label class="form-label">操作理由（建議填寫）</label>
                    <textarea class="form-control" rows="2" @bind="_bulkReason" placeholder="例：來源 DB 維護期間"></textarea>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _showBulk = false" disabled="@_bulkBusy">取消</button>
                    <button class="btn @(_bulkEnable ? "btn-success" : "btn-warning")"
                            @onclick="ConfirmBulk" disabled="@_bulkBusy">
                        @if (_bulkBusy) { <Icon Name="loader" /> <span>套用中…</span> }
                        else { <span>確認</span> }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (_message is not null)
{
    <div class="alert @(_isError ? "alert-danger" : "alert-info")">@_message</div>
}

@if (_items is null)
{
    <p class="text-muted">載入中…</p>
}
else if (_items.Count == 0)
{
    <div class="empty-state">
        <h3>尚無任務</h3>
        <p>建立第一個 ETL 任務，把資料從來源 A 表搬到目標 B 表。</p>
        <AuthorizeView Roles="Admin,Operator">
            <Authorized>
                <a class="btn btn-primary mt-2" href="tasks/new"><Icon Name="plus" />新增任務</a>
            </Authorized>
        </AuthorizeView>
    </div>
}
else
{
    <div class="card">
    <table class="table mb-0 align-middle">
        <thead>
            <tr>
                <th>名稱</th>
                <th>方向</th>
                <th>模式</th>
                <th>排程</th>
                <th>下次執行</th>
                <th>上次成功</th>
                <th>啟用</th>
                <th class="text-end">操作</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var t in _items)
        {
            <tr>
                <td>
                    <a href="@($"tasks/{t.Id}")" class="fw-medium">@t.Name</a>
                    @if (_pendingTargets.Contains(t.Id))
                    {
                        <span class="badge bg-warning text-dark ms-2" title="此任務已有待覆核的刪除請求">待覆核刪除</span>
                    }
                    @if (t.AutoDisabledAt is not null)
                    {
                        <span class="badge bg-danger ms-2" title="@($"自動停用於 {t.AutoDisabledAt.Value.ToLocalTime():yyyy-MM-dd HH:mm}\n{t.AutoDisabledReason}")">
                            ⛔ 已自動停用
                        </span>
                    }
                </td>
                <td>
                    <code class="text-muted">@t.SourceSchema.@t.SourceTable</code>
                    <Icon Name="arrow-right" Class="text-subtle mx-1" />
                    <code class="text-muted">@t.TargetSchema.@t.TargetTable</code>
                </td>
                <td>
                    <span class="badge @(t.WriteMode == WriteMode.Upsert ? "bg-info" : "bg-primary")">@t.WriteMode</span>
                </td>
                <td><code class="text-muted small">@t.CronExpression</code></td>
                <td class="small text-muted">
                    @(_nextFire.TryGetValue(t.Id, out var n) && n.HasValue
                        ? n.Value.ToLocalTime().ToString("MM-dd HH:mm")
                        : "—")
                </td>
                <td>
                    <AuthorizeView Roles="Admin,Operator" Context="ctx">
                        <Authorized>
                            <div class="form-check form-switch m-0">
                                <input type="checkbox" class="form-check-input" checked="@t.Enabled"
                                       @onchange="e => OnEnableToggle(t, (bool)e.Value!)" />
                            </div>
                        </Authorized>
                        <NotAuthorized>
                            <span class="badge @(t.Enabled ? "bg-success" : "bg-secondary")">@(t.Enabled ? "啟用" : "停用")</span>
                        </NotAuthorized>
                    </AuthorizeView>
                </td>
                <td class="text-end">
                    <div class="row-actions">
                        <AuthorizeView Roles="Admin,Operator" Context="ctx">
                            <Authorized>
                                <button class="icon-btn icon-btn-success" title="立即執行"
                                        @onclick="() => RunNow(t.Id)" disabled="@(_running == t.Id)">
                                    @if (_running == t.Id) { <Icon Name="loader" /> }
                                    else { <Icon Name="play" /> }
                                </button>
                            </Authorized>
                        </AuthorizeView>
                        <a class="icon-btn" title="執行歷史" href="@($"tasks/{t.Id}/runs")"><Icon Name="history" /></a>
                        <AuthorizeView Roles="Admin,Operator" Context="ctx">
                            <Authorized>
                                <a class="icon-btn" title="編輯" href="@($"tasks/{t.Id}")"><Icon Name="edit" /></a>
                                <button class="icon-btn icon-btn-danger" title="送交覆核刪除"
                                        @onclick="() => OpenSubmit(t)"
                                        disabled="@_pendingTargets.Contains(t.Id)">
                                    <Icon Name="trash" />
                                </button>
                            </Authorized>
                        </AuthorizeView>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}

@if (_showSubmit && _submitTarget is not null)
{
    <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title">送交覆核：刪除任務</h5></div>
                <div class="modal-body">
                    <p>
                        將提交「<strong>@_submitTarget.Name</strong>」刪除請求，需另一位 Admin 在 <strong>/approvals</strong> 核准後才會真正刪除。<br />
                        <span class="text-muted small">⛔ 你不能核准自己提交的請求；過期 7 天自動失效。</span>
                    </p>
                    <label class="form-label">原因（建議填寫，會記入稽核）</label>
                    <textarea class="form-control" rows="3" @bind="_reason" placeholder="例：已被 newTask 取代"></textarea>
                    @if (_modalError is not null) { <div class="alert alert-danger mt-2">@_modalError</div> }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _showSubmit = false">取消</button>
                    <button class="btn btn-warning" @onclick="ConfirmSubmit">提交覆核</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<EtlTool.Core.Models.EtlTask>? _items;
    private Dictionary<Guid, DateTimeOffset?> _nextFire = new();
    private Dictionary<Guid, DateTime> _lastSuccess = new();
    private HashSet<Guid> _pendingTargets = new();
    private Guid? _running;
    private string? _currentUsername;
    private string? _message;
    private bool _isError;

    private bool _showSubmit;
    private EtlTool.Core.Models.EtlTask? _submitTarget;
    private string _reason = "";
    private string? _modalError;

    private bool _showBulk;
    private bool _bulkEnable;
    private bool _bulkBusy;
    private string _bulkReason = "";

    private bool _showReEnable;
    private EtlTool.Core.Models.EtlTask? _reEnableTask;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _currentUsername = state.User.Identity?.Name;
        await Reload();
    }

    private async Task Reload()
    {
        var ct = CancellationToken.None;
        _items = await TaskRepo.ListLightweightAsync(ct);
        _nextFire.Clear();
        foreach (var t in _items)
        {
            try { _nextFire[t.Id] = await Scheduler.GetNextFireTimeAsync(t.Id, ct); }
            catch { _nextFire[t.Id] = null; }
        }
        _lastSuccess = await RunHistoryRepo.LastSuccessByTaskAsync(ct);
        var pending = await ApprovalRepo.ListPendingAsync(ct);
        _pendingTargets = pending
            .Where(p => p.Action == ApprovalAction.DeleteTask)
            .Select(p => p.TargetId)
            .ToHashSet();
    }

    private async Task OnEnableToggle(EtlTool.Core.Models.EtlTask task, bool enabled)
    {
        // 從 disabled 變回 enabled，且是 auto-disabled → 走 confirm 流程；其他直接執行
        if (enabled && task.AutoDisabledAt is not null)
        {
            _reEnableTask = task;
            _showReEnable = true;
            // 把 UI 開關 revert 回 false（因為實際還沒套用）— 用 StateHasChanged 重繪
            StateHasChanged();
            return;
        }
        await ApplyEnable(task, enabled);
    }

    private async Task ApplyEnable(EtlTool.Core.Models.EtlTask task, bool enabled)
    {
        task.Enabled = enabled;
        var full = await TaskRepo.GetWithMappingsAsync(task.Id, CancellationToken.None);
        if (full is null) return;
        full.Enabled = enabled;
        await TaskRepo.UpdateAsync(full, CancellationToken.None, actor: _currentUsername);
        await Scheduler.RescheduleAsync(task.Id, CancellationToken.None);
        await Reload();
    }

    private async Task ConfirmReEnable()
    {
        if (_reEnableTask is null) return;
        var t = _reEnableTask;
        _showReEnable = false;
        _reEnableTask = null;
        await ApplyEnable(t, true);
        _isError = false;
        _message = $"任務「{t.Name}」已重新啟用，auto-disable 標記已清除。";
    }

    private async Task RunNow(Guid id)
    {
        _running = id;
        _message = null;
        try
        {
            await Scheduler.TriggerNowAsync(id, CancellationToken.None);
            _isError = false;
            _message = "已觸發手動執行，請至「歷史」查看結果。";
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = $"觸發失敗：{ex.Message}";
        }
        finally
        {
            _running = null;
        }
    }

    private void OpenSubmit(EtlTool.Core.Models.EtlTask t)
    {
        _submitTarget = t;
        _reason = "";
        _modalError = null;
        _showSubmit = true;
    }

    private void OpenBulk(bool enable)
    {
        _bulkEnable = enable;
        _bulkReason = "";
        _showBulk = true;
    }

    private async Task ConfirmBulk()
    {
        if (_items is null || _currentUsername is null) return;
        _bulkBusy = true;
        try
        {
            var ct = CancellationToken.None;
            var targets = _items.Where(t => t.Enabled != _bulkEnable).ToList();

            // 批次「啟用」時，跳過 auto-disabled 任務（避免無腦把壞掉的 task 重新打開）
            // — admin 必須走逐筆 re-enable 確認流程
            var skipped = new List<EtlTool.Core.Models.EtlTask>();
            if (_bulkEnable)
            {
                skipped = targets.Where(t => t.AutoDisabledAt is not null).ToList();
                targets = targets.Where(t => t.AutoDisabledAt is null).ToList();
            }

            int changed = 0;
            foreach (var t in targets)
            {
                var full = await TaskRepo.GetWithMappingsAsync(t.Id, ct);
                if (full is null) continue;
                full.Enabled = _bulkEnable;
                await TaskRepo.UpdateAsync(full, ct, actor: _currentUsername);
                await Scheduler.RescheduleAsync(t.Id, ct);
                changed++;
            }
            _showBulk = false;
            _isError = false;
            var msg = $"批次{(_bulkEnable ? "啟用" : "停用")}已套用，共 {changed} 個任務";
            if (skipped.Count > 0)
            {
                msg += $"。略過 {skipped.Count} 個 auto-disabled 任務（請逐筆走 re-enable 確認）：" +
                       string.Join("、", skipped.Take(5).Select(t => t.Name)) +
                       (skipped.Count > 5 ? $" …+{skipped.Count - 5}" : "");
            }
            if (!string.IsNullOrWhiteSpace(_bulkReason)) msg += $"（理由：{_bulkReason}）";
            _message = msg;
            await Reload();
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = $"批次操作失敗：{ex.Message}";
        }
        finally
        {
            _bulkBusy = false;
        }
    }

    private async Task ConfirmSubmit()
    {
        if (_submitTarget is null || _currentUsername is null) return;
        _modalError = null;
        try
        {
            await ApprovalRepo.SubmitAsync(
                ApprovalAction.DeleteTask,
                targetType: nameof(EtlTool.Core.Models.EtlTask),
                targetId: _submitTarget.Id,
                targetName: _submitTarget.Name,
                submittedBy: _currentUsername,
                reason: string.IsNullOrWhiteSpace(_reason) ? null : _reason,
                ct: CancellationToken.None);
            _showSubmit = false;
            _isError = false;
            _message = $"已提交「{_submitTarget.Name}」刪除請求，請通知另一位 Admin 至 /approvals 核准。";
            await Reload();
        }
        catch (Exception ex)
        {
            _modalError = ex.Message;
        }
    }
}
