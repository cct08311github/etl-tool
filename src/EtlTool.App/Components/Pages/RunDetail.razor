@page "/runs/{Id:guid}"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@inject EtlTool.Data.Repositories.RunHistoryRepository RunRepo
@inject EtlTool.Data.Repositories.EtlTaskRepository TaskRepo
@inject EtlTool.Data.AppDbContext Db
@inject EtlTool.Core.Scheduling.SchedulerService Scheduler

<PageTitle>執行詳情</PageTitle>

@if (_run is null)
{
    <p>載入中...</p>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="m-0">執行詳情</h1>
        <div class="d-flex gap-2">
            <AuthorizeView Roles="Admin,Operator">
                <Authorized>
                    <button class="btn btn-outline-success btn-sm" @onclick="Rerun" disabled="@_rerunBusy"
                            title="再跑一次此 task（手動觸發；繞過 maintenance window 與 dependency check）">
                        @if (_rerunBusy) { <Icon Name="loader" /> } else { <Icon Name="play" /> }
                        <span class="ms-1">再跑一次</span>
                    </button>
                </Authorized>
            </AuthorizeView>
            <a class="btn btn-link btn-sm" href="@($"tasks/{_run.EtlTaskId}/runs")">← 返回此任務歷史</a>
        </div>
    </div>
    @if (_rerunMessage is not null)
    {
        <div class="alert @(_rerunError ? "alert-danger" : "alert-success") small">@_rerunMessage</div>
    }

    <div class="card mb-3">
        <div class="card-body">
            <table class="kv-table">
                <tr><th>任務</th><td><a href="@($"tasks/{_run.EtlTaskId}")">@(_taskName ?? _run.EtlTaskId.ToString())</a></td></tr>
                <tr><th>Run Id</th><td><code>@_run.Id</code></td></tr>
                <tr><th>開始時間</th><td><span class="font-monospace">@_run.StartedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</span></td></tr>
                <tr><th>結束時間</th><td><span class="font-monospace">@(_run.FinishedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "—")</span></td></tr>
                <tr><th>耗時</th><td>@(_run.FinishedAt is null ? "—" : (_run.FinishedAt.Value - _run.StartedAt).ToString(@"hh\:mm\:ss"))</td></tr>
                <tr><th>狀態</th><td><RunStatusBadge Status="@_run.Status" /></td></tr>
                <tr><th>觸發類型</th><td>@_run.TriggerType</td></tr>
                <tr><th>讀取筆數</th><td>@_run.RowsRead</td></tr>
                <tr><th>寫入筆數</th><td>@_run.RowsWritten</td></tr>
                <tr><th>吞吐 (rows/sec)</th>
                    <td>
                        @{
                            var dur = _run.FinishedAt is null ? TimeSpan.Zero : (_run.FinishedAt.Value - _run.StartedAt);
                            var totalRows = _run.RowsRead + _run.RowsWritten;
                        }
                        @if (dur.TotalSeconds < 0.5 || totalRows == 0)
                        {
                            <span class="text-muted">—</span>
                        }
                        else
                        {
                            var rps = totalRows / dur.TotalSeconds;
                            <span class="font-monospace">@($"{rps:F0}")</span>
                            <small class="text-muted ms-2">
                                ({totalRows} 筆 / @($"{dur.TotalSeconds:F1}") 秒
                                ；讀取 @_run.RowsRead / 寫入 @_run.RowsWritten)
                            </small>
                        }
                    </td>
                </tr>
            </table>
        </div>
    </div>

    @* 對應的 audit log 入口（依時間 + targetId 配對；通常 RunSucceeded / RunFailed 會落在這裡） *@
    @if (_relatedAudits is not null && _relatedAudits.Count > 0)
    {
        <div class="card mb-3">
            <div class="card-header">關聯稽核事件 (@_relatedAudits.Count)</div>
            <table class="table mb-0 small align-middle">
                <thead>
                    <tr>
                        <th style="width: 160px">At (UTC)</th>
                        <th style="width: 120px">Action</th>
                        <th>Message</th>
                        <th style="width: 100px">Severity</th>
                        <th style="width: 70px">Hash</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var a in _relatedAudits)
                {
                    <tr>
                        <td class="font-monospace text-muted">@a.At.ToString("MM-dd HH:mm:ss")</td>
                        <td><span class="text-muted">@a.Action</span></td>
                        <td>@a.Message</td>
                        <td><SeverityBadge Severity="@a.Severity" /></td>
                        <td>
                            <code class="small text-muted" title="@a.Hash">@(a.Hash is null ? "—" : a.Hash[..8])</code>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
            <div class="card-footer small text-muted">
                以 hash 串接的稽核鏈紀錄；
                <a href="/logs">活動日誌</a> 內可驗證完整性。
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(_run.ErrorMessage))
    {
        <div class="card mb-3 border-danger">
            <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
                <span>錯誤訊息</span>
                <div>
                    <span class="badge @ErrorBadgeBg() me-1" title="@(_classification?.Reason ?? "")">
                        @ErrorBadgeIcon() @EtlTool.Core.Engine.EngineErrorClassifier.ClassLabel(_classification!.Class)
                    </span>
                    @if (_classification.Subkind != EtlTool.Core.Engine.EngineErrorClassifier.EngineErrorSubkind.Unknown)
                    {
                        <span class="badge bg-light text-dark">
                            @EtlTool.Core.Engine.EngineErrorClassifier.SubkindLabel(_classification.Subkind)
                        </span>
                    }
                </div>
            </div>
            @if (_classification.Class == EtlTool.Core.Engine.EngineErrorClassifier.EngineErrorClass.Permanent)
            {
                <div class="card-body py-2 small bg-danger-subtle text-danger-emphasis border-bottom">
                    <strong>判斷：</strong> @_classification.Reason — 重試此類錯誤通常無效，應由 ops 處理（修密碼 / 補權限 / 修 SQL / 補表）後再執行。
                </div>
            }
            else if (_classification.Class == EtlTool.Core.Engine.EngineErrorClassifier.EngineErrorClass.Transient)
            {
                <div class="card-body py-2 small bg-warning-subtle text-warning-emphasis border-bottom">
                    <strong>判斷：</strong> @_classification.Reason — 通常重試會通；此 run 為最後一次嘗試。
                </div>
            }
            <div class="card-body">
                <pre class="mb-0">@_run.ErrorMessage</pre>
            </div>
        </div>
    }

    @* Schema drift visualization：若這個 run 的 task 有快照，顯示與目前實際 schema 的對照 *@
    @if (_schemaSnapshot is not null && _schemaSnapshot.Count > 0)
    {
        <div class="card mb-3">
            <div class="card-header">來源 schema 快照（這次 run 對照基準）</div>
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>欄位名</th>
                        <th>型別 (snapshot)</th>
                        <th>Nullable</th>
                        <th>PII?</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var c in _schemaSnapshot)
                {
                    var pii = EtlTool.Core.Engine.PiiDetector.Inspect(c.Name);
                    <tr>
                        <td><code>@c.Name</code></td>
                        <td><code class="small text-muted">@c.DataType</code></td>
                        <td class="small text-muted">@(c.Nullable ? "yes" : "no")</td>
                        <td>
                            @if (pii.Kind != EtlTool.Core.Engine.PiiDetector.PiiKind.None)
                            {
                                <span class="badge bg-warning text-dark" title="@pii.Reason">
                                    🔒 @EtlTool.Core.Engine.PiiDetector.KindLabel(pii.Kind)
                                </span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }

    @if (!string.IsNullOrEmpty(_run.GeneratedReadSql))
    {
        <div class="card mb-3">
            <div class="card-header">讀取 SQL</div>
            <div class="card-body">
                <pre class="mb-0">@_run.GeneratedReadSql</pre>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(_run.GeneratedWriteSql))
    {
        <div class="card mb-3">
            <div class="card-header">寫入 SQL</div>
            <div class="card-body">
                <pre class="mb-0">@_run.GeneratedWriteSql</pre>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(_run.SamplePayloadJson))
    {
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Sample payload (前 5 筆)</span>
                @if (_maskedColumns is not null && _maskedColumns.Length > 0)
                {
                    <span class="badge bg-warning text-dark" title="基於欄位名 PII 啟發式偵測自動遮罩；MaskAll 模式則為任務設定">
                        🔒 已遮罩 @_maskedColumns.Length 欄（@_maskMode）
                    </span>
                }
            </div>
            @if (_maskedColumns is not null && _maskedColumns.Length > 0)
            {
                <div class="card-body py-2 small text-muted border-bottom">
                    自動遮罩欄位（PII 偵測命中或 MaskAll 模式）：
                    @foreach (var c in _maskedColumns)
                    {
                        <code class="me-1">@c</code>
                    }
                </div>
            }
            <div class="card-body">
                <pre class="mb-0">@_displaySampleJson</pre>
            </div>
        </div>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }
    private EtlTool.Core.Models.RunHistory? _run;
    private string? _taskName;
    private bool _rerunBusy;
    private string? _rerunMessage;
    private bool _rerunError;

    private async Task Rerun()
    {
        if (_run is null) return;
        _rerunBusy = true;
        _rerunMessage = null;
        try
        {
            await Scheduler.TriggerNowAsync(_run.EtlTaskId, CancellationToken.None);
            _rerunError = false;
            _rerunMessage = $"已觸發手動執行任務「{_taskName ?? _run.EtlTaskId.ToString()}」。可至執行歷史查看新一筆 run。";
        }
        catch (Exception ex)
        {
            _rerunError = true;
            _rerunMessage = $"觸發失敗：{ex.Message}";
        }
        finally
        {
            _rerunBusy = false;
        }
    }
    private List<EtlTool.Core.Models.AuditEvent>? _relatedAudits;
    private List<EtlTool.Core.Models.ColumnInfo>? _schemaSnapshot;

    // 錯誤分類（OnInitializedAsync 載 _run 後填）— 給 header badge 用
    private EtlTool.Core.Engine.EngineErrorClassifier.Classification? _classification;

    private string ErrorBadgeBg() => _classification?.Class switch
    {
        EtlTool.Core.Engine.EngineErrorClassifier.EngineErrorClass.Transient => "bg-warning text-dark",
        EtlTool.Core.Engine.EngineErrorClassifier.EngineErrorClass.Permanent => "bg-danger",
        _ => "bg-secondary",
    };

    private string ErrorBadgeIcon() => _classification?.Class switch
    {
        EtlTool.Core.Engine.EngineErrorClassifier.EngineErrorClass.Transient => "🔁",
        EtlTool.Core.Engine.EngineErrorClassifier.EngineErrorClass.Permanent => "🛑",
        _ => "❓",
    };

    // Parsed sample payload metadata (populated in OnInitializedAsync after _run loaded).
    // SamplePayloadJson 在 EtlEngine 端有兩種格式：
    //   - 舊／無遮罩：純 JSON array of row objects
    //   - 有遮罩：{ rows: [...], meta: { maskedColumns: [...], mode: "SmartMaskPii"|"MaskAll" } }
    // 解析失敗時退回原 raw JSON，UI 還是會 render，只是不顯示 meta header。
    private string[]? _maskedColumns;
    private string? _maskMode;
    private string? _displaySampleJson;

    private void ParseSamplePayload()
    {
        if (_run is null || string.IsNullOrEmpty(_run.SamplePayloadJson))
        {
            _displaySampleJson = _run?.SamplePayloadJson;
            return;
        }
        _displaySampleJson = _run.SamplePayloadJson; // default fallback
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(_run.SamplePayloadJson);
            var root = doc.RootElement;
            if (root.ValueKind == System.Text.Json.JsonValueKind.Object &&
                root.TryGetProperty("rows", out var rowsEl) &&
                root.TryGetProperty("meta", out var metaEl))
            {
                if (metaEl.TryGetProperty("maskedColumns", out var mcEl) &&
                    mcEl.ValueKind == System.Text.Json.JsonValueKind.Array)
                {
                    _maskedColumns = mcEl.EnumerateArray()
                        .Select(e => e.GetString() ?? "")
                        .Where(s => s.Length > 0).ToArray();
                }
                if (metaEl.TryGetProperty("mode", out var modeEl))
                {
                    _maskMode = modeEl.GetString();
                }
                _displaySampleJson = System.Text.Json.JsonSerializer.Serialize(rowsEl,
                    new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
            }
            // 舊格式（純 array）→ _maskedColumns 留 null，原 raw 直接顯示
        }
        catch
        {
            // 解析失敗 → 原 raw 顯示
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var ct = CancellationToken.None;
        _run = await RunRepo.GetAsync(Id, ct);
        if (_run is null) return;
        ParseSamplePayload();

        if (!string.IsNullOrEmpty(_run.ErrorMessage))
        {
            _classification = EtlTool.Core.Engine.EngineErrorClassifier.Classify(
                new Exception(_run.ErrorMessage));
        }

        var t = await TaskRepo.GetWithMappingsAsync(_run.EtlTaskId, ct);
        _taskName = t?.Name;

        // 找 audit events：targetId == taskId AND At in [run.StartedAt - 5s, run.FinishedAt + 5s]
        var fromUtc = _run.StartedAt.AddSeconds(-5);
        var toUtc = (_run.FinishedAt ?? DateTime.UtcNow).AddSeconds(5);
        _relatedAudits = await Db.AuditEvents
            .AsNoTracking()
            .Where(e => e.TargetId == _run.EtlTaskId && e.At >= fromUtc && e.At <= toUtc)
            .OrderBy(e => e.At)
            .ToListAsync(ct);

        // schema snapshot 解析（如果有的話）
        if (t is not null && !string.IsNullOrEmpty(t.SourceSchemaSnapshotJson))
        {
            try
            {
                _schemaSnapshot = System.Text.Json.JsonSerializer
                    .Deserialize<List<EtlTool.Core.Models.ColumnInfo>>(t.SourceSchemaSnapshotJson);
            }
            catch { /* 解析失敗就不顯示 */ }
        }
    }
}
