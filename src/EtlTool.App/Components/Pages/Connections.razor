@page "/connections"
@rendermode InteractiveServer
@inject EtlTool.Data.Repositories.ConnectionRepository ConnRepo
@inject EtlTool.Data.Repositories.ApprovalRepository ApprovalRepo
@inject EtlTool.Core.Connectors.IDbConnectorFactory ConnectorFactory
@inject EtlTool.Core.Connectors.IConnectionStringProtector Protector
@inject EtlTool.Core.Engine.IAuditLogger AuditLogger
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<PageTitle>連線管理</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="m-0">連線管理</h1>
    <div class="d-flex gap-2">
        <AuthorizeView Roles="Admin">
            <Authorized>
                <button class="btn btn-outline-primary" @onclick="TestAllConnections" disabled="@_bulkTesting">
                    @if (_bulkTesting) { <Icon Name="loader" /> <span>測試中…</span> }
                    else { <Icon Name="check-circle" /> <span>測試全部連線</span> }
                </button>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Roles="Admin,Operator">
            <Authorized>
                <a class="btn btn-primary" href="connections/new"><Icon Name="plus" />新增連線</a>
            </Authorized>
        </AuthorizeView>
    </div>
</div>

@if (_message is not null)
{
    <div class="alert @(_isError ? "alert-danger" : "alert-info")">@_message</div>
}

@if (_bulkResult is not null && _bulkResult.Count > 0)
{
    <div class="card mb-3">
        <div class="card-header">批次測試結果</div>
        <table class="table table-sm mb-0">
            <thead>
                <tr><th>連線</th><th style="width:90px">結果</th><th>細節</th></tr>
            </thead>
            <tbody>
            @foreach (var r in _bulkResult)
            {
                <tr>
                    <td><code>@r.Name</code></td>
                    <td>
                        @if (r.Ok)
                        {
                            <span class="badge bg-success">✓ 通過</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">⚠ 失敗</span>
                        }
                    </td>
                    <td class="small text-muted">@(r.Detail ?? "—")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@if (_items is null)
{
    <p class="text-muted">載入中…</p>
}
else if (_items.Count == 0)
{
    <div class="empty-state">
        <h3>尚無連線</h3>
        <p>先建立 Oracle 或 SQL Server 連線，再回頭建任務。</p>
        <AuthorizeView Roles="Admin,Operator">
            <Authorized>
                <a class="btn btn-primary mt-2" href="connections/new"><Icon Name="plus" />新增連線</a>
            </Authorized>
        </AuthorizeView>
    </div>
}
else
{
    <div class="card">
    <table class="table mb-0 align-middle">
        <thead>
            <tr>
                <th>名稱</th>
                <th>類型</th>
                <th>健康狀態</th>
                <th>連線字串更新</th>
                <th>建立時間</th>
                <th class="text-end">操作</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var c in _items)
        {
            <tr>
                <td>
                    <a href="@($"connections/{c.Id}")" class="fw-medium">
                        <Icon Name="database" Class="text-subtle me-2" />@c.Name
                    </a>
                    @if (_pendingTargets.Contains(c.Id))
                    {
                        <span class="badge bg-warning text-dark ms-2" title="此連線已有待覆核的刪除請求">待覆核刪除</span>
                    }
                </td>
                <td>
                    <span class="badge bg-primary">@c.ProviderType</span>
                </td>
                <td>
                    @if (c.LastCheckedAt is null)
                    {
                        <span class="badge bg-warning" title="尚未檢查">未檢查</span>
                    }
                    else if (c.LastCheckOk == true)
                    {
                        <span class="badge bg-success" title="@($"上次檢查 {c.LastCheckedAt.Value.ToLocalTime():yyyy-MM-dd HH:mm:ss}")">正常</span>
                        <small class="text-muted ms-1">@FormatRelative(c.LastCheckedAt.Value)</small>
                    }
                    else
                    {
                        <span class="badge bg-danger" title="@(c.LastCheckError ?? "")">失敗</span>
                        <small class="text-muted ms-1">@FormatRelative(c.LastCheckedAt.Value)</small>
                    }
                </td>
                <td class="small">
                    @{
                        var ageDays = (int)(DateTime.UtcNow - c.UpdatedAt).TotalDays;
                    }
                    @if (ageDays >= RotationWarnDays)
                    {
                        <span class="badge bg-danger" title="@($"上次更新 {c.UpdatedAt.ToLocalTime():yyyy-MM-dd}，建議定期輪替")">
                            <Icon Name="alert-triangle" /> @ageDays 天
                        </span>
                    }
                    else if (ageDays >= RotationSoftDays)
                    {
                        <span class="badge bg-warning text-dark" title="@($"上次更新 {c.UpdatedAt.ToLocalTime():yyyy-MM-dd}")">
                            @ageDays 天
                        </span>
                    }
                    else
                    {
                        <span class="text-muted">@(ageDays == 0 ? "今日" : $"{ageDays} 天前")</span>
                    }
                </td>
                <td class="small text-muted">@c.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                <td class="text-end">
                    <AuthorizeView Roles="Admin,Operator" Context="ctx">
                        <Authorized>
                            <div class="row-actions">
                                <a class="icon-btn" title="查看使用此連線的所有任務" href="@($"tasks?connection={c.Id}")">
                                    <Icon Name="list-checks" />
                                </a>
                                <button class="icon-btn" title="立即測試連線"
                                        @onclick="() => QuickTest(c)" disabled="@(_testingId == c.Id)">
                                    @if (_testingId == c.Id) { <Icon Name="loader" /> }
                                    else { <Icon Name="check-circle" /> }
                                </button>
                                <a class="icon-btn" title="編輯" href="@($"connections/{c.Id}")"><Icon Name="edit" /></a>
                                <button class="icon-btn" title="複製為新連線（dev↔prod 同一機房常見場景）"
                                        @onclick="() => OpenClone(c)">
                                    <Icon Name="copy" />
                                </button>
                                <a class="icon-btn" title="變更歷史" href="@($"connections/{c.Id}/history")"><Icon Name="history" /></a>
                                <button class="icon-btn icon-btn-danger" title="送交覆核刪除"
                                        @onclick="() => OpenSubmit(c)"
                                        disabled="@_pendingTargets.Contains(c.Id)">
                                    <Icon Name="trash" />
                                </button>
                            </div>
                        </Authorized>
                    </AuthorizeView>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}

@if (_showClone && _cloneSource is not null)
{
    <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title">複製連線：@_cloneSource.Name</h5></div>
                <div class="modal-body">
                    <p class="small text-muted">
                        以現有連線為範本建立新連線，同一連線字串、同樣 provider。
                        新連線名稱必須唯一。建立後可至「編輯」頁面修改 host / 帳密 / DB。
                    </p>
                    <label class="form-label">新連線名稱</label>
                    <input class="form-control" @bind="_cloneName" placeholder="例：@(_cloneSource.Name)-staging" />
                    @if (_cloneError is not null)
                    {
                        <div class="alert alert-danger mt-2 small">@_cloneError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _showClone = false" disabled="@_cloneBusy">取消</button>
                    <button class="btn btn-primary" @onclick="ConfirmClone" disabled="@_cloneBusy">建立副本</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showSubmit && _submitTarget is not null)
{
    <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title">送交覆核：刪除連線</h5></div>
                <div class="modal-body">
                    <p>
                        將提交「<strong>@_submitTarget.Name</strong>」刪除請求，需另一位 Admin 在 <strong>/approvals</strong> 核准後才會真正刪除。<br />
                        <span class="text-muted small">⛔ 你不能核准自己提交的請求。</span>
                    </p>
                    <label class="form-label">原因（建議填寫，會記入稽核）</label>
                    <textarea class="form-control" rows="3" @bind="_reason" placeholder="例：已停用且 90 天未使用"></textarea>
                    @if (_modalError is not null) { <div class="alert alert-danger mt-2">@_modalError</div> }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _showSubmit = false">取消</button>
                    <button class="btn btn-warning" @onclick="ConfirmSubmit">提交覆核</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // 銀行控管：建議連線字串密碼定期輪替（90 天黃，180 天紅警告）
    private const int RotationSoftDays = 90;
    private const int RotationWarnDays = 180;

    private List<EtlTool.Core.Models.ConnectionDefinition>? _items;
    private HashSet<Guid> _pendingTargets = new();
    private string? _currentUsername;
    private string? _message;
    private bool _isError;

    private bool _showSubmit;
    private EtlTool.Core.Models.ConnectionDefinition? _submitTarget;
    private string _reason = "";
    private string? _modalError;

    private Guid? _testingId;
    private bool _bulkTesting;
    private List<(string Name, bool Ok, string? Detail)>? _bulkResult;

    private bool _showClone;
    private bool _cloneBusy;
    private EtlTool.Core.Models.ConnectionDefinition? _cloneSource;
    private string _cloneName = "";
    private string? _cloneError;

    private void OpenClone(EtlTool.Core.Models.ConnectionDefinition c)
    {
        _cloneSource = c;
        _cloneName = c.Name + "-copy";
        _cloneError = null;
        _showClone = true;
    }

    private async Task ConfirmClone()
    {
        if (_cloneSource is null) return;
        if (string.IsNullOrWhiteSpace(_cloneName)) { _cloneError = "新名稱必填"; return; }
        if (_items?.Any(c => string.Equals(c.Name, _cloneName.Trim(), StringComparison.OrdinalIgnoreCase)) == true)
        {
            _cloneError = "名稱已被使用";
            return;
        }
        _cloneBusy = true;
        try
        {
            var ct = CancellationToken.None;
            // Decrypt source CS, re-create new connection with same plaintext (will be re-encrypted under new key etc.)
            var plain = await ConnRepo.GetPlainConnectionStringAsync(_cloneSource.Id, Protector, ct);
            await ConnRepo.CreateAsync(_cloneName.Trim(), _cloneSource.ProviderType, plain, Protector, ct, actor: _currentUsername);
            _showClone = false;
            _isError = false;
            _message = $"已複製連線「{_cloneSource.Name}」為「{_cloneName}」。建議至編輯頁修改帳密為環境專屬值。";
            await Reload();
        }
        catch (Exception ex)
        {
            _cloneError = ex.Message;
        }
        finally
        {
            _cloneBusy = false;
        }
    }

    private async Task TestAllConnections()
    {
        if (_items is null || _currentUsername is null) return;
        _bulkTesting = true;
        _bulkResult = new();
        StateHasChanged();
        try
        {
            // 平行測試（避免 N 個慢連線 × 5 秒 timeout 線性等下去）
            var ct = CancellationToken.None;
            var tasks = _items.Select(async c =>
            {
                try
                {
                    var plain = await ConnRepo.GetPlainConnectionStringAsync(c.Id, Protector, ct);
                    var connector = ConnectorFactory.Create(c.ProviderType, plain);
                    var ok = await connector.TestConnectionAsync(ct);
                    return (c.Name, ok, ok ? null : (string?)"連線失敗");
                }
                catch (Exception ex)
                {
                    return (c.Name, false, (string?)ex.Message);
                }
            }).ToList();
            var results = await Task.WhenAll(tasks);
            _bulkResult = results.ToList();

            var successCount = _bulkResult.Count(r => r.Ok);
            var failCount = _bulkResult.Count - successCount;
            var msg = $"批次測試完成：{successCount} 成功 / {failCount} 失敗";
            _isError = failCount > 0;
            _message = msg;

            await AuditLogger.LogAsync(
                EtlTool.Core.Models.AuditCategory.Connection,
                EtlTool.Core.Models.AuditAction.Update,
                $"{(failCount == 0 ? "✓" : "⚠")} 批次測試所有連線：{successCount}/{_bulkResult.Count} 成功" +
                (failCount > 0 ? $"，失敗：{string.Join(", ", _bulkResult.Where(r => !r.Ok).Take(5).Select(r => r.Name))}" : ""),
                severity: failCount > 0 ? EtlTool.Core.Models.AuditSeverity.Warning : EtlTool.Core.Models.AuditSeverity.Info,
                actor: _currentUsername,
                ct: ct);

            await Reload();
        }
        finally
        {
            _bulkTesting = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _currentUsername = state.User.Identity?.Name;
        await Reload();
    }

    private async Task Reload()
    {
        _items = await ConnRepo.ListAsync(CancellationToken.None);
        var pending = await ApprovalRepo.ListPendingAsync(CancellationToken.None);
        _pendingTargets = pending
            .Where(p => p.Action == ApprovalAction.DeleteConnection)
            .Select(p => p.TargetId)
            .ToHashSet();
        StateHasChanged();
    }

    private void OpenSubmit(EtlTool.Core.Models.ConnectionDefinition c)
    {
        _submitTarget = c;
        _reason = "";
        _modalError = null;
        _showSubmit = true;
    }

    private async Task ConfirmSubmit()
    {
        if (_submitTarget is null || _currentUsername is null) return;
        _modalError = null;
        try
        {
            await ApprovalRepo.SubmitAsync(
                ApprovalAction.DeleteConnection,
                targetType: nameof(EtlTool.Core.Models.ConnectionDefinition),
                targetId: _submitTarget.Id,
                targetName: _submitTarget.Name,
                submittedBy: _currentUsername,
                reason: string.IsNullOrWhiteSpace(_reason) ? null : _reason,
                ct: CancellationToken.None);
            _showSubmit = false;
            _isError = false;
            _message = $"已提交「{_submitTarget.Name}」刪除請求，請通知另一位 Admin 至 /approvals 核准。";
            await Reload();
        }
        catch (Exception ex)
        {
            _modalError = ex.Message;
        }
    }

    /// <summary>
    /// 一鍵 Test Connection — 不用進編輯頁。失敗 / 成功都寫 audit。
    /// </summary>
    private async Task QuickTest(EtlTool.Core.Models.ConnectionDefinition c)
    {
        _testingId = c.Id;
        _isError = false;
        _message = null;
        try
        {
            var plain = await ConnRepo.GetPlainConnectionStringAsync(c.Id, Protector, CancellationToken.None);
            var connector = ConnectorFactory.Create(c.ProviderType, plain);
            var ok = await connector.TestConnectionAsync(CancellationToken.None);
            _isError = !ok;
            _message = ok
                ? $"✓ 連線「{c.Name}」測試成功"
                : $"⚠ 連線「{c.Name}」測試失敗，請檢查設定與網路可達性。";

            await AuditLogger.LogAsync(
                EtlTool.Core.Models.AuditCategory.Connection,
                ok ? EtlTool.Core.Models.AuditAction.Update : EtlTool.Core.Models.AuditAction.Update,
                $"{(ok ? "✓" : "⚠")} 一鍵測試連線「{c.Name}」: {(ok ? "成功" : "失敗")}",
                targetType: nameof(EtlTool.Core.Models.ConnectionDefinition),
                targetId: c.Id, targetName: c.Name,
                severity: ok ? EtlTool.Core.Models.AuditSeverity.Info : EtlTool.Core.Models.AuditSeverity.Warning,
                actor: _currentUsername,
                ct: CancellationToken.None);
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = $"連線「{c.Name}」測試失敗：{ex.Message}";
            await AuditLogger.LogAsync(
                EtlTool.Core.Models.AuditCategory.Connection,
                EtlTool.Core.Models.AuditAction.Update,
                $"⚠ 一鍵測試連線「{c.Name}」拋例外: {ex.Message}",
                targetType: nameof(EtlTool.Core.Models.ConnectionDefinition),
                targetId: c.Id, targetName: c.Name,
                severity: EtlTool.Core.Models.AuditSeverity.Warning,
                actor: _currentUsername,
                ct: CancellationToken.None);
        }
        finally
        {
            _testingId = null;
        }
    }

    private static string FormatRelative(DateTime utc)
    {
        var diff = DateTime.UtcNow - utc;
        if (diff.TotalSeconds < 60) return "剛剛";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes} 分鐘前";
        if (diff.TotalHours < 24)   return $"{(int)diff.TotalHours} 小時前";
        return $"{(int)diff.TotalDays} 天前";
    }
}
