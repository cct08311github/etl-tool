<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS in-process hosting 用的 web.config 範例。
  發佈後將此檔放到應用程式根目錄；或用 dotnet publish 產生的 web.config 為基底，
  把以下 <applicationInitialization> 與 <environmentVariables> 段合併進去。
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <aspNetCore processPath="dotnet"
                  arguments=".\EtlTool.App.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <!-- 子應用程式時要設成 IIS 上的虛擬路徑（如 /etltool）；掛根則留空 -->
          <environmentVariable name="ETLTOOL_PATH_BASE" value="" />
          <!-- 資料目錄。建議放在 IIS 應用程式池服務帳戶可寫入的位置 -->
          <environmentVariable name="ETLTOOL_DATA_DIR" value="C:\ProgramData\EtlTool" />
        </environmentVariables>
      </aspNetCore>

      <!--
        Application Initialization：避免 app pool idle 時 Quartz 排程停擺。
        前提：IIS 安裝了「Application Initialization」功能 (Add Roles → Web Server → Application Development)
        並把 app pool 的「啟動模式」設為 AlwaysRunning、Idle Time-out 設為 0。
      -->
      <applicationInitialization doAppInitAfterRestart="true">
        <add initializationPage="/healthz" hostName="" />
      </applicationInitialization>

      <!-- 增加 IIS 與 ASP.NET Core 之間請求大小限制（可選） -->
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="52428800" /> <!-- 50 MB -->
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
